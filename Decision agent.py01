
 //@version=5
strategy("SPY Support & Resistance Strategy (MTF + Report)",
     overlay=true,
     initial_capital=100000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=25,
     commission_type=strategy.commission.percent,
     commission_value=0.005,
     pyramiding=0,
     calc_on_every_tick=false,
     max_labels_count=500)


// ───────── Inputs ─────────
grpS = "Strategy"
mode       = input.string("Bounce", "Entry Mode", options=["Bounce", "Breakout"], group=grpS)
allowLong  = input.bool(true,  "Allow Long",  group=grpS)
allowShort = input.bool(false, "Allow Short", group=grpS)
useTrend   = input.bool(true,  "Trend filter (EMA)", group=grpS)
trendLen   = input.int(200, "Trend EMA Length", minval=2, group=grpS)
tolPct     = input.float(0.15, "Level Tolerance (%)", minval=0.01, step=0.05, group=grpS)

grpL = "Levels (pivot based)"
pivL   = input.int(10, "Pivot Left Bars",  minval=1, group=grpL)
pivR   = input.int(10, "Pivot Right Bars", minval=1, group=grpL)
tf1    = input.timeframe("60",  "Higher TF 1", group=grpL)
tf2    = input.timeframe("D",   "Higher TF 2", group=grpL)
tf3    = input.timeframe("W",   "Higher TF 3", group=grpL)

grpR = "Risk (ATR based)"
atrLen = input.int(14, "ATR Length", minval=1, group=grpR)
slMult = input.float(1.5, "Stop Loss (x ATR)",   minval=0.1, step=0.1, group=grpR)
tpMult = input.float(3.0, "Take Profit (x ATR)", minval=0.1, step=0.1, group=grpR)

grpD = "Display"
showReport = input.bool(true, "Show report table", group=grpD)
showLabels = input.bool(true, "Show closed trade labels", group=grpD)
showHTF    = input.bool(true, "Show higher timeframe levels", group=grpD)

// ───────── SPY only ─────────
isSPY = syminfo.ticker == "SPY"

// ───────── Level detection ─────────
f_sr(int l, int r) =>
    var float res = na
    var float sup = na
    ph = ta.pivothigh(high, l, r)
    pl = ta.pivotlow(low, l, r)
    if not na(ph)
        res := ph
    if not na(pl)
        sup := pl
    [res, sup]

[resC, supC] = f_sr(pivL, pivR)
[res1, sup1] = request.security(syminfo.tickerid, tf1, f_sr(pivL, pivR), lookahead=barmerge.lookahead_off)
[res2, sup2] = request.security(syminfo.tickerid, tf2, f_sr(pivL, pivR), lookahead=barmerge.lookahead_off)
[res3, sup3] = request.security(syminfo.tickerid, tf3, f_sr(pivL, pivR), lookahead=barmerge.lookahead_off)

plot(resC, "Resistance (chart TF)", color=color.red,   style=plot.style_linebr, linewidth=2)
plot(supC, "Support (chart TF)",    color=color.green, style=plot.style_linebr, linewidth=2)
plot(showHTF ? res1 : na, "Resistance TF1", color=color.new(color.orange, 30), style=plot.style_linebr)
plot(showHTF ? sup1 : na, "Support TF1",    color=color.new(color.teal, 30),   style=plot.style_linebr)
plot(showHTF ? res2 : na, "Resistance TF2", color=color.new(color.maroon, 20), style=plot.style_linebr, linewidth=2)
plot(showHTF ? sup2 : na, "Support TF2",    color=color.new(color.lime, 20),   style=plot.style_linebr, linewidth=2)
plot(showHTF ? res3 : na, "Resistance TF3", color=color.new(color.purple, 10), style=plot.style_linebr, linewidth=3)
plot(showHTF ? sup3 : na, "Support TF3",    color=color.new(color.blue, 10),   style=plot.style_linebr, linewidth=3)

// ───────── Signals ─────────
tol = tolPct / 100
ema = ta.ema(close, trendLen)
atr = ta.atr(atrLen)

f_nearSup(float s) => not na(s) and low <= s * (1 + tol) and close > s
f_nearRes(float r) => not na(r) and high >= r * (1 - tol) and close < r

nearSupport    = f_nearSup(supC) or f_nearSup(sup1) or f_nearSup(sup2) or f_nearSup(sup3)
nearResistance = f_nearRes(resC) or f_nearRes(res1) or f_nearRes(res2) or f_nearRes(res3)

longBounce  = nearSupport and close > open
shortBounce = nearResistance and close < open

longBreak  = ta.crossover(close, resC) or ta.crossover(close, res1) or ta.crossover(close, res2) or ta.crossover(close, res3)
shortBreak = ta.crossunder(close, supC) or ta.crossunder(close, sup1) or ta.crossunder(close, sup2) or ta.crossunder(close, sup3)

longRaw  = mode == "Bounce" ? longBounce  : longBreak
shortRaw = mode == "Bounce" ? shortBounce : shortBreak

longSignal  = isSPY and allowLong  and longRaw  and (not useTrend or close > ema) and strategy.position_size <= 0
shortSignal = isSPY and allowShort and shortRaw and (not useTrend or close < ema) and strategy.position_size >= 0

// ───────── Orders ─────────
var float entryAtr = na

if longSignal
    entryAtr := atr
    strategy.entry("Long", strategy.long)
    alert("SPY LONG signal @ " + str.tostring(close, "#.##"), alert.freq_once_per_bar_close)

if shortSignal
    entryAtr := atr
    strategy.entry("Short", strategy.short)
    alert("SPY SHORT signal @ " + str.tostring(close, "#.##"), alert.freq_once_per_bar_close)

if strategy.position_size > 0
    e = strategy.position_avg_price
    strategy.exit("Long Exit", "Long", stop = e - slMult * entryAtr, limit = e + tpMult * entryAtr)

if strategy.position_size < 0
    e = strategy.position_avg_price
    strategy.exit("Short Exit", "Short", stop = e + slMult * entryAtr, limit = e - tpMult * entryAtr)

plotshape(longSignal,  "Long",  shape.triangleup,   location.belowbar, color.green, size=size.tiny)
plotshape(shortSignal, "Short", shape.triangledown, location.abovebar, color.red,   size=size.tiny)
plot(useTrend ? ema : na, "Trend EMA", color=color.gray)

// ───────── Closed trade labels ─────────
if showLabels and strategy.closedtrades > strategy.closedtrades[1]
    i = strategy.closedtrades - 1
    p = strategy.closedtrades.profit(i)
    txt = "In " + str.tostring(strategy.closedtrades.entry_price(i), "#.##") +
          "\nOut " + str.tostring(strategy.closedtrades.exit_price(i), "#.##") +
          "\nP/L " + str.tostring(p, "#.##")
    label.new(bar_index, high, txt, style=label.style_label_down,
         color = p >= 0 ? color.new(color.green, 30) : color.new(color.red, 30),
         textcolor=color.white, size=size.small)

// ───────── Report table ─────────
var table t = table.new(position.top_right, 2, 10, border_width=1,
     bgcolor=color.new(color.black, 20), frame_color=color.gray, frame_width=1)

f_row(int row, string name, string val) =>
    table.cell(t, 0, row, name, text_color=color.white, text_halign=text.align_left, text_size=size.small)
    table.cell(t, 1, row, val,  text_color=color.white, text_halign=text.align_right, text_size=size.small)

if showReport and barstate.islast
    n     = strategy.closedtrades
    wins  = strategy.wintrades
    gp    = math.abs(strategy.grossprofit)
    gl    = math.abs(strategy.grossloss)
    wr    = n > 0 ? wins / n * 100 : 0.0
    pf    = gl > 0 ? gp / gl : na
    avgT  = n > 0 ? strategy.netprofit / n : 0.0
    table.cell(t, 0, 0, "SPY S/R REPORT", text_color=color.yellow, text_size=size.small)
    table.cell(t, 1, 0, isSPY ? syminfo.ticker : "NOT SPY!", text_color=isSPY ? color.yellow : color.red, text_size=size.small)
    f_row(1, "Closed trades", str.tostring(n))
    f_row(2, "Win rate", str.tostring(wr, "#.##") + "%")
    f_row(3, "Net profit", str.tostring(strategy.netprofit, "#,###.##"))
    f_row(4, "Profit factor", na(pf) ? "n/a" : str.tostring(pf, "#.##"))
    f_row(5, "Avg trade", str.tostring(avgT, "#.##"))
    f_row(6, "Max drawdown", str.tostring(strategy.max_drawdown, "#,###.##"))
    f_row(7, "Open P/L", str.tostring(strategy.openprofit, "#,###.##"))
    f_row(8, "Mode", mode)
    f_row(9, "Chart TF", timeframe.period)
