"""
tcn_predictor.py

Inference-only companion to TCN_Training.py.

Loads a trained TCNClassifier checkpoint (models/best_tcn_<symbol>.pth)
and turns the latest 60 real candles into a live BUY / HOLD / SELL
signal with a confidence percentage.

Pipeline (nothing more, nothing less):

    60 real candles
      -> indicators (same formulas as training)
      -> saved feature scaler (loaded from checkpoint, never re-fit)
      -> TCNClassifier
      -> SELL / HOLD / BUY logits
      -> softmax
      -> signal + confidence

This file does NOT predict a price, does NOT generate synthetic
future candles, and does NOT contain any recursive forecasting logic.
It only ever looks at the most recent real candles that were handed
to it.
"""

import warnings
warnings.filterwarnings("ignore")

from pathlib import Path

import numpy as np
import pandas as pd

import torch
import torch.nn as nn
from sklearn.preprocessing import StandardScaler


DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")

# Fallback dropout if a checkpoint was saved without "dropout_rate"
# (dropout has no effect at inference time anyway since the model is
# always put into eval() mode, but the constructor still needs a
# value to build the exact same layers).
DEFAULT_DROPOUT_RATE = 0.2

RSI_PERIOD = 14
ATR_PERIOD = 14
MACD_FAST = 12
MACD_SLOW = 26
MACD_SIGNAL = 9

# Must match TCN_Training.py's BASE_FEATURES exactly (same order) --
# the saved scaler and the saved "features" list both depend on this.
BASE_FEATURES = ["high", "low", "close", "volume", "open"]

# Same class mapping used during training.
SELL = 0
HOLD = 1
BUY = 2

DEFAULT_SIGNAL_CLASSES = {
    SELL: "SELL",
    HOLD: "HOLD",
    BUY: "BUY",
}

# Maps each selectable indicator name -> the dataframe column(s) it
# produces. Must match TCN_Training.py exactly.
INDICATOR_COLUMN_MAP = {
    "EMA9":  ["ema9"],
    "EMA20": ["ema20"],
    "EMA50": ["ema50"],
    "VWAP":  ["vwap"],
    "RSI14": ["rsi14"],
    "ATR14": ["atr14"],
    "MACD":  ["macd_line", "macd_signal", "macd_hist"],
}


# =============================================================
# 1. INDICATOR NAME NORMALIZATION
# =============================================================

def normalize_indicators(indicators):
    """
    Turns whatever indicator names are stored in the checkpoint
    ("ema9", "EMA 9", "EMA9", etc.) into the exact canonical keys
    used in INDICATOR_COLUMN_MAP, in the same order they were given,
    with duplicates removed. Uses the identical normalization rule as
    TCN_Training.py so a checkpoint trained there loads correctly here.
    """
    normalized = []

    for raw_name in indicators:
        cleaned = str(raw_name).strip().upper()
        cleaned = cleaned.replace("_", " ").replace("-", " ")
        cleaned = " ".join(cleaned.split())
        no_space = cleaned.replace(" ", "")

        canonical = None
        for name in INDICATOR_COLUMN_MAP.keys():
            if name.upper().replace(" ", "") == no_space:
                canonical = name
                break

        if canonical is None:
            raise ValueError(
                f"Unknown indicator '{raw_name}' found in checkpoint. "
                f"This predictor only supports: {list(INDICATOR_COLUMN_MAP.keys())}"
            )

        if canonical not in normalized:
            normalized.append(canonical)

    return normalized


# =============================================================
# 2-5. INDICATOR FORMULAS -- must match TCN_Training.py EXACTLY
# =============================================================

def compute_rsi(close, period=RSI_PERIOD):
    delta = close.diff()

    gain = delta.clip(lower=0)
    loss = -delta.clip(upper=0)

    avg_gain = gain.ewm(
        alpha=1 / period,
        min_periods=period,
        adjust=False
    ).mean()

    avg_loss = loss.ewm(
        alpha=1 / period,
        min_periods=period,
        adjust=False
    ).mean()

    rs = avg_gain / avg_loss.replace(0, np.nan)

    return 100 - (100 / (1 + rs))


def compute_atr(dataframe, period=ATR_PERIOD):
    high_low = dataframe["high"] - dataframe["low"]
    high_close = (dataframe["high"] - dataframe["close"].shift()).abs()
    low_close = (dataframe["low"] - dataframe["close"].shift()).abs()

    true_range = pd.concat([high_low, high_close, low_close], axis=1).max(axis=1)

    return true_range.ewm(alpha=1 / period, adjust=False).mean()


def compute_vwap(dataframe):
    typical_price = (dataframe["high"] + dataframe["low"] + dataframe["close"]) / 3
    cumulative_pv = (typical_price * dataframe["volume"]).cumsum()
    cumulative_volume = dataframe["volume"].cumsum().replace(0, np.nan)

    return cumulative_pv / cumulative_volume


def compute_macd(dataframe, fast=MACD_FAST, slow=MACD_SLOW, signal=MACD_SIGNAL):
    ema_fast = dataframe["close"].ewm(span=fast, adjust=False).mean()
    ema_slow = dataframe["close"].ewm(span=slow, adjust=False).mean()
    macd_line = ema_fast - ema_slow
    signal_line = macd_line.ewm(span=signal, adjust=False).mean()

    return pd.DataFrame({
        "macd_line":   macd_line,
        "macd_signal": signal_line,
        "macd_hist":   macd_line - signal_line,
    })


INDICATOR_REGISTRY = {
    "EMA9":  lambda df: df["close"].ewm(span=9, adjust=False).mean(),
    "EMA20": lambda df: df["close"].ewm(span=20, adjust=False).mean(),
    "EMA50": lambda df: df["close"].ewm(span=50, adjust=False).mean(),
    "VWAP":  lambda df: compute_vwap(df),
    "RSI14": lambda df: compute_rsi(df["close"], period=RSI_PERIOD),
    "ATR14": lambda df: compute_atr(df, period=ATR_PERIOD),
    "MACD":  lambda df: compute_macd(df, fast=MACD_FAST, slow=MACD_SLOW, signal=MACD_SIGNAL),
}


# =============================================================
# 6. FEATURE PREPARATION
# =============================================================

def add_missing_features(dataframe, indicators):
    """
    Computes any indicator column that isn't already present in
    `dataframe`, using the exact same formulas as TCN_Training.py.
    If a column already exists (e.g. the caller pre-computed it), it
    is left untouched.
    """
    dataframe = dataframe.copy()

    for name in indicators:
        if name not in INDICATOR_REGISTRY:
            raise ValueError(f"Unknown indicator: {name}")

        columns_needed = INDICATOR_COLUMN_MAP[name]

        if all(col in dataframe.columns for col in columns_needed):
            continue

        result = INDICATOR_REGISTRY[name](dataframe)

        if isinstance(result, pd.DataFrame):
            for col in result.columns:
                dataframe[col] = result[col]
        else:
            dataframe[columns_needed[0]] = result

    return dataframe


def resolve_feature_columns(indicators):
    """FINAL_FEATURES = BASE_FEATURES + selected indicator columns."""
    columns = list(BASE_FEATURES)
    for name in indicators:
        columns.extend(INDICATOR_COLUMN_MAP[name])
    return columns


# =============================================================
# 7. TCN MODEL -- architecture must match TCN_Training.py EXACTLY
# =============================================================

class TemporalBlock(nn.Module):

    def __init__(self, in_channels, out_channels, dilation, dropout_rate=DEFAULT_DROPOUT_RATE):
        super().__init__()

        kernel_size = 5
        padding = (kernel_size - 1) * dilation

        self.conv1 = nn.Conv1d(
            in_channels,
            out_channels,
            kernel_size=kernel_size,
            padding=padding,
            dilation=dilation
        )

        self.conv2 = nn.Conv1d(
            out_channels,
            out_channels,
            kernel_size=kernel_size,
            padding=padding,
            dilation=dilation
        )

        self.gelu = nn.GELU()
        self.dropout = nn.Dropout(dropout_rate)

        self.downsample = (
            nn.Conv1d(in_channels, out_channels, kernel_size=1)
            if in_channels != out_channels
            else None
        )

    def forward(self, x):
        output = self.conv1(x)
        output = output[:, :, :-self.conv1.padding[0]]

        output = self.conv2(output)
        output = output[:, :, :-self.conv2.padding[0]]

        output = self.gelu(output)
        output = self.dropout(output)

        residual = x

        if self.downsample:
            residual = self.downsample(x)

        min_length = min(output.shape[2], residual.shape[2])

        output = output[:, :, -min_length:]
        residual = residual[:, :, -min_length:]

        return output + residual


class TCNClassifier(nn.Module):
    """
    Exactly the same architecture as TCN_Training.py's TCNClassifier.
    Do NOT change convolution sizes, dilation values, padding, number
    of blocks, hidden dimensions, recent_timesteps, fc1/fc2 sizes, or
    the classifier output size -- the saved state_dict will only load
    if this matches training exactly.
    """

    N_CLASSES = 3  # SELL = 0, HOLD = 1, BUY = 2

    def __init__(self, n_features, dropout_rate=DEFAULT_DROPOUT_RATE):
        super().__init__()

        self.block1 = TemporalBlock(n_features, 32, dilation=1, dropout_rate=dropout_rate)
        self.block2 = TemporalBlock(32, 64, dilation=2, dropout_rate=dropout_rate)
        self.block3 = TemporalBlock(64, 64, dilation=4, dropout_rate=dropout_rate)
        self.block4 = TemporalBlock(64, 64, dilation=8, dropout_rate=dropout_rate)

        self.gelu = nn.GELU()
        self.dropout = nn.Dropout(dropout_rate)
        self.recent_timesteps = 4

        self.fc1 = nn.Linear(64 * self.recent_timesteps, 128)
        self.fc2 = nn.Linear(128, 64)

        # 3 raw logits: index 0 = SELL, index 1 = HOLD, index 2 = BUY.
        self.classifier = nn.Linear(64, self.N_CLASSES)

    def forward(self, x):
        x = x.permute(0, 2, 1)

        x = self.block1(x)
        x = self.block2(x)
        x = self.block3(x)
        x = self.block4(x)

        x = x[:, :, -self.recent_timesteps:]
        x = x.reshape(x.size(0), -1)

        x = self.fc1(x)
        x = self.gelu(x)
        x = self.dropout(x)

        x = self.fc2(x)
        x = self.gelu(x)
        x = self.dropout(x)

        x = self.classifier(x)

        # shape: (batch, 3) -- raw SELL/HOLD/BUY logits, NOT a price.
        return x


# =============================================================
# 8. LOGITS -> SIGNAL + CONFIDENCE
# =============================================================

def decode_prediction(logits, signal_classes=None):
    """
    Converts one row of raw model logits (shape: (3,)) into:

        {
            "signal": "BUY",
            "confidence": 87.42,
            "probabilities": {
                "SELL": 4.31,
                "HOLD": 8.27,
                "BUY": 87.42
            }
        }

    `signal_classes` should be the {0: "SELL", 1: "HOLD", 2: "BUY"}
    mapping loaded from the checkpoint. Falls back to the default
    mapping if none is supplied.
    """
    if signal_classes is None:
        signal_classes = DEFAULT_SIGNAL_CLASSES

    logits_tensor = torch.as_tensor(logits, dtype=torch.float32).reshape(-1)

    probabilities = torch.softmax(logits_tensor, dim=0)
    predicted_class = int(torch.argmax(probabilities).item())

    probabilities_pct = {
        signal_classes[class_index]: round(float(probabilities[class_index]) * 100, 2)
        for class_index in sorted(signal_classes.keys())
    }

    predicted_signal = signal_classes[predicted_class]

    return {
        "signal": predicted_signal,
        "confidence": probabilities_pct[predicted_signal],
        "probabilities": probabilities_pct,
    }


# =============================================================
# 9-10. TCNSignalPredictor
# =============================================================

class TCNPredictor:
    """
    Loads a trained TCNClassifier checkpoint and turns the latest
    real candles into a live BUY / HOLD / SELL signal.

    Example:
        predictor = TCNPredictor("SPY")
        result = predictor.predict(df)
        print(result)
    """

    REQUIRED_CHECKPOINT_KEYS = [
        "model_state_dict",
        "features",
        "indicators",
        "sequence_length",
        "feature_scaler_mean",
        "feature_scaler_scale",
    ]

    def __init__(self, symbol="SPY", model_dir=None):
        self.symbol = symbol.upper()

        # ---- Locate and validate the checkpoint file ----
        if model_dir is None:
            model_dir = Path(__file__).parent.parent / "models"

        self.model_path = Path(model_dir) / f"best_tcn_{self.symbol.lower()}.pth"

        if not self.model_path.exists():
            raise FileNotFoundError(
                f"No trained model found for symbol '{self.symbol}' at "
                f"{self.model_path}. Train it first with TCN_Training.py."
            )

        # ---- Load the checkpoint ----
        try:
            checkpoint = torch.load(
                self.model_path,
                map_location=DEVICE,
                weights_only=False
            )
        except Exception as error:
            raise ValueError(
                f"Invalid checkpoint at {self.model_path}: could not "
                f"unpickle the file ({error})."
            )

        if not isinstance(checkpoint, dict):
            raise ValueError(
                f"Invalid checkpoint at {self.model_path}: expected a "
                f"dict, got {type(checkpoint)}."
            )

        missing_keys = [
            key for key in self.REQUIRED_CHECKPOINT_KEYS
            if key not in checkpoint
        ]

        if missing_keys:
            raise ValueError(
                f"Invalid checkpoint at {self.model_path}: missing "
                f"required key(s) {missing_keys}. This file may have "
                f"been saved by the old regression trainer -- retrain "
                f"with the current TCN_Training.py."
            )

        # ---- Pull everything the predictor needs straight from the ----
        # ---- checkpoint. Nothing here is hard-coded or re-derived. ----
        self.indicators = normalize_indicators(checkpoint["indicators"])
        self.indicator_columns = checkpoint.get(
            "indicator_columns",
            resolve_feature_columns(self.indicators)[len(BASE_FEATURES):]
        )

        # Use the EXACT feature list and order the model was trained
        # with -- never assume/recompute it.
        self.features = list(checkpoint["features"])

        self.sequence_length = int(checkpoint["sequence_length"])

        self.signal_classes = {
            int(class_index): class_name
            for class_index, class_name in checkpoint.get(
                "signal_classes", DEFAULT_SIGNAL_CLASSES
            ).items()
        }

        self.buy_threshold_pct = checkpoint.get("buy_threshold_pct")
        self.sell_threshold_pct = checkpoint.get("sell_threshold_pct")

        self.validation_accuracy = checkpoint.get("validation_accuracy")
        self.validation_f1 = checkpoint.get("validation_f1")

        dropout_rate = checkpoint.get("dropout_rate", DEFAULT_DROPOUT_RATE)

        # ---- Checkpoint / architecture consistency check ----
        # block1.conv1.weight has shape (out_channels, in_channels, kernel).
        # in_channels must equal the number of features the model was
        # actually trained with -- this catches a mismatched or
        # hand-edited "features" list before it causes a confusing
        # low-level tensor shape error further down.
        expected_n_features = checkpoint["model_state_dict"]["block1.conv1.weight"].shape[1]

        if expected_n_features != len(self.features):
            raise ValueError(
                f"Checkpoint feature mismatch: the saved model expects "
                f"{expected_n_features} input features, but the "
                f"checkpoint's 'features' list has {len(self.features)} "
                f"entries ({self.features}). The checkpoint appears to "
                f"be corrupted or was saved incorrectly."
            )

        # ---- Rebuild the exact training architecture ----
        self.model = TCNClassifier(
            n_features=len(self.features),
            dropout_rate=dropout_rate
        ).to(DEVICE)

        try:
            self.model.load_state_dict(checkpoint["model_state_dict"])
        except RuntimeError as error:
            raise ValueError(
                f"Checkpoint feature mismatch: the saved weights don't "
                f"fit the TCNClassifier architecture defined in this "
                f"file ({error}). Make sure TCN_Signal_Predictor.py's "
                f"TCNClassifier matches TCN_Training.py exactly."
            )

        self.model.eval()

        # ---- Rebuild the saved (already-fit) feature scaler ----
        # This is loaded from the checkpoint, never re-fit here.
        self.feature_scaler = StandardScaler()
        self.feature_scaler.mean_ = np.asarray(checkpoint["feature_scaler_mean"])
        self.feature_scaler.scale_ = np.asarray(checkpoint["feature_scaler_scale"])
        self.feature_scaler.n_features_in_ = len(self.features)

        print(
            f"Loaded TCN classifier for {self.symbol} "
            f"(val accuracy: {self.validation_accuracy}, "
            f"val F1: {self.validation_f1})"
        )

    def predict(self, df):
        """
        Takes a DataFrame of real OHLCV candles (most recent candle
        last) and returns the current BUY/HOLD/SELL signal with a
        confidence percentage. Does not predict a price and does not
        generate any synthetic candles -- it only ever looks at the
        real candles it was given.
        """
        if not isinstance(df, pd.DataFrame):
            raise TypeError("predict() expects a pandas DataFrame of OHLCV candles.")

        dataframe = df.copy()
        dataframe.columns = [str(col).lower().strip() for col in dataframe.columns]

        # ---- 1. Validate raw OHLCV columns exist ----
        required_ohlcv = ["open", "high", "low", "close", "volume"]
        missing_ohlcv = [col for col in required_ohlcv if col not in dataframe.columns]

        if missing_ohlcv:
            raise ValueError(
                f"Missing required OHLCV column(s): {missing_ohlcv}. "
                f"predict() needs columns {required_ohlcv}."
            )

        # ---- 2. Calculate the selected indicators ----
        dataframe = add_missing_features(dataframe, self.indicators)

        # ---- 3. Make sure every checkpoint feature exists ----
        missing_features = [col for col in self.features if col not in dataframe.columns]

        if missing_features:
            raise ValueError(
                f"Missing required indicator column(s): {missing_features}. "
                f"The checkpoint was trained with features {self.features}."
            )

        dataframe = dataframe.dropna(subset=self.features).reset_index(drop=True)

        # ---- 4. Use the latest `sequence_length` candles ----
        if len(dataframe) < self.sequence_length:
            raise ValueError(
                f"Insufficient candles: got {len(dataframe)} usable rows "
                f"after indicator warm-up, but the model needs at least "
                f"{self.sequence_length}."
            )

        latest_window = dataframe.iloc[-self.sequence_length:]

        # ---- 5. Arrange features in the exact checkpoint order ----
        feature_matrix = latest_window[self.features].to_numpy(dtype=np.float32)

        # ---- 6. Apply the SAVED feature scaler (never re-fit here) ----
        feature_matrix = self.feature_scaler.transform(feature_matrix).astype(np.float32)

        # ---- 7. Convert to a PyTorch tensor: (1, sequence_length, n_features) ----
        input_tensor = (
            torch.tensor(feature_matrix, dtype=torch.float32)
            .unsqueeze(0)
            .to(DEVICE)
        )

        # ---- 8-10. Forward pass -> softmax -> class ----
        with torch.no_grad():
            logits = self.model(input_tensor)[0]

        result = decode_prediction(logits.cpu().numpy(), self.signal_classes)

        # ---- 11-12. Attach useful metadata for the dashboard ----
        result["symbol"] = self.symbol
        result["sequence_length"] = self.sequence_length
        result["indicators"] = self.indicators
        result["features"] = self.features

        return result


