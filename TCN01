def prepare_training_data(symbol, indicators):
    dataframe = load_symbol_data(symbol)

    print(f"\nMerged Shape: {dataframe.shape}")

    dataframe.columns = [c.lower().strip() for c in dataframe.columns]

    try:
        dataframe["datetime"] = pd.to_datetime(dataframe["datetime"], unit="ms")
    except:
        dataframe["datetime"] = pd.to_datetime(dataframe["datetime"])

    dataframe = dataframe.sort_values("datetime")
    dataframe.reset_index(drop=True, inplace=True)

    dataframe = add_indicators(dataframe, indicators)
    indicator_columns = resolve_indicator_columns(indicators)
    features = resolve_feature_columns(indicators)

    dataframe = add_targets(dataframe)

    dataframe.dropna(inplace=True)
    dataframe.reset_index(drop=True, inplace=True)

    dataframe[DIRECTION_COLUMN] = dataframe[DIRECTION_COLUMN].astype(np.int64)

    split_index = int(len(dataframe) * 0.80)

    train_dataframe = dataframe.iloc[:split_index].copy()
    test_dataframe = dataframe.iloc[split_index:].copy()

    train_dataframe[features] = feature_scaler.fit_transform(train_dataframe[features])
    test_dataframe[features] = feature_scaler.transform(test_dataframe[features])

    train_dataframe[TARGET_COLUMNS] = target_scaler.fit_transform(train_dataframe[TARGET_COLUMNS])
    test_dataframe[TARGET_COLUMNS] = target_scaler.transform(test_dataframe[TARGET_COLUMNS])

    X_train, y_train, d_train = create_sequences(train_dataframe, features)
    X_test, y_test, d_test = create_sequences(test_dataframe, features)

    if len(X_train) == 0:
        raise RuntimeError("Training dataset is empty")

    if len(X_test) == 0:
        raise RuntimeError("Validation dataset is empty")

    print(f"\nTrain Shape: {X_train.shape}")
    print(f"Test Shape : {X_test.shape}")

    train_counts = np.bincount(d_train, minlength=3)
    test_counts = np.bincount(d_test, minlength=3)
    print(f"Train Direction Counts (SELL/HOLD/BUY): {train_counts.tolist()}")
    print(f"Test  Direction Counts (SELL/HOLD/BUY): {test_counts.tolist()}")

    train_dataset = MarketDataset(X_train, y_train, d_train)
    test_dataset = MarketDataset(X_test, y_test, d_test)

    train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True, drop_last=True)
    test_loader = DataLoader(test_dataset, batch_size=BATCH_SIZE, shuffle=False)

    return (
        train_loader,
        test_loader,
        feature_scaler,
        target_scaler,
        features,
        indicator_columns
    )


# =========================================================
# TCN BUILDING BLOCKS
# =========================================================

class Chomp1d(nn.Module):
    """Trims the extra right-side padding a causal dilated conv leaves
    behind, so output length matches input length and no future
    timestep ever leaks into the receptive field of an earlier one."""

    def __init__(self, chomp_size):
        super().__init__()
        self.chomp_size = chomp_size

    def forward(self, x):
        if self.chomp_size == 0:
            return x
        return x[:, :, :-self.chomp_size].contiguous()


class TemporalBlock(nn.Module):
    """One residual block of two causal dilated convolutions. Dilation
    grows per block (1, 2, 4, 8, ...) so stacking blocks expands the
    receptive field exponentially rather than linearly."""

    def __init__(self, n_inputs, n_outputs, kernel_size, dilation, dropout):
        super().__init__()
        padding = (kernel_size - 1) * dilation

        self.conv1 = weight_norm(nn.Conv1d(
            n_inputs, n_outputs, kernel_size,
            padding=padding, dilation=dilation
        ))
        self.chomp1 = Chomp1d(padding)
        self.act1 = nn.GELU()
        self.dropout1 = nn.Dropout(dropout)

        self.conv2 = weight_norm(nn.Conv1d(
            n_outputs, n_outputs, kernel_size,
            padding=padding, dilation=dilation
        ))
        self.chomp2 = Chomp1d(padding)
        self.act2 = nn.GELU()
        self.dropout2 = nn.Dropout(dropout)

        self.downsample = nn.Conv1d(n_inputs, n_outputs, 1) if n_inputs != n_outputs else None
        self.out_act = nn.GELU()

        self._init_weights()

    def _init_weights(self):
        self.conv1.weight.data.normal_(0, 0.01)
        self.conv2.weight.data.normal_(0, 0.01)
        if self.downsample is not None:
            self.downsample.weight.data.normal_(0, 0.01)

    def forward(self, x):
        out = self.conv1(x)
        out = self.chomp1(out)
        out = self.act1(out)
        out = self.dropout1(out)

        out = self.conv2(out)
        out = self.chomp2(out)
        out = self.act2(out)
        out = self.dropout2(out)

        residual = x if self.downsample is None else self.downsample(x)
        return self.out_act(out + residual)


class TemporalConvNet(nn.Module):

    def __init__(self, num_inputs, num_channels, kernel_size=TCN_KERNEL_SIZE, dropout=DROPOUT_RATE):
        super().__init__()

        blocks = []
        num_levels = len(num_channels)

        for level in range(num_levels):
            dilation = 2 ** level
            in_channels = num_inputs if level == 0 else num_channels[level - 1]
            out_channels = num_channels[level]

            blocks.append(TemporalBlock(
                in_channels, out_channels,
                kernel_size=kernel_size,
                dilation=dilation,
                dropout=dropout,
            ))

        self.network = nn.Sequential(*blocks)

    def forward(self, x):
        # x: (batch, channels, seq_len)
        return self.network(x)


# =========================================================
# TCN DUAL-HEAD MODEL
#
# Pipeline: 60 candles -> TCN trunk -> shared FC -> {return head,
# direction head}. n_features scales with however many indicators are
# selected (5 base OHLCV + whichever indicator columns are on).
#   - return_head outputs a single scalar: predicted (scaled) % return,
#     decoded by the caller via target_scaler then
#     price = close * (1 + return).
#   - direction_head outputs 3 logits (SELL/HOLD/BUY), consumed with
#     CrossEntropyLoss / softmax.
# =========================================================

class TCNDualHead(nn.Module):

    def __init__(
        self,
        n_features,
        num_channels=TCN_NUM_CHANNELS,
        kernel_size=TCN_KERNEL_SIZE,
        dropout=DROPOUT_RATE,
        n_direction_classes=len(DIRECTION_CLASSES),
    ):
        super().__init__()

        self.tcn = TemporalConvNet(
            num_inputs=n_features,
            num_channels=num_channels,
            kernel_size=kernel_size,
            dropout=dropout,
        )

        trunk_dim = num_channels[-1]

        self.dropout = nn.Dropout(dropout)
        self.shared_fc = nn.Linear(trunk_dim, 64)
        self.gelu = nn.GELU()

        self.return_head = nn.Linear(64, 1)
        self.direction_head = nn.Linear(64, n_direction_classes)

    def forward(self, x):
        # incoming x: (batch, seq_len, n_features) -- TCN wants channels-first
        x = x.transpose(1, 2)

        trunk_out = self.tcn(x)

        # Last timestep summarizes the full 60-candle causal window.
        trunk_out = trunk_out[:, :, -1]

        trunk_out = self.dropout(trunk_out)
        trunk_out = self.shared_fc(trunk_out)
        trunk_out = self.gelu(trunk_out)

        return_pred = self.return_head(trunk_out)          # (batch, 1)
        direction_logits = self.direction_head(trunk_out)  # (batch, 3)

        return return_pred, direction_logits


