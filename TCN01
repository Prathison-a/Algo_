def train_model(
    symbol=DEFAULT_SYMBOL,
    indicators=None,
    progress_callback=None,
    stop_callback=None
):
    if indicators is None:
        indicators = list(DEFAULT_INDICATORS)

    indicators = normalize_indicator_list(indicators)

    best_val_loss = np.inf
    patience_counter = 0

    train_losses.clear()
    val_losses.clear()
    mae_list.clear()
    rmse_list.clear()
    r2_list.clear()
    corr_list.clear()
    confidence_score_list.clear()
    multi_step_mae_list.clear()
    direction_accuracy_list.clear()
    direction_f1_list.clear()

    symbol = symbol.upper()

    MODEL_PATH = (
        Path(__file__).parent.parent
        / "models"
        / f"best_tcn_{symbol.lower()}.pth"
    )

    MODEL_PATH.parent.mkdir(parents=True, exist_ok=True)

    (
        train_loader,
        test_loader,
        feature_scaler,
        target_scaler,
        features,
        indicator_columns
    ) = prepare_training_data(symbol, indicators)

    print_training_summary(symbol, indicators, indicator_columns, features)

    huber_loss = nn.HuberLoss()
    cross_entropy_loss = nn.CrossEntropyLoss()

    model = TCNDualHead(n_features=len(features)).to(DEVICE)

    optimizer = torch.optim.AdamW(
        model.parameters(),
        lr=LEARNING_RATE,
        weight_decay=WEIGHT_DECAY
    )

    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(
        optimizer, mode="min", factor=0.5, patience=10
    )

    for epoch in range(EPOCHS):
        print(f"\nEpoch [{epoch + 1}/{EPOCHS}] Started...")

        model.train()
        running_train_loss = 0

        for X_batch, y_batch, d_batch in train_loader:
            if stop_callback and stop_callback():
                print("\nTraining Stopped By User")
                return False

            X_batch = X_batch.to(DEVICE)
            y_batch = y_batch.to(DEVICE)
            d_batch = d_batch.to(DEVICE)

            optimizer.zero_grad()

            return_pred, direction_logits = model(X_batch)

            loss_return = huber_loss(return_pred, y_batch)
            loss_direction = cross_entropy_loss(direction_logits, d_batch)
            loss = loss_return + DIRECTION_LOSS_WEIGHT * loss_direction

            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            optimizer.step()

            running_train_loss += loss.item()

        avg_train_loss = running_train_loss / len(train_loader)
        train_losses.append(avg_train_loss)

        model.eval()

        running_val_loss = 0
        all_predictions = []
        all_targets = []
        all_direction_preds = []
        all_direction_targets = []
        X_validation_raw = []
        y_validation_raw = []

        with torch.no_grad():
            for X_batch, y_batch, d_batch in test_loader:
                X_batch = X_batch.to(DEVICE)
                y_batch = y_batch.to(DEVICE)
                d_batch = d_batch.to(DEVICE)

                return_pred, direction_logits = model(X_batch)

                loss_return = huber_loss(return_pred, y_batch)
                loss_direction = cross_entropy_loss(direction_logits, d_batch)
                loss = loss_return + DIRECTION_LOSS_WEIGHT * loss_direction

                running_val_loss += loss.item()

                all_predictions.extend(return_pred.cpu().numpy())
                all_targets.extend(y_batch.cpu().numpy())

                direction_pred_classes = torch.argmax(direction_logits, dim=1).cpu().numpy()
                all_direction_preds.extend(direction_pred_classes)
                all_direction_targets.extend(d_batch.cpu().numpy())

                X_validation_raw.extend(X_batch.cpu().numpy())
                y_validation_raw.extend(y_batch.cpu().numpy())

        avg_val_loss = running_val_loss / len(test_loader)
        val_losses.append(avg_val_loss)

        scheduler.step(avg_val_loss)

        all_predictions = np.array(all_predictions)
        all_targets = np.array(all_targets)
        all_direction_preds = np.array(all_direction_preds)
        all_direction_targets = np.array(all_direction_targets)

        # ---- Unscale: RETURN space, not price ----
        return_pred_real = target_scaler.inverse_transform(all_predictions)[:, 0]
        return_true_real = target_scaler.inverse_transform(all_targets)[:, 0]

        prediction_std = np.std(return_pred_real)
        target_std = np.std(return_true_real)

        mae = mean_absolute_error(return_true_real, return_pred_real)
        rmse = np.sqrt(mean_squared_error(return_true_real, return_pred_real))
        r2 = r2_score(return_true_real, return_pred_real)
        corr = float(np.corrcoef(return_true_real, return_pred_real)[0, 1])

        residual_std = np.std(return_true_real - return_pred_real)

        confidence_score = calculate_confidence_score(
            residual_std, np.mean(return_true_real)
        )

        # ---- Direction (single-step) metrics ----
        direction_accuracy = accuracy_score(all_direction_targets, all_direction_preds)
        direction_f1 = f1_score(
            all_direction_targets, all_direction_preds,
            average="macro", zero_division=0
        )

        multi_step_mae = multi_step_validation(
            model,
            np.array(X_validation_raw),
            np.array(y_validation_raw),
            feature_scaler,
            target_scaler,
            steps=MULTI_STEP_VALIDATION_STEPS
        )

        mae_list.append(mae)
        rmse_list.append(rmse)
        r2_list.append(r2)
        corr_list.append(corr)
        confidence_score_list.append(confidence_score)
        multi_step_mae_list.append(multi_step_mae)
        direction_accuracy_list.append(direction_accuracy)
        direction_f1_list.append(direction_f1)

        print("\n========== RETURN DIAGNOSTICS (target_next_return) ==========")
        print("Prediction STD:", prediction_std)
        print("Target STD    :", target_std)
        print("Prediction Mean:", np.mean(return_pred_real))
        print("Target Mean    :", np.mean(return_true_real))
        print("Prediction Min :", np.min(return_pred_real))
        print("Prediction Max :", np.max(return_pred_real))
        print("Target Min     :", np.min(return_true_real))
        print("Target Max     :", np.max(return_true_real))
        print("======================================")

        print(f"Epoch [{epoch + 1}] Completed")
        print(f"Train Loss          : {avg_train_loss:.6f}")
        print(f"Val Loss            : {avg_val_loss:.6f}")
        print(f"MAE                 : {mae:.6f}")
        print(f"RMSE                : {rmse:.6f}")
        print(f"R\u00b2                  : {r2:.6f}")
        print(f"Correlation         : {corr:.6f}")
        print(f"Confidence Score    : {confidence_score:.2f}%")
        print(f"Multi-Step MAE      : {multi_step_mae:.6f}")
        print(f"Direction Accuracy  : {direction_accuracy:.4f}")
        print(f"Direction F1 (macro): {direction_f1:.4f}")

        if progress_callback:
            progress_callback(epoch + 1, EPOCHS, avg_train_loss, avg_val_loss)

        if avg_val_loss < best_val_loss:
            best_val_loss = avg_val_loss
            patience_counter = 0

            torch.save(
                {
                    "model_state_dict": model.state_dict(),
                    "model_type": "TCN",
                    "features": features,
                    "indicators": indicators,
                    "indicator_columns": indicator_columns,
                    "sequence_length": SEQUENCE_LENGTH,
                    "forecast_steps": FORECAST_STEPS,

                    "target_columns": TARGET_COLUMNS,
                    "target_type": TARGET_TYPE,

                    "direction_column": DIRECTION_COLUMN,
                    "direction_classes": DIRECTION_CLASSES,
                    "direction_threshold": DIRECTION_THRESHOLD,
                    "direction_loss_weight": DIRECTION_LOSS_WEIGHT,

                    "target_scaler_mean": target_scaler.mean_,
                    "target_scaler_scale": target_scaler.scale_,

                    "feature_scaler_mean": feature_scaler.mean_,
                    "feature_scaler_scale": feature_scaler.scale_,

                    "close_feature_index": CLOSE_FEATURE_INDEX,
                    "open_feature_index": OPEN_FEATURE_INDEX,

                    "residual_std": residual_std,
                    "confidence_score": confidence_score,
                    "multi_step_validation_mae": multi_step_mae,
                    "direction_accuracy": direction_accuracy,
                    "direction_f1": direction_f1,

                    "dropout_rate": DROPOUT_RATE,
                    "tcn_num_channels": TCN_NUM_CHANNELS,
                    "tcn_kernel_size": TCN_KERNEL_SIZE,
                    "multi_step_validation_steps": MULTI_STEP_VALIDATION_STEPS,
                },
                MODEL_PATH
            )

            print("\nBest TCN Model Saved")

        else:
            patience_counter += 1

        if patience_counter >= PATIENCE:
            print("\nEarly Stopping Triggered")
            return True

    print("\nTCN Training Complete.")
    return True


if __name__ == "__main__":
    train_model(symbol=DEFAULT_SYMBOL, indicators=DEFAULT_INDICATORS)
