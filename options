def calculate_confidence_score(residual_std, target_mean):
    if target_mean == 0:
        return 0.0

    confidence = 100 - (
        residual_std / abs(target_mean)
    ) * 100

    confidence = max(
        0,
        min(100, confidence)
    )

    return float(confidence)


def multi_step_validation(
    model,
    X_raw,
    y_raw,
    target_scaler,
    steps=MULTI_STEP_VALIDATION_STEPS,
    options_columns=None
):
    """
    Rolls the model forward `steps` bars, feeding its own next_open
    prediction back in as the next bar's open/close, and measures how
    far off the next_open predictions drift.

    IMPORTANT: this recursive rollout only ever overwrites the
    open/close slots of BASE_FEATURES (indices 4 and 2). It has no
    way to produce future expiry1_/expiry2_/expiry3_ options values --
    doing so would mean inventing fake future options-chain data. So
    whenever options features are part of the input (options_columns
    is non-empty), this function is skipped entirely and reports
    np.nan instead of silently reusing stale, copied-forward options
    values across the recursive horizon.
    """
    if options_columns:
        print(
            "Multi-step recursive validation skipped because future "
            "options features are unavailable."
        )
        return float(np.nan)

    model.eval()

    predictions = []
    targets = []

    sample_count = min(
        len(X_raw) - steps,
        300
    )

    if sample_count <= 0:
        return 0.0

    # target_next_open is the only column the target_scaler was
    # fit on, so its stats live at index 0.
    next_open_mean = target_scaler.mean_[0]
    next_open_scale = target_scaler.scale_[0]

    with torch.no_grad():
        for i in range(sample_count):
            current_sequence = X_raw[i].copy()

            step_predictions = []

            for step in range(steps):
                seq_tensor = (
                    torch.tensor(
                        current_sequence,
                        dtype=torch.float32
                    )
                    .unsqueeze(0)
                    .to(DEVICE)
                )

                pred_vector = (
                    model(seq_tensor)
                    .cpu()
                    .numpy()[0]
                )

                pred_next_open_scaled = pred_vector[0]

                step_predictions.append(pred_next_open_scaled)

                next_sequence = current_sequence.copy()
                next_sequence[:-1] = next_sequence[1:]

                # BASE_FEATURES = [high, low, close, volume, open], so
                # "close" is index 2 and "open" is index 4. BASE_FEATURES
                # always occupies the first 5 feature columns regardless
                # of which indicators are selected (see
                # resolve_feature_columns()). These MUST be updated
                # together with BASE_FEATURES if its order ever changes.
                #
                # FIX: the previous version of this file wrote the
                # prediction into indices 0 and 3 (high/volume), which
                # corrupted the rolled-forward window instead of
                # updating open/close. That silently degraded
                # multi-step validation accuracy -- corrected here.
                next_sequence[-1] = next_sequence[-2]
                next_sequence[-1][4] = pred_next_open_scaled
                next_sequence[-1][2] = pred_next_open_scaled

                current_sequence = next_sequence

            predictions.extend(step_predictions)

            # y_raw column 0 is target_next_open (scaled)
            targets.extend(
                y_raw[i:i + steps, 0]
            )

    predictions = np.array(predictions)
    targets = np.array(targets)

    predictions_real = (predictions * next_open_scale) + next_open_mean
    targets_real = (targets * next_open_scale) + next_open_mean

    multi_mae = mean_absolute_error(
        targets_real,
        predictions_real
    )

    return float(multi_mae)


# =========================================================
# TRAINING FUNCTION
# =========================================================

def train_model(
    symbol=DEFAULT_SYMBOL,
    indicators=None,
    progress_callback=None,
    stop_callback=None,
    data_source="ftp",
    data_path=""
):
    # Default to the full EMA9 + EMA20 + EMA50 + VWAP + RSI14 + ATR14
    # + MACD indicator set for this pipeline. Callers can still pass a
    # subset, but nothing outside INDICATOR_COLUMN_MAP is accepted --
    # see INDICATOR_REGISTRY / normalize_indicator_name().
    if indicators is None:
        indicators = list(DEFAULT_INDICATORS)

    # ---- Normalize into canonical names ----
    indicators = normalize_indicator_list(indicators)

    best_val_loss = np.inf
    patience_counter = 0

    train_losses.clear()
    val_losses.clear()
    mae_list.clear()
    rmse_list.clear()
    r2_list.clear()
    corr_list.clear()
    confidence_score_list.clear()
    multi_step_mae_list.clear()

    symbol = symbol.upper()

    MODEL_PATH = (
        Path(__file__).parent.parent
        / "models"
        / f"best_tcn_{symbol.lower()}.pth"
    )

    MODEL_PATH.parent.mkdir(
        parents=True,
        exist_ok=True
    )

    (
        train_loader,
        test_loader,
        feature_scaler,
        target_scaler,
        features,
        indicator_columns,
        options_columns
    ) = prepare_training_data(symbol, indicators, data_source, data_path)

    options_present = len(options_columns) > 0

    # ---- Print the full pre-training configuration banner ----
    print_training_summary(
        symbol,
        indicators,
        indicator_columns,
        features,
        data_source=data_source,
        options_columns=options_columns
    )

    huber_loss = nn.HuberLoss()          # single regression target

    model = TCNRegressor(
        n_features=len(features)
    ).to(DEVICE)

    optimizer = torch.optim.AdamW(
        model.parameters(),
        lr=LEARNING_RATE,
        weight_decay=WEIGHT_DECAY
    )

    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(
        optimizer,
        mode="min",
        factor=0.5,
        patience=10
    )

    for epoch in range(EPOCHS):
        print(f"\nEpoch [{epoch + 1}/{EPOCHS}] Started...")

        model.train()

        running_train_loss = 0

        for X_batch, y_batch in train_loader:
            if stop_callback and stop_callback():
                print("\nTraining Stopped By User")
                return False

            X_batch = X_batch.to(DEVICE)
            y_batch = y_batch.to(DEVICE)

            optimizer.zero_grad()

            predictions = model(X_batch)

            loss = huber_loss(predictions, y_batch)

            loss.backward()

            torch.nn.utils.clip_grad_norm_(
                model.parameters(),
                1.0
            )

            optimizer.step()

            running_train_loss += loss.item()

        avg_train_loss = running_train_loss / len(train_loader)
        train_losses.append(avg_train_loss)

        model.eval()

        running_val_loss = 0
        all_predictions = []
        all_targets = []
        X_validation_raw = []
        y_validation_raw = []

        with torch.no_grad():
            for X_batch, y_batch in test_loader:
                X_batch = X_batch.to(DEVICE)
                y_batch = y_batch.to(DEVICE)

                predictions = model(X_batch)

                loss = huber_loss(predictions, y_batch)

                running_val_loss += loss.item()

                all_predictions.extend(
                    predictions.cpu().numpy()
                )

                all_targets.extend(
                    y_batch.cpu().numpy()
                )

                X_validation_raw.extend(
                    X_batch.cpu().numpy()
                )

                y_validation_raw.extend(
                    y_batch.cpu().numpy()
                )

        avg_val_loss = running_val_loss / len(test_loader)
        val_losses.append(avg_val_loss)

        scheduler.step(avg_val_loss)

        all_predictions = np.array(all_predictions)   # (N, 1) scaled
        all_targets = np.array(all_targets)             # (N, 1) scaled

        # ---- Unscale the single regression target ----
        next_open_pred_real = target_scaler.inverse_transform(
            all_predictions
        )[:, 0]

        next_open_true_real = target_scaler.inverse_transform(
            all_targets
        )[:, 0]

        prediction_std = np.std(next_open_pred_real)
        target_std = np.std(next_open_true_real)

        mae = mean_absolute_error(
            next_open_true_real,
            next_open_pred_real
        )

        rmse = np.sqrt(
            mean_squared_error(
                next_open_true_real,
                next_open_pred_real
            )
        )

        r2 = r2_score(
            next_open_true_real,
            next_open_pred_real
        )

        corr = float(
            np.corrcoef(
                next_open_true_real,
                next_open_pred_real
            )[0, 1]
        )

        residual_std = np.std(
            next_open_true_real - next_open_pred_real
        )

        confidence_score = calculate_confidence_score(
            residual_std,
            np.mean(next_open_true_real)
        )

        # ---- One-step validation is always run, unchanged, above.
        # Multi-step (recursive) validation is skipped internally by
        # multi_step_validation() whenever options_columns is
        # non-empty, and returns np.nan in that case instead of
        # recursively fabricating future options features. ----
        multi_step_mae = multi_step_validation(
            model,
            np.array(X_validation_raw),
            np.array(y_validation_raw),
            target_scaler,
            steps=MULTI_STEP_VALIDATION_STEPS,
            options_columns=options_columns
        )

        mae_list.append(mae)
        rmse_list.append(rmse)
        r2_list.append(r2)
        corr_list.append(corr)
        confidence_score_list.append(confidence_score)
        multi_step_mae_list.append(multi_step_mae)

        print("\n========== PRICE DIAGNOSTICS (target_next_open) ==========")
        print("Prediction STD:", prediction_std)
        print("Target STD    :", target_std)
        print("Volatility Ratio:", prediction_std / target_std)
        print("Prediction Mean:", np.mean(next_open_pred_real))
        print("Target Mean    :", np.mean(next_open_true_real))
        print("Prediction Min :", np.min(next_open_pred_real))
        print("Prediction Max :", np.max(next_open_pred_real))
        print("Target Min     :", np.min(next_open_true_real))
        print("Target Max     :", np.max(next_open_true_real))
        print("======================================")

        # ---- Safe formatting: multi_step_mae is np.nan whenever
        # options features are enabled, so it can't go through a
        # plain ":.6f}" format spec without raising. ----
        if np.isnan(multi_step_mae):
            multi_step_mae_display = "N/A (options features enabled)"
        else:
            multi_step_mae_display = f"{multi_step_mae:.6f}"

        print(f"Epoch [{epoch + 1}] Completed")
        print(f"Train Loss          : {avg_train_loss:.6f}")
        print(f"Val Loss            : {avg_val_loss:.6f}")
        print(f"MAE                 : {mae:.6f}")
        print(f"RMSE                : {rmse:.6f}")
        print(f"R\u00b2                  : {r2:.6f}")
        print(f"Correlation         : {corr:.6f}")
        print(f"Confidence Score    : {confidence_score:.2f}%")
        print(f"Multi-Step MAE      : {multi_step_mae_display}")

        if progress_callback:
            progress_callback(
                epoch + 1,
                EPOCHS,
                avg_train_loss,
                avg_val_loss
            )

        if avg_val_loss < best_val_loss:
            best_val_loss = avg_val_loss
            patience_counter = 0

            torch.save(
                {
                    "model_state_dict": model.state_dict(),
                    "features": features,
                    "indicators": indicators,
                    "indicator_columns": indicator_columns,
                    "sequence_length": SEQUENCE_LENGTH,
                    "forecast_steps": FORECAST_STEPS,

                    "target_columns": TARGET_COLUMNS,

                    "target_scaler_mean": target_scaler.mean_,
                    "target_scaler_scale": target_scaler.scale_,

                    "feature_scaler_mean": feature_scaler.mean_,
                    "feature_scaler_scale": feature_scaler.scale_,

                    "residual_std": residual_std,
                    "confidence_score": confidence_score,
                    "multi_step_validation_mae": multi_step_mae,

                    "dropout_rate": DROPOUT_RATE,
                    "multi_step_validation_steps": MULTI_STEP_VALIDATION_STEPS,

                    # ---- Options-feature metadata (new) ----
                    "options_features_enabled": options_present,
                    "options_columns": options_columns,
                },
                MODEL_PATH
            )

            print("\nBest TCN Model Saved")

        else:
            patience_counter += 1

        if patience_counter >= PATIENCE:
            print("\nEarly Stopping Triggered")
            return True

    print("\nTCN Training Complete.")
    return True


if __name__ == "__main__":
    # Standalone run: trains on the combined local OHLCV + indicators
    # + expiry1_/expiry2_/expiry3_ options feature set.
    train_model(
        symbol=DEFAULT_SYMBOL,
        indicators=DEFAULT_INDICATORS,
        data_source="local",
        data_path="data/options/OptionsDataAllDteSPY.jsonlines"
    )
