    print(f"Symbol             : {symbol}")
    print(f"Data Source        : {data_source.upper()}")
    print()
    print(f"Base Features      : {len(BASE_FEATURES)}")
    print(f"Indicator Features : {len(resolve_indicator_columns(indicators))}")

    if data_source == "local":
        print(f"Options Features   : {len(options_columns)}")
        print(f"Total Features     : {len(features)}  (expected 116)")
    else:
        print(f"Options Features   : {len(options_columns)}  (expected 0 for FTP)")
        print(f"Total Features     : {len(features)}  (expected 14)")

