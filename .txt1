"""
XAUUSD M6 trend-pullback bot for MetaTrader 5.

!! USE A DEMO ACCOUNT FIRST. No strategy guarantees profit. !!

Setup:
    pip install MetaTrader5 pandas numpy
    Open MT5 terminal, log in to a DEMO account, enable Algo Trading.
    python xauusd_m5_bot.py
"""
import time
from datetime import datetime, timezone

import MetaTrader5 as mt5
import numpy as np
import pandas as pd

# ---------------- CONFIG ----------------
SYMBOL = "XAUUSD"          # some brokers use "GOLD" or "XAUUSDm"
MAGIC = 550055
RISK_PCT = 0.5             # % of equity risked per trade
DAILY_LOSS_PCT = 2.0       # stop trading for the day after this realized loss %
ATR_PERIOD = 14
SL_ATR = 1.5
TP_ATR = 2.25              # reward:risk = 1.5
MAX_SPREAD_POINTS = 40     # skip if spread is wider (points; 40 = $0.40 on most brokers)
SESSION_UTC = (7, 17)      # London open to NY midday (UTC hours)
DEVIATION = 20             # max slippage in points
# -----------------------------------------


def ema(series: pd.Series, n: int) -> pd.Series:
    return series.ewm(span=n, adjust=False).mean()


def atr(df: pd.DataFrame, n: int) -> pd.Series:
    prev_close = df["close"].shift(1)
    tr = pd.concat(
        [df["high"] - df["low"],
         (df["high"] - prev_close).abs(),
         (df["low"] - prev_close).abs()],
        axis=1,
    ).max(axis=1)
    return tr.ewm(alpha=1 / n, adjust=False).mean()


def get_rates(timeframe, count=300) -> pd.DataFrame:
    # start_pos=1 skips the still-forming candle -> only CLOSED candles
    rates = mt5.copy_rates_from_pos(SYMBOL, timeframe, 1, count)
    if rates is None or len(rates) == 0:
        raise RuntimeError(f"No rates: {mt5.last_error()}")
    return pd.DataFrame(rates)


def get_signal():
    """Return 'buy', 'sell' or None, plus ATR value."""
    m5 = get_rates(mt5.TIMEFRAME_M5)
    m15 = get_rates(mt5.TIMEFRAME_M15)

    m15_ema50 = ema(m15["close"], 50)
    trend_up = m15["close"].iloc[-1] > m15_ema50.iloc[-1] and m15_ema50.iloc[-1] > m15_ema50.iloc[-4]
    trend_down = m15["close"].iloc[-1] < m15_ema50.iloc[-1] and m15_ema50.iloc[-1] < m15_ema50.iloc[-4]

    m5["ema20"] = ema(m5["close"], 20)
    m5["atr"] = atr(m5, ATR_PERIOD)
    c = m5.iloc[-1]  # last closed M5 candle

    bullish = c["close"] > c["open"]
    bearish = c["close"] < c["open"]

    # Pullback touched EMA20, then closed back in trend direction
    if trend_up and c["low"] <= c["ema20"] < c["close"] and bullish:
        return "buy", c["atr"]
    if trend_down and c["high"] >= c["ema20"] > c["close"] and bearish:
        return "sell", c["atr"]
    return None, c["atr"]


def lot_size(sl_distance: float) -> float:
    info = mt5.symbol_info(SYMBOL)
    equity = mt5.account_info().equity
    risk_money = equity * RISK_PCT / 100
    loss_per_lot = sl_distance / info.trade_tick_size * info.trade_tick_value
    lots = risk_money / loss_per_lot
    step = info.volume_step
    lots = np.floor(lots / step) * step
    return float(min(max(lots, info.volume_min), info.volume_max))


def has_open_position() -> bool:
    pos = mt5.positions_get(symbol=SYMBOL)
    return bool(pos) and any(p.magic == MAGIC for p in pos)


def daily_loss_hit() -> bool:
    now = datetime.now()
    start = now.replace(hour=0, minute=0, second=0, microsecond=0)
    deals = mt5.history_deals_get(start, now)
    if not deals:
        return False
    pnl = sum(d.profit + d.commission + d.swap for d in deals if d.magic == MAGIC)
    balance = mt5.account_info().balance
    return pnl <= -balance * DAILY_LOSS_PCT / 100


def in_session() -> bool:
    h = datetime.now(timezone.utc).hour
    return SESSION_UTC[0] <= h < SESSION_UTC[1]


def spread_ok() -> bool:
    info = mt5.symbol_info(SYMBOL)
    return info.spread <= MAX_SPREAD_POINTS


def place_order(side: str, atr_value: float):
    tick = mt5.symbol_info_tick(SYMBOL)
    info = mt5.symbol_info(SYMBOL)
    sl_dist = SL_ATR * atr_value
    tp_dist = TP_ATR * atr_value
    digits = info.digits

    if side == "buy":
        price = tick.ask
        sl, tp = price - sl_dist, price + tp_dist
        order_type = mt5.ORDER_TYPE_BUY
    else:
        price = tick.bid
        sl, tp = price + sl_dist, price - tp_dist
        order_type = mt5.ORDER_TYPE_SELL

    request = {
        "action": mt5.TRADE_ACTION_DEAL,
        "symbol": SYMBOL,
        "volume": lot_size(sl_dist),
        "type": order_type,
        "price": price,
        "sl": round(sl, digits),
        "tp": round(tp, digits),
        "deviation": DEVIATION,
        "magic": MAGIC,
        "comment": "xau_m5_pullback",
        "type_time": mt5.ORDER_TIME_GTC,
        "type_filling": mt5.ORDER_FILLING_IOC,  # change to FOK/RETURN if broker rejects
    }
    result = mt5.order_send(request)
    print(f"[{datetime.now():%H:%M:%S}] {side.upper()} -> retcode={result.retcode} {result.comment}")


def wait_for_new_candle(last_time):
    while True:
        bar = mt5.copy_rates_from_pos(SYMBOL, mt5.TIMEFRAME_M5, 0, 1)
        if bar is not None and bar[0]["time"] != last_time:
            return bar[0]["time"]
        time.sleep(1)


def main():
    if not mt5.initialize():
        raise SystemExit(f"MT5 init failed: {mt5.last_error()}")
    if not mt5.symbol_select(SYMBOL, True):
        raise SystemExit(f"Symbol {SYMBOL} not found")

    print("Account:", mt5.account_info().login, "| Balance:", mt5.account_info().balance)
    last_bar = None
    try:
        while True:
            last_bar = wait_for_new_candle(last_bar)   # runs once per new M5 candle
            if not in_session():
                continue
            if daily_loss_hit():
                print("Daily loss limit hit - no more trades today.")
                continue
            if has_open_position() or not spread_ok():
                continue
            side, atr_value = get_signal()
            if side:
                place_order(side, atr_value)
    except KeyboardInterrupt:
        print("Stopped.")
    finally:
        mt5.shutdown()


if __name__ == "__main__":
    main()
