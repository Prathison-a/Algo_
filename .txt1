          f"{int(VAL_SPLIT*100)}% Val / "
          f"{int((1 - TRAIN_SPLIT - VAL_SPLIT)*100)}% Test (chronological)")
    print(f"Loss Weights       : Return={RETURN_LOSS_WEIGHT} / Direction={DIRECTION_LOSS_WEIGHT}")
    print("=========================================")
    print("Training Started...")
    print("=========================================\n")


# =========================================================
# PREPARE TRAINING DATA
# =========================================================

def prepare_training_data(symbol, indicators, data_source="ftp", data_path=""):
    dataframe = load_symbol_data(symbol, data_source, data_path)

    print(f"\nMerged Shape: {dataframe.shape}")

    dataframe.columns = [
        column.lower().strip()
        for column in dataframe.columns
    ]

    try:
        dataframe["datetime"] = pd.to_datetime(
            dataframe["datetime"],
            unit="ms"
        )
    except:
        dataframe["datetime"] = pd.to_datetime(
            dataframe["datetime"]
        )

    dataframe = dataframe.sort_values("datetime")
    dataframe.reset_index(drop=True, inplace=True)

    # ---- Feature engineering: selected indicators only ----
    dataframe = add_indicators(dataframe, indicators)
    indicator_columns = resolve_indicator_columns(indicators)

    # ---- Options features (expiry1_ / expiry2_ / expiry3_) ----
    options_columns = resolve_options_columns(dataframe)

    features = resolve_feature_columns(indicators) + options_columns

    if len(options_columns) != 102:
        raise RuntimeError(
            f"Expected 102 options features, found {len(options_columns)}"
        )

    if len(features) != 116:
        raise RuntimeError(
            f"Expected 116 total features, found {len(features)}"
        )

    # ---- Targets: next-bar return + SELL/HOLD/BUY direction ----
    dataframe = add_targets(dataframe)

    dataframe[features] = dataframe[features].ffill().fillna(0)
    dataframe.dropna(subset=TARGET_COLUMNS, inplace=True)
    dataframe.reset_index(drop=True, inplace=True)

    # ---- CHANGE #1: Chronological 70/15/15 split ----
    # The data is already sorted by datetime above, so a straight
    # positional slice keeps train < val < test in time order. No
    # shuffling happens anywhere in this split.
    total_rows = len(dataframe)
    train_end = int(total_rows * TRAIN_SPLIT)
    val_end = int(total_rows * (TRAIN_SPLIT + VAL_SPLIT))

    train_dataframe = dataframe.iloc[:train_end].copy()
    val_dataframe = dataframe.iloc[train_end:val_end].copy()
    test_dataframe = dataframe.iloc[val_end:].copy()

    # ---- CHANGE #2: BUY/HOLD/SELL class distribution ----
    # Diagnostic only, computed on the raw (unscaled) target_direction
    # labels for each split, purely to check class imbalance.
    print("\n=========================================")
    print("Class Distribution Check (SELL / HOLD / BUY)")
    print("=========================================")
    print_class_distribution("Train", train_dataframe)
    print_class_distribution("Validation", val_dataframe)
    print_class_distribution("Test", test_dataframe)
    print("=========================================")

    # ---- Scale input features (fit on TRAIN ONLY) ----
    train_dataframe[features] = feature_scaler.fit_transform(
        train_dataframe[features]
    )

    val_dataframe[features] = feature_scaler.transform(
        val_dataframe[features]
    )

    test_dataframe[features] = feature_scaler.transform(
        test_dataframe[features]
    )

    # ---- Scale ONLY the regression target (fit on TRAIN ONLY) ----
    # target_direction stays as raw integer class labels (0/1/2).
    train_dataframe[["target_next_return"]] = target_scaler.fit_transform(
        train_dataframe[["target_next_return"]]
    )

    val_dataframe[["target_next_return"]] = target_scaler.transform(
        val_dataframe[["target_next_return"]]
    )

    test_dataframe[["target_next_return"]] = target_scaler.transform(
        test_dataframe[["target_next_return"]]
    )

    X_train, y_train = create_sequences(train_dataframe, features)
    X_val, y_val = create_sequences(val_dataframe, features)
    X_test, y_test = create_sequences(test_dataframe, features)

    if len(X_train) == 0:
        raise RuntimeError("Training dataset is empty")

    if len(X_val) == 0:
        raise RuntimeError("Validation dataset is empty")

    if len(X_test) == 0:
        raise RuntimeError("Test dataset is empty")

    print(f"\nTrain Shape     : {X_train.shape}")
    print(f"Validation Shape: {X_val.shape}")
    print(f"Test Shape      : {X_test.shape}")

    train_dataset = MarketDataset(
        X_train,
        y_train
    )

    val_dataset = MarketDataset(
        X_val,
        y_val
    )

    test_dataset = MarketDataset(
        X_test,
        y_test
    )

    train_loader = DataLoader(
        train_dataset,
        batch_size=BATCH_SIZE,
        shuffle=True,
        drop_last=True
    )

    val_loader = DataLoader(
        val_dataset,
        batch_size=BATCH_SIZE,
        shuffle=False
    )

    test_loader = DataLoader(
        test_dataset,
        batch_size=BATCH_SIZE,
        shuffle=False
    )

    return (
        train_loader,
        val_loader,
        test_loader,
        feature_scaler,
        target_scaler,
        features,
        indicator_columns,
        options_columns
    )


# =========================================================
# TCN MODEL
# The input layer size (n_features) is passed in dynamically from
# len(features). With the full DEFAULT_INDICATORS set plus the 102
# options features that's:
#   5 base OHLCV + 9 indicator columns + 102 options columns = 116.
#
# The output layer now has two heads:
#   - return_head:    1 value  -> predicted (scaled) target_next_return
#   - direction_head: 3 logits -> SELL / HOLD / BUY
# =========================================================

class TemporalBlock(nn.Module):

    def __init__(self, in_channels, out_channels, dilation):
        super().__init__()

        kernel_size = 5
        padding = (kernel_size - 1) * dilation

        self.conv1 = nn.Conv1d(
            in_channels,
            out_channels,
            kernel_size=kernel_size,
            padding=padding,
            dilation=dilation
        )

        self.conv2 = nn.Conv1d(
            out_channels,
            out_channels,
            kernel_size=kernel_size,
            padding=padding,
            dilation=dilation
        )

        self.gelu = nn.GELU()
        self.dropout = nn.Dropout(DROPOUT_RATE)

        self.downsample = (
            nn.Conv1d(
                in_channels,
                out_channels,
                kernel_size=1
            )
            if in_channels != out_channels
            else None
        )

    def forward(self, x):
        output = self.conv1(x)
        output = output[:, :, :-self.conv1.padding[0]]

        output = self.conv2(output)
        output = output[:, :, :-self.conv2.padding[0]]

        output = self.gelu(output)
        output = self.dropout(output)

        residual = x

        if self.downsample:
            residual = self.downsample(x)

        min_length = min(
            output.shape[2],
            residual.shape[2]
        )

        output = output[:, :, -min_length:]
        residual = residual[:, :, -min_length:]

        return output + residual


class TCNDualHead(nn.Module):

    def __init__(self, n_features):
        super().__init__()

        self.block1 = TemporalBlock(
            n_features,
            32,
            dilation=1
        )

        self.block2 = TemporalBlock(
            32,
            64,
            dilation=2
        )

        self.block3 = TemporalBlock(
            64,
            64,
            dilation=4
        )

        self.block4 = TemporalBlock(
            64,
            64,
            dilation=8
        )

        self.gelu = nn.GELU()
        self.dropout = nn.Dropout(DROPOUT_RATE)
        self.recent_timesteps = 4

        self.fc1 = nn.Linear(
            64 * self.recent_timesteps,
            128
        )

        self.fc2 = nn.Linear(
            128,
            64
        )

        # Two heads sharing the same TCN representation.
        self.return_head = nn.Linear(64, 1)
        self.direction_head = nn.Linear(64, 3)

    def forward(self, x):
        x = x.permute(0, 2, 1)

        x = self.block1(x)
        x = self.block2(x)
        x = self.block3(x)
        x = self.block4(x)

        x = x[:, :, -self.recent_timesteps:]

        x = x.reshape(
            x.size(0),
            -1
        )

        x = self.fc1(x)
        x = self.gelu(x)
        x = self.dropout(x)

        x = self.fc2(x)
        x = self.gelu(x)
        x = self.dropout(x)

        return_prediction = self.return_head(x)
        direction_logits = self.direction_head(x)

        # No softmax here -- CrossEntropyLoss expects raw logits, and
        # trading confidence is derived from softmax(direction_logits)
        # outside the model (see calculate_trading_confidence()).
        return return_prediction, direction_logits


# =========================================================
# METRICS
# =========================================================

train_losses = []
val_losses = []
mae_list = []
rmse_list = []
r2_list = []
corr_list = []
confidence_score_list = []
multi_step_mae_list = []

direction_accuracy_list = []
direction_precision_list = []
direction_recall_list = []
trading_confidence_list = []


def calculate_confidence_score(residual_std, target_mean):
    """
    Legacy regression/statistical diagnostic only. This is NOT used as
    trading confidence anymore -- see calculate_trading_confidence().
    """
    if target_mean == 0:
        return 0.0

    confidence = 100 - (
        residual_std / abs(target_mean)
    ) * 100

    confidence = max(
        0,
        min(100, confidence)
    )

    return float(confidence)


def calculate_trading_confidence(direction_logits):
    """
    Trading confidence comes from the direction head: softmax over
    SELL/HOLD/BUY logits, then the highest probability is the
    confidence for that predicted class.
    """
    probabilities = torch.softmax(
        direction_logits,
        dim=1
    )

    confidence = torch.max(
        probabilities,
        dim=1
    ).values

    return probabilities, confidence


def multi_step_validation(
    model,
    X_raw,
    y_raw,
    target_scaler,
    steps=MULTI_STEP_VALIDATION_STEPS
):
    """
    Rolls the model forward `steps` bars, feeding its own predicted
    return back in (translated into an updated open/close) and
    measures how far off the return predictions drift.

    NOTE: per the leakage rules, this path is only ever reached when
    there are NO options columns in play (see train_model()). With
    the 116-feature options pipeline this function is intentionally
    skipped, since faking future options data is not allowed.
    """
    model.eval()

    predictions = []
    targets = []

    sample_count = min(
        len(X_raw) - steps,
        300
    )

    if sample_count <= 0:
        return 0.0

    # target_next_return is the only column the target_scaler was
    # fit on, so its stats live at index 0.
    next_return_mean = target_scaler.mean_[0]
    next_return_scale = target_scaler.scale_[0]

    with torch.no_grad():
        for i in range(sample_count):
            current_sequence = X_raw[i].copy()

            step_predictions = []

            for step in range(steps):
                seq_tensor = (
                    torch.tensor(
                        current_sequence,
                        dtype=torch.float32
                    )
                    .unsqueeze(0)
                    .to(DEVICE)
                )

                pred_return, _pred_direction_logits = model(seq_tensor)

                pred_vector = (
                    pred_return
                    .cpu()
                    .numpy()[0]
                )

                pred_next_return_scaled = pred_vector[0]

                step_predictions.append(pred_next_return_scaled)

                next_sequence = current_sequence.copy()
                next_sequence[:-1] = next_sequence[1:]

                # BASE_FEATURES = [high, low, close, volume, open], so
                # "close" is index 2 and "open" is index 4. BASE_FEATURES
                # always occupies the first 5 feature columns regardless
                # of which indicators are selected (see
                # resolve_feature_columns()). These MUST be updated
                # together with BASE_FEATURES if its order ever changes.
                next_sequence[-1] = next_sequence[-2]
                next_sequence[-1][4] = pred_next_return_scaled
                next_sequence[-1][2] = pred_next_return_scaled

                current_sequence = next_sequence

            predictions.extend(step_predictions)

            # y_raw column 0 is target_next_return (scaled)
            targets.extend(
                y_raw[i:i + steps, 0]
            )

    predictions = np.array(predictions)
    targets = np.array(targets)

    predictions_real = (predictions * next_return_scale) + next_return_mean
    targets_real = (targets * next_return_scale) + next_return_mean

    multi_mae = mean_absolute_error(
        targets_real,
        predictions_real
    )

    return float(multi_mae)


# =========================================================
# EVALUATION LOOP (used for validation each epoch, and once for the
# final held-out test evaluation)
# =========================================================

def run_evaluation(model, data_loader, target_scaler, huber_loss, direction_loss_fn,
                    run_multi_step=False):
    model.eval()

    running_loss = 0
    all_return_predictions = []
    all_return_targets = []
    all_direction_logits = []
    all_direction_targets = []
    all_trading_confidences = []
    X_raw = []
    y_raw = []

    with torch.no_grad():
        for X_batch, y_batch in data_loader:
            X_batch = X_batch.to(DEVICE)
            y_batch = y_batch.to(DEVICE)

            predicted_return, direction_logits = model(X_batch)

            y_return = y_batch[:, 0:1]
            y_direction = y_batch[:, 1].long()

            return_loss = huber_loss(
                predicted_return,
                y_return
            )

            classification_loss = direction_loss_fn(
                direction_logits,
                y_direction
            )

            # ---- CHANGE #3: weighted dual-head loss ----
            loss = (
                RETURN_LOSS_WEIGHT * return_loss
                + DIRECTION_LOSS_WEIGHT * classification_loss
            )

            running_loss += loss.item()

            all_return_predictions.extend(predicted_return.cpu().numpy())
            all_return_targets.extend(y_return.cpu().numpy())
            all_direction_logits.extend(direction_logits.cpu().numpy())
            all_direction_targets.extend(y_direction.cpu().numpy())

            _probabilities, batch_confidence = calculate_trading_confidence(
                direction_logits
            )
            all_trading_confidences.extend(batch_confidence.cpu().numpy())

            X_raw.extend(X_batch.cpu().numpy())
            y_raw.extend(y_batch.cpu().numpy())

    avg_loss = running_loss / len(data_loader)

    all_return_predictions = np.array(all_return_predictions)
    all_return_targets = np.array(all_return_targets)
    all_direction_logits = np.array(all_direction_logits)
    all_direction_targets = np.array(all_direction_targets)

    next_return_pred_real = target_scaler.inverse_transform(all_return_predictions)[:, 0]
    next_return_true_real = target_scaler.inverse_transform(all_return_targets)[:, 0]

    mae = mean_absolute_error(next_return_true_real, next_return_pred_real)
    rmse = np.sqrt(mean_squared_error(next_return_true_real, next_return_pred_real))
    r2 = r2_score(next_return_true_real, next_return_pred_real)
    corr = float(np.corrcoef(next_return_true_real, next_return_pred_real)[0, 1])
    residual_std = np.std(next_return_true_real - next_return_pred_real)

    confidence_score = calculate_confidence_score(
        residual_std,
        np.mean(next_return_true_real)
    )

    direction_predictions = np.argmax(all_direction_logits, axis=1)

    direction_accuracy = accuracy_score(all_direction_targets, direction_predictions)
    direction_precision = precision_score(
        all_direction_targets, direction_predictions, average="weighted", zero_division=0
    )
    direction_recall = recall_score(
        all_direction_targets, direction_predictions, average="weighted", zero_division=0
    )
    direction_confusion_matrix = confusion_matrix(
        all_direction_targets, direction_predictions, labels=[0, 1, 2]
    )

    mean_trading_confidence = float(np.mean(all_trading_confidences))

    multi_step_mae = 0.0
    if run_multi_step:
        multi_step_mae = multi_step_validation(
            model,
            np.array(X_raw),
            np.array(y_raw),
            target_scaler,
            steps=MULTI_STEP_VALIDATION_STEPS
        )

    return {
        "avg_loss": avg_loss,
        "mae": mae,
        "rmse": rmse,
        "r2": r2,
        "corr": corr,
        "residual_std": residual_std,
        "confidence_score": confidence_score,
        "direction_accuracy": direction_accuracy,
        "direction_precision": direction_precision,
        "direction_recall": direction_recall,
        "direction_confusion_matrix": direction_confusion_matrix,
        "mean_trading_confidence": mean_trading_confidence,
        "multi_step_mae": multi_step_mae,
        "next_return_pred_real": next_return_pred_real,
        "next_return_true_real": next_return_true_real,
    }


# =========================================================
# TRAINING FUNCTION
# =========================================================

def train_model(
    symbol=DEFAULT_SYMBOL,
    indicators=None,
    progress_callback=None,
    stop_callback=None,
    data_source="ftp",
    data_path=""
):
    # Default to the full EMA9 + EMA20 + EMA50 + VWAP + RSI14 + ATR14
    # + MACD indicator set for this pipeline. Callers can still pass a
    # subset, but nothing outside INDICATOR_COLUMN_MAP is accepted --
    # see INDICATOR_REGISTRY / normalize_indicator_name().
    if indicators is None:
        indicators = list(DEFAULT_INDICATORS)

    # ---- Normalize into canonical names ----
    indicators = normalize_indicator_list(indicators)

    best_val_loss = np.inf
    patience_counter = 0

    train_losses.clear()
    val_losses.clear()
    mae_list.clear()
    rmse_list.clear()
    r2_list.clear()
    corr_list.clear()
    confidence_score_list.clear()
    multi_step_mae_list.clear()
    direction_accuracy_list.clear()
    direction_precision_list.clear()
    direction_recall_list.clear()
    trading_confidence_list.clear()

    symbol = symbol.upper()

    MODEL_PATH = (
        Path(__file__).parent.parent
        / "models"
        / f"best_tcn_{symbol.lower()}.pth"
    )

    MODEL_PATH.parent.mkdir(
        parents=True,
        exist_ok=True
    )

    (
        train_loader,
        val_loader,
        test_loader,
        feature_scaler,
        target_scaler,
        features,
        indicator_columns,
        options_columns
    ) = prepare_training_data(symbol, indicators, data_source, data_path)

    # ---- Print the full pre-training configuration banner ----
    print_training_summary(symbol, indicators, indicator_columns, features, options_columns)

    huber_loss = nn.HuberLoss()
    direction_loss_fn = nn.CrossEntropyLoss()

    model = TCNDualHead(
        n_features=len(features)
    ).to(DEVICE)

    optimizer = torch.optim.AdamW(
        model.parameters(),
        lr=LEARNING_RATE,
        weight_decay=WEIGHT_DECAY
    )

    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(
        optimizer,
        mode="min",
        factor=0.5,
        patience=10
    )

    training_finished_normally = True

    for epoch in range(EPOCHS):
        print(f"\nEpoch [{epoch + 1}/{EPOCHS}] Started...")

        model.train()

        running_train_loss = 0

        for X_batch, y_batch in train_loader:
            if stop_callback and stop_callback():
                print("\nTraining Stopped By User")
                return False

            X_batch = X_batch.to(DEVICE)
            y_batch = y_batch.to(DEVICE)

            optimizer.zero_grad()

            predicted_return, direction_logits = model(X_batch)

            y_return = y_batch[:, 0:1]
            y_direction = y_batch[:, 1].long()

            return_loss = huber_loss(
                predicted_return,
                y_return
            )

            classification_loss = direction_loss_fn(
                direction_logits,
                y_direction
            )

            # ---- CHANGE #3: weighted dual-head loss ----
            loss = (
                RETURN_LOSS_WEIGHT * return_loss
                + DIRECTION_LOSS_WEIGHT * classification_loss
            )

            loss.backward()

            torch.nn.utils.clip_grad_norm_(
                model.parameters(),
                1.0
            )

            optimizer.step()

            running_train_loss += loss.item()

        avg_train_loss = running_train_loss / len(train_loader)
        train_losses.append(avg_train_loss)

        # ---- Validation pass (used for early stopping + LR scheduling) ----
        # Test data is NEVER touched here.
        eval_result = run_evaluation(
            model,
            val_loader,
            target_scaler,
            huber_loss,
            direction_loss_fn,
            run_multi_step=(len(options_columns) == 0)
        )

        avg_val_loss = eval_result["avg_loss"]
        val_losses.append(avg_val_loss)

        scheduler.step(avg_val_loss)

        mae = eval_result["mae"]
        rmse = eval_result["rmse"]
        r2 = eval_result["r2"]
        corr = eval_result["corr"]
        residual_std = eval_result["residual_std"]
        confidence_score = eval_result["confidence_score"]
        direction_accuracy = eval_result["direction_accuracy"]
        direction_precision = eval_result["direction_precision"]
        direction_recall = eval_result["direction_recall"]
        direction_confusion_matrix = eval_result["direction_confusion_matrix"]
        mean_trading_confidence = eval_result["mean_trading_confidence"]
        multi_step_mae = eval_result["multi_step_mae"]

        if options_columns:
            print(
                "Multi-step validation skipped: "
                "future options data is unavailable."
            )

        prediction_std = np.std(eval_result["next_return_pred_real"])
        target_std = np.std(eval_result["next_return_true_real"])

        mae_list.append(mae)
        rmse_list.append(rmse)
        r2_list.append(r2)
        corr_list.append(corr)
        confidence_score_list.append(confidence_score)
        multi_step_mae_list.append(multi_step_mae)
        direction_accuracy_list.append(direction_accuracy)
        direction_precision_list.append(direction_precision)
        direction_recall_list.append(direction_recall)
        trading_confidence_list.append(mean_trading_confidence)

        print("\n========== RETURN DIAGNOSTICS (target_next_return, VALIDATION) ==========")
        print("Prediction STD:", prediction_std)
        print("Target STD    :", target_std)
        print("Prediction Mean:", np.mean(eval_result["next_return_pred_real"]))
        print("Target Mean    :", np.mean(eval_result["next_return_true_real"]))
        print("Prediction Min :", np.min(eval_result["next_return_pred_real"]))
        print("Prediction Max :", np.max(eval_result["next_return_pred_real"]))
        print("Target Min     :", np.min(eval_result["next_return_true_real"]))
        print("Target Max     :", np.max(eval_result["next_return_true_real"]))
        print("======================================")

        print("\n========== DIRECTION DIAGNOSTICS (SELL=0 / HOLD=1 / BUY=2, VALIDATION) ==========")
        print(f"Direction Accuracy  : {direction_accuracy:.4f}")
        print(f"Direction Precision : {direction_precision:.4f}")
        print(f"Direction Recall    : {direction_recall:.4f}")
        print("Confusion Matrix (rows=true, cols=pred, order=[SELL, HOLD, BUY]):")
        print(direction_confusion_matrix)
        print(f"Mean Trading Confidence: {mean_trading_confidence:.4f}")
        print("======================================")

        print(f"Epoch [{epoch + 1}] Completed")
        print(f"Train Loss           : {avg_train_loss:.6f}")
        print(f"Val Loss             : {avg_val_loss:.6f}")
        print(f"Return MAE           : {mae:.6f}")
        print(f"Return RMSE          : {rmse:.6f}")
        print(f"Return R\u00b2            : {r2:.6f}")
        print(f"Correlation          : {corr:.6f}")
        print(f"Confidence Score     : {confidence_score:.2f}%  (legacy diagnostic)")
        print(f"Direction Accuracy   : {direction_accuracy:.4f}")
        print(f"Direction Precision  : {direction_precision:.4f}")
        print(f"Direction Recall     : {direction_recall:.4f}")
        print(f"Multi-Step MAE       : {multi_step_mae:.6f}")

        if progress_callback:
            progress_callback(
                epoch + 1,
                EPOCHS,
                avg_train_loss,
                avg_val_loss
            )

        if avg_val_loss < best_val_loss:
            best_val_loss = avg_val_loss
            patience_counter = 0

            torch.save(
                {
                    "model_state_dict": model.state_dict(),
                    "features": features,
                    "indicators": indicators,
                    "indicator_columns": indicator_columns,
                    "sequence_length": SEQUENCE_LENGTH,
                    "forecast_steps": FORECAST_STEPS,

                    "target_columns": TARGET_COLUMNS,
                    "direction_threshold": DIRECTION_THRESHOLD,
                    "direction_labels": DIRECTION_LABELS,
                    "min_signal_confidence": MIN_SIGNAL_CONFIDENCE,

                    "options_columns": options_columns,
                    "num_features": len(features),
                    "tcn_channels": [32, 64, 64, 64],
                    "kernel_size": 5,

                    "target_scaler_mean": target_scaler.mean_,
                    "target_scaler_scale": target_scaler.scale_,

                    "feature_scaler_mean": feature_scaler.mean_,
                    "feature_scaler_scale": feature_scaler.scale_,

                    "residual_std": residual_std,
                    "confidence_score": confidence_score,
                    "direction_accuracy": direction_accuracy,
                    "direction_precision": direction_precision,
                    "direction_recall": direction_recall,
                    "mean_trading_confidence": mean_trading_confidence,
                    "multi_step_validation_mae": multi_step_mae,

                    "dropout_rate": DROPOUT_RATE,
                    "multi_step_validation_steps": MULTI_STEP_VALIDATION_STEPS,

                    "return_loss_weight": RETURN_LOSS_WEIGHT,
                    "direction_loss_weight": DIRECTION_LOSS_WEIGHT,
                },
                MODEL_PATH
            )

            print("\nBest TCN Model Saved")

        else:
            patience_counter += 1

        if patience_counter >= PATIENCE:
            print("\nEarly Stopping Triggered")
            training_finished_normally = False
            break

    if training_finished_normally:
        print("\nTCN Training Complete.")

    # =====================================================
    # FINAL, ONE-TIME EVALUATION ON THE HELD-OUT TEST SET
    # Test data was never seen during training, validation-based
    # early stopping, or LR scheduling above.
    # =====================================================
    print("\n=========================================")
    print("FINAL TEST SET EVALUATION (held-out, unseen)")
    print("=========================================")

    if MODEL_PATH.exists():
        checkpoint = torch.load(
        MODEL_PATH,
        map_location=DEVICE,
        weights_only=False
)
        model.load_state_dict(checkpoint["model_state_dict"])
        print("Loaded best checkpoint (lowest validation loss) for test evaluation.")
    else:
        print("No checkpoint found -- evaluating current in-memory model weights.")

    test_result = run_evaluation(
        model,
        test_loader,
        target_scaler,
        huber_loss,
        direction_loss_fn,
        run_multi_step=False
    )

    print(f"Test Loss            : {test_result['avg_loss']:.6f}")
    print(f"Test Return MAE      : {test_result['mae']:.6f}")
    print(f"Test Return RMSE     : {test_result['rmse']:.6f}")
    print(f"Test Return R\u00b2       : {test_result['r2']:.6f}")
    print(f"Test Correlation     : {test_result['corr']:.6f}")
    print(f"Test Direction Acc.  : {test_result['direction_accuracy']:.4f}")
    print(f"Test Direction Prec. : {test_result['direction_precision']:.4f}")
    print(f"Test Direction Recall: {test_result['direction_recall']:.4f}")
    print("Test Confusion Matrix (rows=true, cols=pred, order=[SELL, HOLD, BUY]):")
    print(test_result["direction_confusion_matrix"])
    print(f"Test Mean Trading Confidence: {test_result['mean_trading_confidence']:.4f}")
    print("=========================================")

    return True


if __name__ == "__main__":
    options_path = (
        Path(__file__).resolve().parent.parent
        / "data"
        / "OptionalData"
        / "OptionsDataAllDteSPY.jsonlines"
    )

    train_model(
        symbol=DEFAULT_SYMBOL,
        indicators=DEFAULT_INDICATORS,
        data_source="local",
        data_path=str(options_path)
    )""""""





gru training.py""""""
import warnings
warnings.filterwarnings("ignore")

from pathlib import Path
import random
from ftplib import FTP
from io import BytesIO

import numpy as np
import pandas as pd

from sklearn.preprocessing import StandardScaler
from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score,
    accuracy_score,
    precision_score,
    recall_score,
    confusion_matrix,
)

import torch
import torch.nn as nn
from torch.utils.data import Dataset, DataLoader


# =========================================================
# REPRODUCIBILITY
# =========================================================

SEED = 42
random.seed(SEED)
np.random.seed(SEED)
torch.manual_seed(SEED)

DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"\nUsing Device: {DEVICE}")


# =========================================================
# FTP CONFIG
# =========================================================

FTP_HOST = "ftp.cavedspace.com"
FTP_USER = "ftpuser"
FTP_PASS = "TestUser01!!"
FTP_ROOT = "/Backup"

DEFAULT_SYMBOL = "SPY"


# =========================================================
# TRAINING CONFIG
# =========================================================

SEQUENCE_LENGTH = 60
BATCH_SIZE = 128
EPOCHS = 50
LEARNING_RATE = 0.0001
WEIGHT_DECAY = 1e-6
PATIENCE = 10
DROPOUT_RATE = 0.2

RSI_PERIOD = 14
ATR_PERIOD = 14
MACD_FAST = 12
MACD_SLOW = 26
MACD_SIGNAL = 9

# GRU architecture config (pipeline: 60 candles -> GRU -> % return + direction)
GRU_HIDDEN_SIZE = 128
GRU_NUM_LAYERS = 2

MULTI_STEP_VALIDATION_STEPS = 10
FORECAST_STEPS = MULTI_STEP_VALIDATION_STEPS

DEFAULT_INDICATORS = [
    "EMA9",
    "EMA20",
    "EMA50",
    "VWAP",
    "RSI14",
    "ATR14",
    "MACD",
]

BASE_FEATURES = [
    "high",
    "low",
    "close",
    "volume",
    "open",
]

# Fixed positions of close/open within BASE_FEATURES -- used both here
# and by the predictor to unscale/rescale price when converting a
# predicted % return back into a price, and back into a synthetic bar.
CLOSE_FEATURE_INDEX = 2
OPEN_FEATURE_INDEX = 4

INDICATOR_COLUMN_MAP = {
    "EMA9":  ["ema9"],
    "EMA20": ["ema20"],
    "EMA50": ["ema50"],
    "VWAP":  ["vwap"],
    "RSI14": ["rsi14"],
    "ATR14": ["atr14"],
    "MACD":  ["macd_line", "macd_signal", "macd_hist"],
}

# ---------------------------------------------------------
# TARGETS
#
# Two targets are produced from the same underlying quantity:
#
#   1) target_next_return (regression)
#        (next_open - current_close) / current_close
#        Kept centered near zero and scale-independent from the
#        instrument's price level -- important for the recursive
#        multi-step forecaster below.
#
#   2) target_direction (classification)
#        A discretized BUY/HOLD/SELL label derived from
#        target_next_return using DIRECTION_THRESHOLD:
#            SELL = 0   (return < -DIRECTION_THRESHOLD)
#            HOLD = 1   (|return| <= DIRECTION_THRESHOLD)
#            BUY  = 2   (return >  DIRECTION_THRESHOLD)
#
# The regression target continues to be StandardScaler-transformed
# via target_scaler. The direction target is NEVER scaled -- it stays
# an integer class label so it can be fed directly into
# CrossEntropyLoss.
# ---------------------------------------------------------
RETURN_TARGET_COLUMN = "target_next_return"
DIRECTION_TARGET_COLUMN = "target_direction"

DIRECTION_THRESHOLD = 0.0015

# SELL = 0, HOLD = 1, BUY = 2
DIRECTION_LABELS = {0: "SELL", 1: "HOLD", 2: "BUY"}

# Minimum softmax probability required before a raw BUY/SELL signal is
# trusted -- anything under this confidence is reported as HOLD.
MIN_SIGNAL_CONFIDENCE = 0.70

TARGET_COLUMNS = [
    RETURN_TARGET_COLUMN,
    DIRECTION_TARGET_COLUMN,
]
TARGET_TYPE = "return"   # decoded by the predictor: price = close * (1 + return)

feature_scaler = StandardScaler()
target_scaler = StandardScaler()   # fit ONLY on target_next_return (the direction
                                    # target is never passed through this scaler)


# =========================================================
# INDICATOR NAME NORMALIZATION
# =========================================================

def normalize_indicator_name(name):
    cleaned = str(name).strip().upper()
    cleaned = cleaned.replace("_", " ").replace("-", " ")
    cleaned = " ".join(cleaned.split())
    no_space = cleaned.replace(" ", "")

    for canonical in INDICATOR_COLUMN_MAP.keys():
        if canonical.upper().replace(" ", "") == no_space:
            return canonical

    raise ValueError(
        f"Unknown indicator '{name}'. This pipeline only supports: "
        f"{list(INDICATOR_COLUMN_MAP.keys())}"
    )


def normalize_indicator_list(indicators):
    normalized = []
    for raw_name in indicators:
        canonical = normalize_indicator_name(raw_name)
        if canonical not in normalized:
            normalized.append(canonical)
    return normalized


# =========================================================
# INDICATORS (unchanged from prior pipeline)
# =========================================================

def compute_rsi(close, period=RSI_PERIOD):
    delta = close.diff()

    gain = delta.clip(lower=0)
    loss = -delta.clip(upper=0)

    avg_gain = gain.ewm(alpha=1 / period, min_periods=period, adjust=False).mean()
    avg_loss = loss.ewm(alpha=1 / period, min_periods=period, adjust=False).mean()

    rs = avg_gain / avg_loss.replace(0, np.nan)

    return 100 - (100 / (1 + rs))


def compute_atr(dataframe, period=ATR_PERIOD):
    high_low = dataframe["high"] - dataframe["low"]
    high_close = (dataframe["high"] - dataframe["close"].shift()).abs()
    low_close = (dataframe["low"] - dataframe["close"].shift()).abs()

    true_range = pd.concat([high_low, high_close, low_close], axis=1).max(axis=1)

    return true_range.ewm(alpha=1 / period, adjust=False).mean()


def compute_vwap(dataframe):
    typical_price = (dataframe["high"] + dataframe["low"] + dataframe["close"]) / 3
    cumulative_pv = (typical_price * dataframe["volume"]).cumsum()
    cumulative_volume = dataframe["volume"].cumsum().replace(0, np.nan)

    return cumulative_pv / cumulative_volume


def compute_macd(dataframe, fast=MACD_FAST, slow=MACD_SLOW, signal=MACD_SIGNAL):
    ema_fast = dataframe["close"].ewm(span=fast, adjust=False).mean()
    ema_slow = dataframe["close"].ewm(span=slow, adjust=False).mean()
    macd_line = ema_fast - ema_slow
    signal_line = macd_line.ewm(span=signal, adjust=False).mean()

    return pd.DataFrame({
        "macd_line":   macd_line,
        "macd_signal": signal_line,
        "macd_hist":   macd_line - signal_line,
    })


INDICATOR_REGISTRY = {
    "EMA9":  lambda df: df["close"].ewm(span=9, adjust=False).mean(),
    "EMA20": lambda df: df["close"].ewm(span=20, adjust=False).mean(),
    "EMA50": lambda df: df["close"].ewm(span=50, adjust=False).mean(),
    "VWAP":  lambda df: compute_vwap(df),
    "RSI14": lambda df: compute_rsi(df["close"], period=RSI_PERIOD),
    "ATR14": lambda df: compute_atr(df, period=ATR_PERIOD),
    "MACD":  lambda df: compute_macd(df, fast=MACD_FAST, slow=MACD_SLOW, signal=MACD_SIGNAL),
}


def add_indicators(dataframe, indicators):
    dataframe = dataframe.copy()

    for name in indicators:
        if name not in INDICATOR_REGISTRY:
            raise ValueError(f"Unknown indicator: {name}")

        result = INDICATOR_REGISTRY[name](dataframe)

        if isinstance(result, pd.DataFrame):
            for col in result.columns:
                dataframe[col] = result[col]
        else:
            dataframe[INDICATOR_COLUMN_MAP[name][0]] = result

    return dataframe


def resolve_indicator_columns(indicators):
    columns = []
    for name in indicators:
        columns.extend(INDICATOR_COLUMN_MAP[name])
    return columns


def resolve_feature_columns(indicators):
    """
    FINAL_FEATURES = BASE_FEATURES + Selected_Indicator_Columns

    NOTE: this does NOT include options columns. Options columns are
    data-dependent (they come from whatever expiry1_/expiry2_/expiry3_
    columns are actually present in the loaded dataframe), so they are
    resolved separately by resolve_options_columns() and appended on
    top of this list inside prepare_training_data().
    """
    return list(BASE_FEATURES) + resolve_indicator_columns(indicators)


def resolve_options_columns(dataframe):
    """
    Returns every numeric column in `dataframe` whose name starts with
    expiry1_, expiry2_, expiry3_ -- grouped in that order (all
    expiry1_* columns first, then expiry2_*, then expiry3_*), with
    each group's original column order preserved.

    This keeps the final feature order exactly:
        BASE_FEATURES + indicator_columns + expiry1_* + expiry2_* + expiry3_*
    as required, and never invents or predicts options values -- it
    only reads columns that are already present in the source data.
    """
    prefixes = ("expiry1_", "expiry2_", "expiry3_")
    options_columns = []

    for prefix in prefixes:
        group = [
            column for column in dataframe.columns
            if column.startswith(prefix)
            and pd.api.types.is_numeric_dtype(dataframe[column])
        ]
        options_columns.extend(group)

    return options_columns


# =========================================================
# PREDICTION TARGETS -- % return, plus a discretized BUY/HOLD/SELL
# direction label derived from that same % return.
# =========================================================

def add_targets(dataframe):
    """
    target_next_return = (next_open - current_close) / current_close

    This is the % move from "where we are now" (this bar's close) to
    "where the next bar opens" -- the quantity the GRU's return head
    is trained to predict. Converting back to price at inference time
    is just:
        predicted_price = current_close * (1 + predicted_return)

    target_direction is derived from target_next_return using
    DIRECTION_THRESHOLD:
        SELL = 0   if target_next_return < -DIRECTION_THRESHOLD
        BUY  = 2   if target_next_return >  DIRECTION_THRESHOLD
        HOLD = 1   otherwise

    Rows where target_next_return is NaN (the final row, from the
    shift(-1)) default to HOLD here and are subsequently dropped by
    the dropna() step in prepare_training_data(), so they never reach
    training.
    """
    dataframe = dataframe.copy()

    next_open = dataframe["open"].shift(-1)
    dataframe["target_next_return"] = (next_open - dataframe["close"]) / dataframe["close"]

    dataframe["target_direction"] = 1
    dataframe.loc[dataframe["target_next_return"] > DIRECTION_THRESHOLD, "target_direction"] = 2
    dataframe.loc[dataframe["target_next_return"] < -DIRECTION_THRESHOLD, "target_direction"] = 0
    dataframe["target_direction"] = dataframe["target_direction"].astype(np.int64)

    return dataframe


# =========================================================
# FTP DATA LOADING (unchanged)
# =========================================================

def get_file_name(symbol):
    return f"OHLCV{symbol}.txt"


def connect_ftp():
    ftp = FTP(FTP_HOST, timeout=60)
    ftp.login(user=FTP_USER, passwd=FTP_PASS)
    ftp.set_pasv(True)
    return ftp


def load_symbol_data(symbol, data_source="ftp", data_path=""):
    if data_source == "local":
        print(f"Training on local options data: {data_path}")
        import sys
        sys.path.append(str(Path(__file__).resolve().parent.parent))
        from data.options_loader import load_local_options
        df = load_local_options(data_path)
        return df

    first_ftp = connect_ftp()
    first_ftp.cwd(FTP_ROOT)

    folders = first_ftp.nlst()

    try:
        first_ftp.quit()
    except:
        first_ftp.close()

    date_folders = sorted([f for f in folders if f.startswith("202")])
    usable_folders = date_folders[:-1]
    all_dataframes = []

    for folder in usable_folders:
        ftp = None

        try:
            print(f"\nLoading {folder}")

            ftp = connect_ftp()

            folder_path = f"{FTP_ROOT}/{folder}/{symbol}"
            file_name = get_file_name(symbol)
            file_path = f"{folder_path}/{file_name}"

            buffer = BytesIO()
            ftp.retrbinary(f"RETR {file_path}", buffer.write)
            buffer.seek(0)

            dataframe = pd.read_csv(buffer)
            all_dataframes.append(dataframe)

            print("Loaded Successfully")

        except Exception as error:
            print(f"Skipping {folder}: {error}")

        finally:
            if ftp is not None:
                try:
                    ftp.quit()
                except:
                    try:
                        ftp.close()
                    except:
                        pass

    if not all_dataframes:
        raise RuntimeError(f"No data found for symbol {symbol}")

    return pd.concat(all_dataframes, ignore_index=True)


# =========================================================
# SEQUENCE CREATION (unchanged mechanics -- targets now include both
# the return column and the direction column, in that order)
# =========================================================

def create_sequences(dataframe, features, targets=TARGET_COLUMNS):
    feature_array = dataframe[features].to_numpy(dtype=np.float32)
    target_array = dataframe[targets].to_numpy(dtype=np.float32)

    X = []
    y = []

    for index in range(SEQUENCE_LENGTH, len(dataframe)):
        X.append(feature_array[index - SEQUENCE_LENGTH:index])
        y.append(target_array[index - 1])

    return (
        np.array(X, dtype=np.float32),
        np.array(y, dtype=np.float32)
    )


class MarketDataset(Dataset):

    def __init__(self, X, y):
        self.X = torch.tensor(X, dtype=torch.float32)
        self.y = torch.tensor(y, dtype=torch.float32)

    def __len__(self):
        return len(self.X)

    def __getitem__(self, index):
        return self.X[index], self.y[index]


# =========================================================
# TRAINING CONFIGURATION BANNER
# =========================================================

def print_training_summary(
    symbol,
    indicators,
    indicator_columns,
    features,
    data_source="ftp",
    options_columns=None
):
    options_columns = options_columns or []

    print("=========================================")
    print("Training Configuration")
    print("=========================================")

    print("Base Features:")
    print(BASE_FEATURES)

    print("\nSelected Training Indicators:")
    print(indicators if indicators else [])

    print("\nGenerated Indicator Columns:")
    print(indicator_columns if indicator_columns else [])

    if data_source == "local":
        print("\nData Source:")
        print("Local Combined OHLCV + Options")

    # ---- Explicit feature-count breakdown. Counts are always the
    # REAL counts actually found/used (never hardcoded to 5/9/102/116),
    # so this stays correct regardless of which indicators are
    # selected or how many options columns the source data contains. ----
    print("\nOHLCV Feature Count:")
    print(len(BASE_FEATURES))

    print("\nIndicator Feature Count:")
    print(len(indicator_columns) if indicator_columns else 0)

    print("\nOptions Feature Count:")
    print(len(options_columns))

    print("\nTotal Model Feature Count:")
    print(len(features))

    print("\nFinal Training Features:")
    print(features)

    print("\nTotal Features:")
    print(len(features))

    print("\nTargets:")
    print(f"Return Target    : {RETURN_TARGET_COLUMN} (type={TARGET_TYPE}, scaled=True)")
    print(f"Direction Target : {DIRECTION_TARGET_COLUMN} "
          f"(threshold={DIRECTION_THRESHOLD}, scaled=False, labels={DIRECTION_LABELS})")

    print("\nSequence Length:")
    print(SEQUENCE_LENGTH)

    print("\nForecast Steps:")
    print(FORECAST_STEPS)

    print("=========================================")
    print(f"Model  : GRU (dual-head: return + direction)")
    print(f"Symbol : {symbol}")
    print("=========================================")
    print("Training Started...")
    print("=========================================\n")


# =========================================================
# PREPARE TRAINING DATA
# =========================================================

def prepare_training_data(symbol, indicators, data_source="ftp", data_path=""):
    dataframe = load_symbol_data(symbol, data_source, data_path)

    print(f"\nMerged Shape: {dataframe.shape}")

    dataframe.columns = [c.lower().strip() for c in dataframe.columns]

    try:
        dataframe["datetime"] = pd.to_datetime(dataframe["datetime"], unit="ms")
    except:
        dataframe["datetime"] = pd.to_datetime(dataframe["datetime"])

    dataframe = dataframe.sort_values("datetime")
    dataframe.reset_index(drop=True, inplace=True)

    dataframe = add_indicators(dataframe, indicators)
    indicator_columns = resolve_indicator_columns(indicators)

    # ---- Options features: read-only, never predicted/invented.
    # Only expected (and required) for local combined OHLCV + options
    # training; for FTP OHLCV-only training this will naturally be
    # an empty list since no expiry1_/expiry2_/expiry3_ columns exist. ----
    options_columns = resolve_options_columns(dataframe)

    # Final feature order: BASE_FEATURES, then indicator columns, then
    # expiry1_* / expiry2_* / expiry3_* columns (never reordered).
    features = resolve_feature_columns(indicators) + options_columns

    if data_source == "local":
        if len(options_columns) == 0:
            raise RuntimeError(
                "Local combined training requested, but no expiry1_/expiry2_/expiry3_ "
                "options features were found."
            )

        if len(options_columns) != 102:
            raise RuntimeError(
                f"Expected 102 options features, found {len(options_columns)}"
            )

        if len(features) != 116:
            raise RuntimeError(
                f"Expected 116 total model features, found {len(features)}"
            )

    dataframe = add_targets(dataframe)

    dataframe.dropna(inplace=True)
    dataframe.reset_index(drop=True, inplace=True)

    print("\n========== DATASET DIAGNOSTICS ==========")
    print("Rows after dropna:", len(dataframe))
    print("Total features:", len(features))
    print("Options features:", len(options_columns))
    print("\nTarget Statistics (target_next_return):")
    print(dataframe["target_next_return"].describe())
    print("\nDirection Label Distribution (target_direction):")
    print(
        dataframe["target_direction"]
        .map(DIRECTION_LABELS)
        .value_counts()
    )
    print("\nOptions Feature Variation:")
    constant_options = [
        col for col in options_columns
        if dataframe[col].nunique() <= 1
    ]
    print("Constant options columns:", len(constant_options))
    if constant_options:
        print("Constant columns:")
        print(constant_options)
    print("\nOptions NaN count:")
    print(dataframe[options_columns].isna().sum().sum())
    print("==========================================")

    split_index = int(len(dataframe) * 0.80)

    train_dataframe = dataframe.iloc[:split_index].copy()
    test_dataframe = dataframe.iloc[split_index:].copy()

    train_dataframe[features] = feature_scaler.fit_transform(train_dataframe[features])
    test_dataframe[features] = feature_scaler.transform(test_dataframe[features])

    # ---- Only the return target is ever passed through target_scaler.
    # target_direction stays as an untouched integer class label. ----
    train_dataframe[[RETURN_TARGET_COLUMN]] = target_scaler.fit_transform(
        train_dataframe[[RETURN_TARGET_COLUMN]]
    )
    test_dataframe[[RETURN_TARGET_COLUMN]] = target_scaler.transform(
        test_dataframe[[RETURN_TARGET_COLUMN]]
    )

    X_train, y_train = create_sequences(train_dataframe, features)
    X_test, y_test = create_sequences(test_dataframe, features)

    if len(X_train) == 0:
        raise RuntimeError("Training dataset is empty")

    if len(X_test) == 0:
        raise RuntimeError("Validation dataset is empty")

    print(f"\nTrain Shape: {X_train.shape}")
    print(f"Test Shape : {X_test.shape}")

    train_dataset = MarketDataset(X_train, y_train)
    test_dataset = MarketDataset(X_test, y_test)

    train_loader = DataLoader(train_dataset, batch_size=BATCH_SIZE, shuffle=True, drop_last=True)
    test_loader = DataLoader(test_dataset, batch_size=BATCH_SIZE, shuffle=False)

    return (
        train_loader,
        test_loader,
        feature_scaler,
        target_scaler,
        features,
        indicator_columns,
        options_columns
    )


# =========================================================
# GRU MODEL
#
# Pipeline: 60 candles -> GRU -> shared dense layer -> two heads:
#   - return_head:    1 value  (scaled % return of next-bar open
#                      relative to current close)
#   - direction_head: 3 logits (SELL / HOLD / BUY)
#
# n_features scales with however many indicators are selected (5 base
# OHLCV + whichever indicator columns are on = 14 with the full
# DEFAULT_INDICATORS set, since MACD alone expands to 3 columns),
# plus any expiry1_/expiry2_/expiry3_ options columns found in the
# source data when training on local combined OHLCV + options data
# (14 + 102 = 116). The GRU backbone itself (60-step sequence length,
# hidden size 128, 2 layers, dropout 0.2, single dense layer) is
# unchanged from the original single-head regressor -- only the final
# output layer is split into the two heads above.
# =========================================================

class GRURegressor(nn.Module):

    def __init__(self, n_features, hidden_size=GRU_HIDDEN_SIZE, num_layers=GRU_NUM_LAYERS):
        super().__init__()

        self.gru = nn.GRU(
            input_size=n_features,
            hidden_size=hidden_size,
            num_layers=num_layers,
            batch_first=True,
            dropout=DROPOUT_RATE if num_layers > 1 else 0.0,
        )

        self.dropout = nn.Dropout(DROPOUT_RATE)
        self.fc1 = nn.Linear(hidden_size, 64)
        self.gelu = nn.GELU()

        # Dual heads, both fed from the same 64-unit dense layer.
        self.return_head = nn.Linear(64, 1)
        self.direction_head = nn.Linear(64, 3)

    def forward(self, x):
        output, _ = self.gru(x)

        # Last timestep's hidden state summarizes the full 60-candle window.
        output = output[:, -1, :]

        output = self.dropout(output)
        output = self.fc1(output)
        output = self.gelu(output)

        predicted_return = self.return_head(output)      # shape: (batch, 1)
        direction_logits = self.direction_head(output)   # shape: (batch, 3)

        return predicted_return, direction_logits


# =========================================================
# PREDICTION DECODING -- turns raw model outputs into the standard
# BUY/HOLD/SELL signal payload, applying the confidence floor.
# =========================================================

def decode_prediction(predicted_return, direction_logits, target_scaler):
    """
    predicted_return : tensor/array of shape (1, 1) -- scaled return
                        output from GRURegressor's return_head.
    direction_logits : tensor/array of shape (1, 3) -- raw logits
                        from GRURegressor's direction_head.
    target_scaler     : the StandardScaler fit on target_next_return.

    Returns:
        {
            "signal": "BUY" | "HOLD" | "SELL",
            "confidence": float,
            "probabilities": {"SELL": .., "HOLD": .., "BUY": ..},
            "predicted_return": float
        }

    The raw argmax class is only used as the signal when its softmax
    probability is >= MIN_SIGNAL_CONFIDENCE; otherwise the signal is
    forced to HOLD.
    """
    if isinstance(direction_logits, torch.Tensor):
        direction_logits_tensor = direction_logits.detach().cpu()
    else:
        direction_logits_tensor = torch.tensor(direction_logits, dtype=torch.float32)

    probabilities = torch.softmax(direction_logits_tensor, dim=-1).numpy().reshape(-1)

    predicted_class = int(np.argmax(probabilities))
    confidence = float(probabilities[predicted_class])

    raw_signal = DIRECTION_LABELS[predicted_class]
    signal = raw_signal if confidence >= MIN_SIGNAL_CONFIDENCE else "HOLD"

    if isinstance(predicted_return, torch.Tensor):
        scaled_return = predicted_return.detach().cpu().numpy().reshape(-1)[0]
    else:
        scaled_return = np.asarray(predicted_return).reshape(-1)[0]

    real_return = (scaled_return * target_scaler.scale_[0]) + target_scaler.mean_[0]

    return {
        "signal": signal,
        "confidence": round(confidence, 4),
        "probabilities": {
            "SELL": round(float(probabilities[0]), 4),
            "HOLD": round(float(probabilities[1]), 4),
            "BUY": round(float(probabilities[2]), 4),
        },
        "predicted_return": round(float(real_return), 6),
    }


# =========================================================
# METRICS
# =========================================================

train_losses = []
val_losses = []
mae_list = []
rmse_list = []
r2_list = []
corr_list = []
confidence_score_list = []
multi_step_mae_list = []

direction_accuracy_list = []
buy_precision_list = []
sell_precision_list = []
hold_precision_list = []
buy_recall_list = []
sell_recall_list = []
hold_recall_list = []
confusion_matrix_list = []


def calculate_confidence_score(residual_std, target_mean):
    if target_mean == 0:
        return 0.0

    confidence = 100 - (residual_std / abs(target_mean)) * 100
    confidence = max(0, min(100, confidence))

    return float(confidence)


def multi_step_validation(
    model,
    X_raw,
    y_raw,
    feature_scaler,
    target_scaler,
    steps=MULTI_STEP_VALIDATION_STEPS,
    options_columns=None
):
    """
    Rolls the model forward `steps` bars. Unlike the old price-target
    version, the model's return head output here is a % RETURN, not a
    price -- so each step has to:
      1. Decode the scaled return prediction -> real return
      2. Unscale the current window's last real close
      3. predicted_price = real_close * (1 + real_return)
      4. Rescale predicted_price back into feature space to write into
         the rolled-forward window's open/close columns

    Only the return head is used for this recursive rollout; the
    direction head has nothing to contribute here since there's no
    "future direction" feature to roll forward.

    IMPORTANT: this recursive rollout only ever overwrites the
    open/close slots of BASE_FEATURES. It has no way to produce future
    expiry1_/expiry2_/expiry3_ options values -- doing so would mean
    inventing fake future options-chain data. So whenever options
    features are part of the input (options_columns is non-empty),
    this function is skipped entirely and reports np.nan instead of
    silently reusing stale, copied-forward options values across the
    recursive horizon.
    """
    if options_columns:
        print(
            "Multi-step recursive validation skipped because future "
            "options features are unavailable."
        )
        return float(np.nan)

    model.eval()

    predictions = []
    targets = []

    sample_count = min(len(X_raw) - steps, 300)

    if sample_count <= 0:
        return 0.0

    return_mean = target_scaler.mean_[0]
    return_scale = target_scaler.scale_[0]

    close_mean = feature_scaler.mean_[CLOSE_FEATURE_INDEX]
    close_scale = feature_scaler.scale_[CLOSE_FEATURE_INDEX]

    open_mean = feature_scaler.mean_[OPEN_FEATURE_INDEX]
    open_scale = feature_scaler.scale_[OPEN_FEATURE_INDEX]

    with torch.no_grad():
        for i in range(sample_count):
            current_sequence = X_raw[i].copy()

            step_predictions = []

            for step in range(steps):
                seq_tensor = (
                    torch.tensor(current_sequence, dtype=torch.float32)
                    .unsqueeze(0)
                    .to(DEVICE)
                )

                predicted_return_tensor, _ = model(seq_tensor)
                pred_return_scaled = predicted_return_tensor.cpu().numpy()[0][0]

                step_predictions.append(pred_return_scaled)

                # ---- decode: scaled return -> real return -> real price ----
                real_return = (pred_return_scaled * return_scale) + return_mean

                last_close_scaled = current_sequence[-1][CLOSE_FEATURE_INDEX]
                real_close = (last_close_scaled * close_scale) + close_mean

                real_predicted_price = real_close * (1 + real_return)

                # ---- re-encode predicted price for open/close columns ----
                pred_open_scaled = (real_predicted_price - open_mean) / open_scale
                pred_close_scaled = (real_predicted_price - close_mean) / close_scale

                next_sequence = current_sequence.copy()
                next_sequence[:-1] = next_sequence[1:]

                next_sequence[-1] = next_sequence[-2]
                next_sequence[-1][OPEN_FEATURE_INDEX] = pred_open_scaled
                next_sequence[-1][CLOSE_FEATURE_INDEX] = pred_close_scaled

                current_sequence = next_sequence

            predictions.extend(step_predictions)
            targets.extend(y_raw[i:i + steps, 0])

    predictions = np.array(predictions)
    targets = np.array(targets)

    # Compare in RETURN space -- this metric measures return-prediction
    # accuracy, matching what the return head actually optimizes.
    predictions_real = (predictions * return_scale) + return_mean
    targets_real = (targets * return_scale) + return_mean

    multi_mae = mean_absolute_error(targets_real, predictions_real)

    return float(multi_mae)


# =========================================================
# TRAINING FUNCTION
# =========================================================

def train_model(
    symbol=DEFAULT_SYMBOL,
    indicators=None,
    progress_callback=None,
    stop_callback=None,
    data_source="ftp",
    data_path=""
):
    if indicators is None:
        indicators = list(DEFAULT_INDICATORS)

    indicators = normalize_indicator_list(indicators)

    best_val_loss = np.inf
    patience_counter = 0

    train_losses.clear()
    val_losses.clear()
    mae_list.clear()
    rmse_list.clear()
    r2_list.clear()
    corr_list.clear()
    confidence_score_list.clear()
    multi_step_mae_list.clear()

    direction_accuracy_list.clear()
    buy_precision_list.clear()
    sell_precision_list.clear()
    hold_precision_list.clear()
    buy_recall_list.clear()
    sell_recall_list.clear()
    hold_recall_list.clear()
    confusion_matrix_list.clear()

    symbol = symbol.upper()

    MODEL_PATH = (
        Path(__file__).parent.parent
        / "models"
        / f"best_gru_{symbol.lower()}.pth"
    )

    MODEL_PATH.parent.mkdir(parents=True, exist_ok=True)

    (
        train_loader,
        test_loader,
        feature_scaler,
        target_scaler,
        features,
        indicator_columns,
        options_columns
    ) = prepare_training_data(symbol, indicators, data_source, data_path)

    options_present = len(options_columns) > 0

    print_training_summary(
        symbol,
        indicators,
        indicator_columns,
        features,
        data_source=data_source,
        options_columns=options_columns
    )

    return_loss_fn = nn.HuberLoss()
    direction_loss_fn = nn.CrossEntropyLoss()

    model = GRURegressor(n_features=len(features)).to(DEVICE)

    optimizer = torch.optim.AdamW(
        model.parameters(),
        lr=LEARNING_RATE,
        weight_decay=WEIGHT_DECAY
    )

    scheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(
        optimizer, mode="min", factor=0.5, patience=10
    )

    for epoch in range(EPOCHS):
        print(f"\nEpoch [{epoch + 1}/{EPOCHS}] Started...")

        model.train()
        running_train_loss = 0

        for X_batch, y_batch in train_loader:
            if stop_callback and stop_callback():
                print("\nTraining Stopped By User")
                return False

            X_batch = X_batch.to(DEVICE)
            y_batch = y_batch.to(DEVICE)

            y_return = y_batch[:, 0:1]
            y_direction = y_batch[:, 1].long()

            optimizer.zero_grad()

            predicted_return, direction_logits = model(X_batch)

            return_loss_value = return_loss_fn(predicted_return, y_return)
            direction_loss_value = direction_loss_fn(direction_logits, y_direction)
            loss = return_loss_value + direction_loss_value

            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            optimizer.step()

            running_train_loss += loss.item()

        avg_train_loss = running_train_loss / len(train_loader)
        train_losses.append(avg_train_loss)

        model.eval()

        running_val_loss = 0
        all_return_predictions = []
        all_return_targets = []
        all_direction_logits = []
        all_direction_targets = []
        X_validation_raw = []
        y_validation_raw = []

        with torch.no_grad():
            for X_batch, y_batch in test_loader:
                X_batch = X_batch.to(DEVICE)
                y_batch = y_batch.to(DEVICE)

                y_return = y_batch[:, 0:1]
                y_direction = y_batch[:, 1].long()

                predicted_return, direction_logits = model(X_batch)

                return_loss_value = return_loss_fn(predicted_return, y_return)
                direction_loss_value = direction_loss_fn(direction_logits, y_direction)
                loss = return_loss_value + direction_loss_value

                running_val_loss += loss.item()

                all_return_predictions.extend(predicted_return.cpu().numpy())
                all_return_targets.extend(y_return.cpu().numpy())
                all_direction_logits.extend(direction_logits.cpu().numpy())
                all_direction_targets.extend(y_direction.cpu().numpy())

                X_validation_raw.extend(X_batch.cpu().numpy())
                y_validation_raw.extend(y_batch.cpu().numpy())

        avg_val_loss = running_val_loss / len(test_loader)
        val_losses.append(avg_val_loss)

        scheduler.step(avg_val_loss)

        all_return_predictions = np.array(all_return_predictions)
        all_return_targets = np.array(all_return_targets)

        # ---- Unscale: RETURN space, not price ----
        return_pred_real = target_scaler.inverse_transform(all_return_predictions)[:, 0]
        return_true_real = target_scaler.inverse_transform(all_return_targets)[:, 0]

        prediction_std = np.std(return_pred_real)
        target_std = np.std(return_true_real)

        mae = mean_absolute_error(return_true_real, return_pred_real)
        rmse = np.sqrt(mean_squared_error(return_true_real, return_pred_real))
        r2 = r2_score(return_true_real, return_pred_real)
        corr = float(np.corrcoef(return_true_real, return_pred_real)[0, 1])

        residual_std = np.std(return_true_real - return_pred_real)

        confidence_score = calculate_confidence_score(
            residual_std, np.mean(return_true_real)
        )

        # ---- Direction classification metrics ----
        all_direction_logits = np.array(all_direction_logits)
        all_direction_targets = np.array(all_direction_targets)
        direction_pred_classes = np.argmax(all_direction_logits, axis=1)

        direction_accuracy = accuracy_score(all_direction_targets, direction_pred_classes)

        precision = precision_score(
            all_direction_targets, direction_pred_classes,
            labels=[0, 1, 2], average=None, zero_division=0
        )
        recall = recall_score(
            all_direction_targets, direction_pred_classes,
            labels=[0, 1, 2], average=None, zero_division=0
        )
        cm = confusion_matrix(
            all_direction_targets, direction_pred_classes, labels=[0, 1, 2]
        )

        sell_precision, hold_precision, buy_precision = precision[0], precision[1], precision[2]
        sell_recall, hold_recall, buy_recall = recall[0], recall[1], recall[2]

        # ---- One-step validation is always run, unchanged, above.
        # Multi-step (recursive) validation is skipped internally by
        # multi_step_validation() whenever options_columns is
        # non-empty, and returns np.nan in that case instead of
        # recursively fabricating future options features. ----
        multi_step_mae = multi_step_validation(
            model,
            np.array(X_validation_raw),
            np.array(y_validation_raw),
            feature_scaler,
            target_scaler,
            steps=MULTI_STEP_VALIDATION_STEPS,
            options_columns=options_columns
        )

        mae_list.append(mae)
        rmse_list.append(rmse)
        r2_list.append(r2)
        corr_list.append(corr)
        confidence_score_list.append(confidence_score)
        multi_step_mae_list.append(multi_step_mae)

        direction_accuracy_list.append(direction_accuracy)
        buy_precision_list.append(buy_precision)
        sell_precision_list.append(sell_precision)
        hold_precision_list.append(hold_precision)
        buy_recall_list.append(buy_recall)
        sell_recall_list.append(sell_recall)
        hold_recall_list.append(hold_recall)
        confusion_matrix_list.append(cm)

        print("\n========== RETURN DIAGNOSTICS (target_next_return) ==========")
        print("Prediction STD:", prediction_std)
        print("Target STD    :", target_std)
        print("Prediction Mean:", np.mean(return_pred_real))
        print("Target Mean    :", np.mean(return_true_real))
        print("Prediction Min :", np.min(return_pred_real))
        print("Prediction Max :", np.max(return_pred_real))
        print("Target Min     :", np.min(return_true_real))
        print("Target Max     :", np.max(return_true_real))
        print("======================================")

        print("\n========== DIRECTION DIAGNOSTICS (target_direction) ==========")
        print(f"Direction Accuracy  : {direction_accuracy:.4f}")
        print(f"BUY Precision       : {buy_precision:.4f}")
        print(f"SELL Precision      : {sell_precision:.4f}")
        print(f"HOLD Precision      : {hold_precision:.4f}")
        print(f"BUY Recall          : {buy_recall:.4f}")
        print(f"SELL Recall         : {sell_recall:.4f}")
        print(f"HOLD Recall         : {hold_recall:.4f}")
        print("Confusion Matrix (rows=true, cols=pred) [SELL, HOLD, BUY]:")
        print(cm)
        print("======================================")

        # ---- Safe formatting: multi_step_mae is np.nan whenever
        # options features are enabled, so it can't go through a
        # plain ":.6f}" format spec without raising. ----
        if np.isnan(multi_step_mae):
            multi_step_mae_display = "N/A (options features enabled)"
        else:
            multi_step_mae_display = f"{multi_step_mae:.6f}"

        print(f"Epoch [{epoch + 1}] Completed")
        print(f"Train Loss          : {avg_train_loss:.6f}")
        print(f"Val Loss            : {avg_val_loss:.6f}")
        print(f"MAE                 : {mae:.6f}")
        print(f"RMSE                : {rmse:.6f}")
        print(f"R\u00b2                  : {r2:.6f}")
        print(f"Correlation         : {corr:.6f}")
        print(f"Confidence Score    : {confidence_score:.2f}%")
        print(f"Multi-Step MAE      : {multi_step_mae_display}")
        print(f"Direction Accuracy  : {direction_accuracy:.4f}")
        print(f"BUY Precision       : {buy_precision:.4f}")
        print(f"SELL Precision      : {sell_precision:.4f}")
        print(f"HOLD Precision      : {hold_precision:.4f}")

        if progress_callback:
            progress_callback(epoch + 1, EPOCHS, avg_train_loss, avg_val_loss)

        if avg_val_loss < best_val_loss:
            best_val_loss = avg_val_loss
            patience_counter = 0

            torch.save(
                {
                    "model_state_dict": model.state_dict(),
                    "model_type": "GRU",
                    "features": features,
                    "indicators": indicators,
                    "indicator_columns": indicator_columns,
                    "sequence_length": SEQUENCE_LENGTH,
                    "forecast_steps": FORECAST_STEPS,

                    "target_columns": TARGET_COLUMNS,
                    "return_target_column": RETURN_TARGET_COLUMN,
                    "direction_target_column": DIRECTION_TARGET_COLUMN,
                    "direction_threshold": DIRECTION_THRESHOLD,
                    "direction_labels": DIRECTION_LABELS,
                    "min_signal_confidence": MIN_SIGNAL_CONFIDENCE,
                    "target_type": TARGET_TYPE,

                    "target_scaler_mean": target_scaler.mean_,
                    "target_scaler_scale": target_scaler.scale_,

                    "feature_scaler_mean": feature_scaler.mean_,
                    "feature_scaler_scale": feature_scaler.scale_,

                    "close_feature_index": CLOSE_FEATURE_INDEX,
                    "open_feature_index": OPEN_FEATURE_INDEX,

                    "residual_std": residual_std,
                    "confidence_score": confidence_score,
                    "multi_step_validation_mae": multi_step_mae,

                    "direction_accuracy": direction_accuracy,
                    "buy_precision": buy_precision,
                    "sell_precision": sell_precision,
                    "hold_precision": hold_precision,
                    "buy_recall": buy_recall,
                    "sell_recall": sell_recall,
                    "hold_recall": hold_recall,
                    "confusion_matrix": cm.tolist(),

                    "dropout_rate": DROPOUT_RATE,
                    "gru_hidden_size": GRU_HIDDEN_SIZE,
                    "gru_num_layers": GRU_NUM_LAYERS,
                    "multi_step_validation_steps": MULTI_STEP_VALIDATION_STEPS,

                    # ---- Options-feature metadata ----
                    "options_features_enabled": options_present,
                    "options_columns": options_columns,
                },
                MODEL_PATH
            )

            print("\nBest GRU Model Saved")

        else:
            patience_counter += 1

        if patience_counter >= PATIENCE:
            print("\nEarly Stopping Triggered")
            return True

    print("\nGRU Training Complete.")
    return True


if __name__ == "__main__":
    train_model(
        symbol=DEFAULT_SYMBOL,
        indicators=DEFAULT_INDICATORS,
        data_source="local",
        data_path="data/OptionsDataAllDteSPY.jsonlines"
    )""""""""

tcn predictor.py"""""""
import torch
import torch.nn as nn
import pandas as pd
import numpy as np
from pathlib import Path
from sklearn.preprocessing import StandardScaler

DEVICE = torch.device(
    "cuda"
    if torch.cuda.is_available()
    else "cpu"
)

DROPOUT_RATE = 0.2

RSI_PERIOD = 14
ATR_PERIOD = 14
MACD_FAST = 12
MACD_SLOW = 26
MACD_SIGNAL = 9

# Must match TCN_Training.py's BASE_FEATURES exactly (same order) --
# the scaler and saved "features" list depend on this ordering.
BASE_FEATURES = ["high", "low", "close", "volume", "open"]

INDICATOR_COLUMN_MAP = {
    "EMA9":  ["ema9"],
    "EMA20": ["ema20"],
    "EMA50": ["ema50"],
    "VWAP":  ["vwap"],
    "RSI14": ["rsi14"],
    "ATR14": ["atr14"],
    "MACD":  ["macd_line", "macd_signal", "macd_hist"],
}


# =============================================================
# INDICATOR NAME NORMALIZATION
# =============================================================

def _normalize_key(name: str) -> str:
    return "".join(ch for ch in str(name).strip().lower() if ch.isalnum())


def _build_alias_table(canonical_names) -> dict:
    return {_normalize_key(name): name for name in canonical_names}


INDICATOR_ALIASES = _build_alias_table(INDICATOR_COLUMN_MAP.keys())


def normalize_indicators(indicators: list) -> list:
    resolved = []
    for raw_name in indicators:
        key = _normalize_key(raw_name)
        if key not in INDICATOR_ALIASES:
            raise ValueError(
                f"Unknown indicator: {raw_name!r}. This pipeline only "
                f"supports: {list(INDICATOR_COLUMN_MAP.keys())}"
            )
        resolved.append(INDICATOR_ALIASES[key])
    return resolved


# ---------------------------------------------------------------
# TARGETS
#
# TCN_Training.py's TCNDualHead predicts:
#   target_next_return = (next_open - close) / close   (regression head)
#   target_direction    = SELL(0) / HOLD(1) / BUY(2)    (classification head)
#
# These defaults are only used as a fallback when an older checkpoint
# doesn't carry the corresponding metadata -- the checkpoint's own
# values are always preferred (see TCNPredictor.__init__).
# ---------------------------------------------------------------

DEFAULT_TARGET_COLUMNS = [
    "target_next_return",
    "target_direction",
]

DEFAULT_DIRECTION_LABELS = {
    0: "SELL",
    1: "HOLD",
    2: "BUY",
}

DEFAULT_DIRECTION_THRESHOLD = 0.0015
DEFAULT_MIN_SIGNAL_CONFIDENCE = 0.70
MIN_PROBABILITY_MARGIN = 0.10

# Caps how far a single recursive step can move away from the previous
# predicted (or last real) price, expressed as a multiple of recent ATR.
MAX_STEP_MOVE_ATR_MULTIPLE = 1.5


# =========================================================
# INDICATOR FORMULAS -- must match TCN_Training.py EXACTLY
# =========================================================

def compute_rsi(close, period=RSI_PERIOD):
    delta = close.diff()

    gain = delta.clip(lower=0)
    loss = -delta.clip(upper=0)

    avg_gain = gain.ewm(alpha=1 / period, min_periods=period, adjust=False).mean()
    avg_loss = loss.ewm(alpha=1 / period, min_periods=period, adjust=False).mean()

    rs = avg_gain / avg_loss.replace(0, np.nan)

    return 100 - (100 / (1 + rs)), avg_gain, avg_loss


def compute_rsi_series(close, period=RSI_PERIOD):
    """Wrapper matching training's public signature (RSI series only)."""
    rsi, _, _ = compute_rsi(close, period)
    return rsi


def compute_atr(df, period=ATR_PERIOD):
    high_low = df["high"] - df["low"]
    high_close = (df["high"] - df["close"].shift()).abs()
    low_close = (df["low"] - df["close"].shift()).abs()

    true_range = pd.concat([high_low, high_close, low_close], axis=1).max(axis=1)

    return true_range.ewm(alpha=1 / period, adjust=False).mean()


def compute_vwap(df):
    typical_price = (df["high"] + df["low"] + df["close"]) / 3
    cumulative_pv = (typical_price * df["volume"]).cumsum()
    cumulative_volume = df["volume"].cumsum().replace(0, np.nan)

    return cumulative_pv / cumulative_volume


def compute_macd(df, fast=MACD_FAST, slow=MACD_SLOW, signal=MACD_SIGNAL):
    ema_fast = df["close"].ewm(span=fast, adjust=False).mean()
    ema_slow = df["close"].ewm(span=slow, adjust=False).mean()
    macd_line = ema_fast - ema_slow
    signal_line = macd_line.ewm(span=signal, adjust=False).mean()

    return pd.DataFrame({
        "macd_line":   macd_line,
        "macd_signal": signal_line,
        "macd_hist":   macd_line - signal_line,
    }), ema_fast, ema_slow


def add_missing_features(df, indicators):
    df = df.copy()

    for name in indicators:
        cols = INDICATOR_COLUMN_MAP[name]

        if all(c in df.columns for c in cols):
            continue

        if name == "EMA9":
            df["ema9"] = df["close"].ewm(span=9, adjust=False).mean()
        elif name == "EMA20":
            df["ema20"] = df["close"].ewm(span=20, adjust=False).mean()
        elif name == "EMA50":
            df["ema50"] = df["close"].ewm(span=50, adjust=False).mean()
        elif name == "VWAP":
            df["vwap"] = compute_vwap(df)
        elif name == "RSI14":
            df["rsi14"] = compute_rsi_series(df["close"], period=RSI_PERIOD)
        elif name == "ATR14":
            df["atr14"] = compute_atr(df, period=ATR_PERIOD)
        elif name == "MACD":
            macd_df, _, _ = compute_macd(df, fast=MACD_FAST, slow=MACD_SLOW, signal=MACD_SIGNAL)
            for col in macd_df.columns:
                df[col] = macd_df[col]
        else:
            raise ValueError(f"Unknown indicator: {name}")

    all_cols = []
    for name in indicators:
        all_cols.extend(INDICATOR_COLUMN_MAP[name])

    existing_cols = [c for c in all_cols if c in df.columns]
    if existing_cols:
        df[existing_cols] = df[existing_cols].bfill()

    return df


def resolve_feature_columns(indicators):
    """
    Fallback only -- used if an old checkpoint has no "features" list
    saved. The checkpoint's own "features" is always authoritative
    when present (see TCNPredictor.__init__), since it also carries
    the 102 options columns which cannot be reconstructed here.
    """
    columns = list(BASE_FEATURES)
    for name in indicators:
        columns.extend(INDICATOR_COLUMN_MAP[name])
    return columns


# =========================================================
# TCN MODEL -- architecture must match TCN_Training.py exactly
# =========================================================

class TemporalBlock(nn.Module):

    def __init__(self, in_channels, out_channels, dilation):
        super().__init__()

        kernel_size = 5
        padding = (kernel_size - 1) * dilation

        self.conv1 = nn.Conv1d(in_channels, out_channels, kernel_size=kernel_size,
                                padding=padding, dilation=dilation)
        self.conv2 = nn.Conv1d(out_channels, out_channels, kernel_size=kernel_size,
                                padding=padding, dilation=dilation)

        self.gelu = nn.GELU()
        self.dropout = nn.Dropout(DROPOUT_RATE)

        self.downsample = (
            nn.Conv1d(in_channels, out_channels, kernel_size=1)
            if in_channels != out_channels else None
        )

    def forward(self, x):
        output = self.conv1(x)
        output = output[:, :, :-self.conv1.padding[0]]

        output = self.conv2(output)
        output = output[:, :, :-self.conv2.padding[0]]

        output = self.gelu(output)
        output = self.dropout(output)

        residual = x
        if self.downsample:
            residual = self.downsample(x)

        min_length = min(output.shape[2], residual.shape[2])
        output = output[:, :, -min_length:]
        residual = residual[:, :, -min_length:]

        return output + residual


class TCNDualHead(nn.Module):
    """
    Exact architectural mirror of TCN_Training.py's TCNDualHead:
    4 TemporalBlocks (channels 32/64/64/64, dilations 1/2/4/8,
    kernel_size=5), shared fc1/fc2, then two heads:
      - return_head:    Linear(64, 1)  -- predicted target_next_return
      - direction_head: Linear(64, 3)  -- SELL/HOLD/BUY logits
    """

    def __init__(self, n_features):
        super().__init__()

        self.block1 = TemporalBlock(n_features, 32, dilation=1)
        self.block2 = TemporalBlock(32, 64, dilation=2)
        self.block3 = TemporalBlock(64, 64, dilation=4)
        self.block4 = TemporalBlock(64, 64, dilation=8)

        self.gelu = nn.GELU()
        self.dropout = nn.Dropout(DROPOUT_RATE)
        self.recent_timesteps = 4

        self.fc1 = nn.Linear(64 * self.recent_timesteps, 128)
        self.fc2 = nn.Linear(128, 64)

        self.return_head = nn.Linear(64, 1)
        self.direction_head = nn.Linear(64, 3)

    def forward(self, x):
        x = x.permute(0, 2, 1)

        x = self.block1(x)
        x = self.block2(x)
        x = self.block3(x)
        x = self.block4(x)

        x = x[:, :, -self.recent_timesteps:]
        x = x.reshape(x.size(0), -1)

        x = self.fc1(x)
        x = self.gelu(x)
        x = self.dropout(x)

        x = self.fc2(x)
        x = self.gelu(x)
        x = self.dropout(x)

        return_prediction = self.return_head(x)
        direction_logits = self.direction_head(x)

        return return_prediction, direction_logits


class TCNPredictor:

    def __init__(self, symbol="SPY"):

        symbol = symbol.upper()

        MODEL_PATH = (
            Path(__file__).parent.parent
            / "models"
            / f"best_tcn_{symbol.lower()}.pth"
        )

        print(f"Loading TCN Model: {MODEL_PATH}")

        checkpoint = torch.load(MODEL_PATH, map_location=DEVICE, weights_only=False)

        self.indicators = normalize_indicators(checkpoint.get("indicators", []))

        if "features" not in checkpoint:
            raise RuntimeError(
                "Checkpoint is missing 'features' -- cannot determine the "
                "authoritative feature ordering (including the options "
                "columns). Retrain with the current TCN_Training.py."
            )

        # The checkpoint's own feature list/order is authoritative --
        # it is what the model was actually trained on, including the
        # 102 options columns. It is never independently rebuilt.
        self.features = list(checkpoint["features"])

        self.target_columns = checkpoint.get(
            "target_columns", DEFAULT_TARGET_COLUMNS
        )

        self.options_columns = list(checkpoint.get("options_columns", []))

        self.direction_threshold = checkpoint.get(
            "direction_threshold", DEFAULT_DIRECTION_THRESHOLD
        )

        checkpoint_direction_labels = checkpoint.get("direction_labels")
        if checkpoint_direction_labels:
            self.direction_labels = {
                int(key): value
                for key, value in checkpoint_direction_labels.items()
            }
        else:
            self.direction_labels = dict(DEFAULT_DIRECTION_LABELS)

        self.min_signal_confidence = checkpoint.get(
            "min_signal_confidence", DEFAULT_MIN_SIGNAL_CONFIDENCE
        )

        if "sequence_length" not in checkpoint:
            raise RuntimeError(
                "Checkpoint is missing 'sequence_length'."
            )

        self.sequence_length = checkpoint["sequence_length"]

        num_features_checkpoint = checkpoint.get(
            "num_features", len(self.features)
        )

        if num_features_checkpoint != len(self.features):
            raise RuntimeError(
                "Checkpoint feature-count mismatch: "
                f"num_features={num_features_checkpoint} but "
                f"len(features)={len(self.features)}. This predictor is "
                "not compatible with this checkpoint."
            )

        self.model = TCNDualHead(
            n_features=len(self.features)
        ).to(DEVICE)

        self.model.load_state_dict(checkpoint["model_state_dict"])
        self.model.eval()

        self.feature_scaler = StandardScaler()
        self.target_scaler = StandardScaler()

        self.feature_scaler.mean_ = checkpoint["feature_scaler_mean"]
        self.feature_scaler.scale_ = checkpoint["feature_scaler_scale"]

        # target_scaler was fit ONLY on target_next_return during
        # training (target_direction is never scaled), so index 0 of
        # mean_/scale_ always corresponds to the return target.
        self.target_scaler.mean_ = checkpoint["target_scaler_mean"]
        self.target_scaler.scale_ = checkpoint["target_scaler_scale"]

    # =====================================================
    # FEATURE VALIDATION
    # =====================================================

    def _validate_features_present(self, df):
        """
        The incoming dataframe must contain every feature the
        checkpoint was trained on, including all 102 options columns.
        Missing options data is never filled with zeros or fabricated
        -- it's a hard error.
        """
        missing = [
            column for column in self.features
            if column not in df.columns
        ]

        if missing:
            raise ValueError(
                f"Missing required model features: {missing}"
            )

    # =====================================================
    # DECODING HELPERS
    # =====================================================

    def _decode_return(self, raw_return):
        """
        Inverse-transforms the model's scaled target_next_return
        output back into a real return value using target_scaler
        (fit only on target_next_return -- index 0).
        """
        raw_return = np.atleast_1d(
            np.asarray(raw_return, dtype=np.float64)
        ).reshape(-1)

        scaled_return = raw_return[0]

        mean = self.target_scaler.mean_[0]
        scale = self.target_scaler.scale_[0]

        return float((scaled_return * scale) + mean)

    def _decode_direction(self, direction_logits):
        """
        Converts raw direction_logits into (signal, confidence,
        probabilities, probability_margin).

        confidence is the highest softmax probability, exactly
        matching TCN_Training.py's trading-confidence logic.

        probability_margin is the gap between the highest and
        second-highest class probabilities. The predicted class is
        only returned as the signal if BOTH:
          - confidence >= self.min_signal_confidence
          - probability_margin >= MIN_PROBABILITY_MARGIN
        Otherwise the signal is forced to HOLD.
        """
        probabilities_tensor = torch.softmax(direction_logits, dim=1)
        predicted_class = int(torch.argmax(probabilities_tensor, dim=1).item())

        probs = probabilities_tensor.squeeze(0).detach().cpu().numpy()

        probabilities = {
            self.direction_labels.get(0, "SELL"): float(probs[0]),
            self.direction_labels.get(1, "HOLD"): float(probs[1]),
            self.direction_labels.get(2, "BUY"): float(probs[2]),
        }

        confidence = float(np.max(probs))

        sorted_probs = np.sort(probs)[::-1]
        highest_probability = float(sorted_probs[0])
        second_highest_probability = float(sorted_probs[1])
        probability_margin = highest_probability - second_highest_probability

        if confidence < self.min_signal_confidence:
            signal = self.direction_labels.get(1, "HOLD")
        elif probability_margin < MIN_PROBABILITY_MARGIN:
            signal = self.direction_labels.get(1, "HOLD")
        else:
            signal = self.direction_labels.get(predicted_class, str(predicted_class))

        return signal, confidence, probabilities, probability_margin

    def _ensure_finite(self, value, name):
        if not np.isfinite(value):
            raise ValueError(
                f"Prediction produced a non-finite value for '{name}': {value}"
            )
        return float(value)

    def _sanitize_for_json(self, obj):
        """
        Recursively strips numpy/torch types and non-finite floats out
        of a result before it's returned, so it's always safely JSON
        serializable.
        """
        if isinstance(obj, dict):
            return {key: self._sanitize_for_json(value) for key, value in obj.items()}

        if isinstance(obj, (list, tuple)):
            return [self._sanitize_for_json(value) for value in obj]

        if isinstance(obj, torch.Tensor):
            obj = obj.detach().cpu().numpy()

        if isinstance(obj, np.generic):
            obj = obj.item()

        if isinstance(obj, float):
            if not np.isfinite(obj):
                raise ValueError(f"Non-finite value in prediction result: {obj}")
            return float(obj)

        if isinstance(obj, (np.integer, int)) and not isinstance(obj, bool):
            return int(obj)

        return obj

    # =====================================================
    # HISTORICAL PREDICTIONS
    # =====================================================

    def historical_predictions(self, df):

        df = df.copy()
        df = add_missing_features(df, self.indicators)

        self._validate_features_present(df)

        # Raw (unscaled) close values are needed to convert predicted
        # returns back into predicted prices -- kept separate from the
        # scaled feature frame used for model input.
        raw_close = df["close"].to_numpy(dtype=np.float64)

        scaled_df = df.copy()
        scaled_df[self.features] = self.feature_scaler.transform(df[self.features])

        historical_times = []
        historical_predictions = []

        with torch.no_grad():
            for i in range(self.sequence_length, len(scaled_df)):

                sequence = scaled_df[self.features].iloc[i - self.sequence_length:i].values

                seq_tensor = (
                    torch.tensor(sequence, dtype=torch.float32)
                    .unsqueeze(0)
                    .to(DEVICE)
                )

                predicted_return_tensor, _direction_logits = self.model(seq_tensor)

                predicted_return = self._decode_return(
                    predicted_return_tensor.cpu().numpy()[0]
                )

                # The window's last real bar sits at index i - 1; that
                # bar's close is what target_next_return was measured
                # from during training (see add_targets() in
                # TCN_Training.py).
                current_close = float(raw_close[i - 1])

                predicted_price = current_close * (1.0 + predicted_return)
                predicted_price = self._ensure_finite(predicted_price, "predicted_price")

                historical_predictions.append(predicted_price)
                historical_times.append(df["datetime"].iloc[i])

        return historical_times, historical_predictions

    # =====================================================
    # STATE SEEDING
    #
    # Seeds the recursive state each indicator needs so that,
    # during forecasting, appending one synthetic bar advances
    # each indicator by exactly ONE true recursive step -- the
    # same math training used -- instead of recomputing over a
    # shifted window (which silently resets EMA/RSI/ATR/MACD's
    # implicit "starting point" every step and is what caused
    # forecasts to drift/detach late in the horizon).
    # =====================================================

    def _seed_indicator_state(self, original_df):
        state = {}

        if "EMA9" in self.indicators:
            state["ema9"] = float(original_df["ema9"].iloc[-1])

        if "EMA20" in self.indicators:
            state["ema20"] = float(original_df["ema20"].iloc[-1])

        if "EMA50" in self.indicators:
            state["ema50"] = float(original_df["ema50"].iloc[-1])

        if "RSI14" in self.indicators:
            _, avg_gain, avg_loss = compute_rsi(original_df["close"], period=RSI_PERIOD)
            state["rsi_avg_gain"] = float(avg_gain.iloc[-1])
            state["rsi_avg_loss"] = float(avg_loss.iloc[-1])
            state["rsi_prev_close"] = float(original_df["close"].iloc[-1])

        if "ATR14" in self.indicators:
            state["atr_prev"] = float(original_df["atr14"].iloc[-1])
            state["atr_prev_close"] = float(original_df["close"].iloc[-1])

        if "MACD" in self.indicators:
            _, ema_fast, ema_slow = compute_macd(
                original_df, fast=MACD_FAST, slow=MACD_SLOW, signal=MACD_SIGNAL
            )
            state["macd_ema_fast"] = float(ema_fast.iloc[-1])
            state["macd_ema_slow"] = float(ema_slow.iloc[-1])
            state["macd_signal"] = float(original_df["macd_signal"].iloc[-1])

        if "VWAP" in self.indicators:
            typical_price_hist = (
                original_df["high"] + original_df["low"] + original_df["close"]
            ) / 3
            cumulative_pv_hist = (typical_price_hist * original_df["volume"]).cumsum()
            cumulative_volume_hist = original_df["volume"].cumsum()

            state["vwap_cum_pv"] = float(cumulative_pv_hist.iloc[-1])
            state["vwap_cum_vol"] = float(cumulative_volume_hist.iloc[-1])

        return state

    def _advance_indicator_state(self, raw_window, state):
        """
        Advances every selected indicator by exactly one recursive
        step, using the newly appended synthetic bar (raw_window's
        last row), and writes that step's value into raw_window.
        Mirrors the exact formulas in compute_rsi / compute_atr /
        compute_macd / compute_vwap above.
        """
        idx = raw_window.index[-1]
        last_row = raw_window.iloc[-1]

        if "EMA9" in self.indicators:
            alpha = 2 / (9 + 1)
            state["ema9"] = alpha * last_row["close"] + (1 - alpha) * state["ema9"]
            raw_window.loc[idx, "ema9"] = state["ema9"]

        if "EMA20" in self.indicators:
            alpha = 2 / (20 + 1)
            state["ema20"] = alpha * last_row["close"] + (1 - alpha) * state["ema20"]
            raw_window.loc[idx, "ema20"] = state["ema20"]

        if "EMA50" in self.indicators:
            alpha = 2 / (50 + 1)
            state["ema50"] = alpha * last_row["close"] + (1 - alpha) * state["ema50"]
            raw_window.loc[idx, "ema50"] = state["ema50"]

        if "RSI14" in self.indicators:
            delta = last_row["close"] - state["rsi_prev_close"]
            gain = max(delta, 0.0)
            loss = max(-delta, 0.0)

            alpha = 1 / RSI_PERIOD
            state["rsi_avg_gain"] = alpha * gain + (1 - alpha) * state["rsi_avg_gain"]
            state["rsi_avg_loss"] = alpha * loss + (1 - alpha) * state["rsi_avg_loss"]
            state["rsi_prev_close"] = float(last_row["close"])

            if state["rsi_avg_loss"] == 0:
                rsi_val = 100.0
            else:
                rs = state["rsi_avg_gain"] / state["rsi_avg_loss"]
                rsi_val = 100 - (100 / (1 + rs))

            raw_window.loc[idx, "rsi14"] = rsi_val

        if "ATR14" in self.indicators:
            prev_close = state["atr_prev_close"]
            true_range = max(
                last_row["high"] - last_row["low"],
                abs(last_row["high"] - prev_close),
                abs(last_row["low"] - prev_close),
            )

            alpha = 1 / ATR_PERIOD
            state["atr_prev"] = alpha * true_range + (1 - alpha) * state["atr_prev"]
            state["atr_prev_close"] = float(last_row["close"])

            raw_window.loc[idx, "atr14"] = state["atr_prev"]

        if "MACD" in self.indicators:
            af = 2 / (MACD_FAST + 1)
            as_ = 2 / (MACD_SLOW + 1)
            asig = 2 / (MACD_SIGNAL + 1)

            state["macd_ema_fast"] = af * last_row["close"] + (1 - af) * state["macd_ema_fast"]
            state["macd_ema_slow"] = as_ * last_row["close"] + (1 - as_) * state["macd_ema_slow"]

            macd_line = state["macd_ema_fast"] - state["macd_ema_slow"]
            state["macd_signal"] = asig * macd_line + (1 - asig) * state["macd_signal"]

            raw_window.loc[idx, "macd_line"] = macd_line
            raw_window.loc[idx, "macd_signal"] = state["macd_signal"]
            raw_window.loc[idx, "macd_hist"] = macd_line - state["macd_signal"]

        if "VWAP" in self.indicators:
            typical_price = (last_row["high"] + last_row["low"] + last_row["close"]) / 3

            state["vwap_cum_pv"] += typical_price * last_row["volume"]
            state["vwap_cum_vol"] += last_row["volume"]

            new_vwap = (
                state["vwap_cum_pv"] / state["vwap_cum_vol"]
                if state["vwap_cum_vol"]
                else np.nan
            )

            raw_window.loc[idx, "vwap"] = new_vwap

        return raw_window, state

    # =====================================================
    # PREDICTION
    # =====================================================

    def predict(self, df, future_steps=1):
        """
        Runs the dual-head model and returns:

            {
                "signal": "BUY" / "HOLD" / "SELL",
                "confidence": float,
                "probabilities": {"SELL": float, "HOLD": float, "BUY": float},
                "predicted_return": float,
                "predicted_price": float,
                "future_times": [...],
                "future_predictions": [...],
                "probability_margin": float,
            }

        "signal"/"confidence"/"probabilities"/"predicted_return"/
        "predicted_price"/"probability_margin" always describe the
        FIRST forecast step.
        "future_times"/"future_predictions" carry the full recursive
        path (length == future_steps) for backward compatibility with
        callers that consumed the old (future_times, future_predictions)
        tuple shape.

        Multi-step (future_steps > 1) recursive forecasting is disabled
        whenever the checkpoint depends on options features, because
        future options-chain values cannot be fabricated -- see item 12.
        """

        if future_steps > 1 and self.options_columns:
            raise RuntimeError(
                "Multi-step recursive forecasting is disabled for this "
                f"checkpoint: it depends on {len(self.options_columns)} "
                "options features, and future options-chain values are "
                "not available to synthesize. Call predict() with "
                "future_steps=1 for a single-step forecast."
            )

        original_df = df.copy()
        original_df = add_missing_features(original_df, self.indicators)

        self._validate_features_present(original_df)

        scaled_df = original_df.copy()
        scaled_df[self.features] = self.feature_scaler.transform(
            original_df[self.features]
        )

        current_seq = (
            scaled_df[self.features]
            .iloc[-self.sequence_length:]
            .values
            .astype(np.float32)
        )

        raw_cols = list(dict.fromkeys(
            ["open", "high", "low", "close", "volume"] + self.features
        ))

        raw_window = (
            original_df[raw_cols]
            .iloc[-self.sequence_length:]
            .copy()
        )

        # Seed recursive state for every selected indicator from the
        # FULL real history (original_df), before it's truncated into
        # raw_window.
        indicator_state = self._seed_indicator_state(original_df)

        future_predictions = []
        future_times = []

        last_time = original_df["datetime"].iloc[-1]

        recent_raw_highs = original_df["high"].iloc[-14:].values
        recent_raw_lows = original_df["low"].iloc[-14:].values
        forecast_atr = np.mean(recent_raw_highs - recent_raw_lows)

        current_close = float(original_df["close"].iloc[-1])
        max_step_move = forecast_atr * MAX_STEP_MOVE_ATR_MULTIPLE

        last_volume = original_df["volume"].iloc[-1]

        first_signal = None
        first_confidence = None
        first_probabilities = None
        first_predicted_return = None
        first_predicted_price = None
        first_probability_margin = None

        with torch.no_grad():

            for step in range(future_steps):

                seq_tensor = (
                    torch.tensor(current_seq, dtype=torch.float32)
                    .unsqueeze(0)
                    .to(DEVICE)
                )

                predicted_return_tensor, direction_logits = self.model(seq_tensor)

                predicted_return = self._decode_return(
                    predicted_return_tensor.cpu().numpy()[0]
                )

                signal, confidence, probabilities, probability_margin = self._decode_direction(
                    direction_logits
                )

                predicted_price = current_close * (1.0 + predicted_return)

                if max_step_move > 0:
                    delta = predicted_price - current_close
                    if abs(delta) > max_step_move:
                        predicted_price = (
                            current_close + np.sign(delta) * max_step_move
                        )
                        # Keep predicted_return consistent with the
                        # ATR-capped price rather than reporting an
                        # uncapped return alongside a capped price.
                        if current_close:
                            predicted_return = (
                                predicted_price - current_close
                            ) / current_close

                predicted_price = self._ensure_finite(predicted_price, "predicted_price")
                predicted_return = self._ensure_finite(predicted_return, "predicted_return")

                current_close = predicted_price

                next_time = last_time + pd.Timedelta(minutes=1)
                last_time = next_time

                future_predictions.append(predicted_price)
                future_times.append(next_time)

                if step == 0:
                    first_signal = signal
                    first_confidence = confidence
                    first_probabilities = probabilities
                    first_predicted_return = predicted_return
                    first_predicted_price = predicted_price
                    first_probability_margin = probability_margin

                if step < future_steps - 1:
                    # Only reachable when self.options_columns is empty
                    # (see the guard above) -- safe to synthesize the
                    # next OHLC bar and roll price-based indicators
                    # forward by one real recursive step.
                    synth_high = predicted_price + forecast_atr * 0.5
                    synth_low = predicted_price - forecast_atr * 0.5

                    new_row = pd.DataFrame([{
                        "open": predicted_price,
                        "high": synth_high,
                        "low": synth_low,
                        "close": predicted_price,
                        "volume": last_volume,
                    }])

                    raw_window = pd.concat([raw_window, new_row], ignore_index=True)
                    raw_window = raw_window.iloc[-self.sequence_length:].reset_index(drop=True)

                    raw_window, indicator_state = self._advance_indicator_state(
                        raw_window, indicator_state
                    )

                    current_seq = (
                        self.feature_scaler
                        .transform(raw_window[self.features])
                        .astype(np.float32)
                    )

        result = {
            "signal": first_signal,
            "confidence": first_confidence,
            "probabilities": first_probabilities,
            "predicted_return": first_predicted_return,
            "predicted_price": first_predicted_price,
            "future_times": future_times,
            "future_predictions": future_predictions,
            "probability_margin": first_probability_margin,
        }

        return self._sanitize_for_json(result)"""""""



gru predicter.py """""""
import numpy as np
import pandas as pd
import torch
from pathlib import Path
from sklearn.preprocessing import StandardScaler

from train.GRU_Training import (
    GRURegressor,
    add_indicators,
    resolve_feature_columns,
)

DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")


class GRUPredictor:

    # ============================================================
    # CONFIGURATION
    # ====================

    # Must match GRU training
    DEFAULT_SEQUENCE_LENGTH = 60

    # Light prediction-line smoothing
    # 0.25 = light smoothing
    # Higher = more responsive / less smoothing
    # Lower = smoother / more lag
    SMOOTHING_ALPHA = 0.25

    def __init__(self, symbol="SPY"):

        symbol = symbol.upper()

        model_path = (
            Path(__file__).parent.parent
            / "models"
            / f"best_gru_{symbol.lower()}.pth"
        )

        print(f"Loading GRU Model: {model_path}")

        if not model_path.exists():
            raise FileNotFoundError(
                f"GRU model not found: {model_path}"
            )

        checkpoint = torch.load(
            model_path,
            map_location=DEVICE,
            weights_only=False,
        )

        # ========================================================
        # CHECKPOINT CONFIG
        # ========================================================

        self.features = checkpoint["features"]

        self.indicators = checkpoint.get(
            "indicators",
            [],
        )

        self.indicator_columns = checkpoint.get(
            "indicator_columns",
            [],
        )

        self.sequence_length = checkpoint.get(
            "sequence_length",
            self.DEFAULT_SEQUENCE_LENGTH,
        )

        self.target_columns = checkpoint.get(
            "target_columns",
            ["target_next_return"],
        )

        # --------------------------------------------------------
        # TARGET TYPE
        #
        # Current GRU model:
        #
        # target_next_return =
        # (next_open - current_close) / current_close
        #
        # Therefore:
        #
        # predicted_price =
        # current_close * (1 + predicted_return)
        #
        # Older checkpoints may contain "price".
        # --------------------------------------------------------

        self.target_type = checkpoint.get(
            "target_type",
            "price",
        )

        # ========================================================
        # VALIDATE FEATURE CONFIGURATION
        # ========================================================

        expected_features = resolve_feature_columns(
            self.indicators
        )

        if expected_features != self.features:

            raise RuntimeError(
                "Checkpoint feature configuration does not match "
                "current GRU_Training.py.\n"
                f"Checkpoint features: {self.features}\n"
                f"Expected features:   {expected_features}\n"
                "Retrain the GRU model."
            )

        # ========================================================
        # MODEL
        # ========================================================

        self.model = GRURegressor(
            n_features=len(self.features)
        ).to(DEVICE)

        self.model.load_state_dict(
            checkpoint["model_state_dict"]
        )

        self.model.eval()

        # ========================================================
        # FEATURE SCALER
        # ========================================================

        self.feature_scaler = StandardScaler()

        self.feature_scaler.mean_ = np.asarray(
            checkpoint["feature_scaler_mean"],
            dtype=np.float64,
        )

        self.feature_scaler.scale_ = np.asarray(
            checkpoint["feature_scaler_scale"],
            dtype=np.float64,
        )

        self.feature_scaler.n_features_in_ = len(
            self.features
        )

        self.feature_scaler.var_ = (
            self.feature_scaler.scale_ ** 2
        )

        # ========================================================
        # TARGET SCALER
        # ========================================================

        self.target_scaler = StandardScaler()

        self.target_scaler.mean_ = np.asarray(
            checkpoint["target_scaler_mean"],
            dtype=np.float64,
        )

        self.target_scaler.scale_ = np.asarray(
            checkpoint["target_scaler_scale"],
            dtype=np.float64,
        )

        self.target_scaler.n_features_in_ = len(
            self.target_columns
        )

        self.target_scaler.var_ = (
            self.target_scaler.scale_ ** 2
        )

        # ========================================================
        # INFORMATION
        # ========================================================

        print("========================================")
        print("GRU Predictor Loaded")
        print("========================================")
        print(f"Features       : {self.features}")
        print(f"Indicators     : {self.indicators}")
        print(f"Sequence Length: {self.sequence_length}")
        print(f"Target Columns : {self.target_columns}")
        print(f"Target Type    : {self.target_type}")
        print(
            f"Smoothing Alpha: {self.SMOOTHING_ALPHA}"
        )
        print("========================================")

    # ============================================================
    # FEATURE FRAME
    # ============================================================

    def _build_feature_frame(self, raw_df):

        df = raw_df.copy()

        if "datetime" not in df.columns:
            raise ValueError(
                "Input dataframe must contain 'datetime'."
            )

        df["datetime"] = pd.to_datetime(
            df["datetime"]
        )

        df = (
            df
            .sort_values("datetime")
            .reset_index(drop=True)
        )

        required = [
            "datetime",
            "open",
            "high",
            "low",
            "close",
            "volume",
        ]

        missing = [
            c
            for c in required
            if c not in df.columns
        ]

        if missing:
            raise ValueError(
                f"Missing required columns: {missing}"
            )

        # Generate exactly the same indicators used during training
        df = add_indicators(
            df,
            self.indicators,
        )

        df = (
            df
            .replace([np.inf, -np.inf], np.nan)
            .dropna()
            .reset_index(drop=True)
        )

        return df

    # ============================================================
    # TIMEFRAME
    # ============================================================

    def _infer_bar_interval(self, df):

        diffs = (
            pd.to_datetime(df["datetime"])
            .diff()
            .dropna()
        )

        if len(diffs) == 0:
            return pd.Timedelta(minutes=1)

        interval = diffs.median()

        if not isinstance(interval, pd.Timedelta):
            interval = pd.Timedelta(minutes=1)

        return interval

    # ============================================================
    # MODEL PREDICTION
    #
    # EXACT PIPELINE:
    #
    # 60 candles
    #      ↓
    # GRU
    #      ↓
    # scaled next-open return
    #      ↓
    # inverse scale
    #      ↓
    # real next-open return
    #      ↓
    # current close × (1 + return)
    #      ↓
    # predicted price
    # ============================================================

    def _predict_from_feature_window(
        self,
        feature_window,
    ):

        if len(feature_window) < self.sequence_length:
            raise RuntimeError(
                f"Need {self.sequence_length} candles, "
                f"but only {len(feature_window)} are available."
            )

        # --------------------------------------------------------
        # Take exactly the last 60 candles
        # --------------------------------------------------------

        window_df = (
            feature_window[
                self.features
            ]
            .iloc[-self.sequence_length:]
        )

        values = window_df.values.astype(
            np.float32
        )

        if len(values) != self.sequence_length:
            raise RuntimeError(
                f"Invalid sequence length: "
                f"{len(values)} != "
                f"{self.sequence_length}"
            )

        # --------------------------------------------------------
        # IMPORTANT:
        #
        # Capture the REAL unscaled close BEFORE scaling.
        #
        # The return is:
        #
        # (next_open - current_close) / current_close
        #
        # Therefore current_close is the price anchor.
        # --------------------------------------------------------

        reference_close = float(
            feature_window["close"].iloc[-1]
        )

        if not np.isfinite(reference_close):
            raise RuntimeError(
                "Reference close is not finite."
            )

        if reference_close <= 0:
            raise RuntimeError(
                f"Invalid reference close: {reference_close}"
            )

        # --------------------------------------------------------
        # Scale the 60-candle input
        # --------------------------------------------------------

        scaled = self.feature_scaler.transform(
            values
        )

        tensor = (
            torch.tensor(
                scaled,
                dtype=torch.float32,
            )
            .unsqueeze(0)
            .to(DEVICE)
        )

        # --------------------------------------------------------
        # GRU PREDICTION
        # --------------------------------------------------------

        with torch.no_grad():

            output = self.model(tensor)

        pred_scaled = float(
            output
            .detach()
            .cpu()
            .numpy()
            .reshape(-1)[0]
        )

        if not np.isfinite(pred_scaled):
            raise RuntimeError(
                "GRU returned a non-finite prediction."
            )

        # ========================================================
        # DECODE TARGET
        # ========================================================

        pred_value = (
            self.target_scaler
            .inverse_transform(
                np.array(
                    [[pred_scaled]],
                    dtype=np.float64,
                )
            )[0, 0]
        )

        if not np.isfinite(pred_value):
            raise RuntimeError(
                "Decoded GRU prediction is not finite."
            )

        # ========================================================
        # RETURN → PRICE
        # ========================================================

        if self.target_type == "return":

            predicted_return = float(
                pred_value
            )

            # ----------------------------------------------------
            # CORE CONVERSION:
            #
            # predicted price =
            # current close × (1 + predicted return)
            # ----------------------------------------------------

            predicted_price = (
                reference_close
                * (1.0 + predicted_return)
            )

        else:

            # Legacy absolute-price model
            predicted_return = (
                predicted_price / reference_close
            ) - 1.0

            predicted_price = float(
                pred_value
            )

        if not np.isfinite(predicted_price):
            raise RuntimeError(
                "Predicted price is not finite."
            )

        if predicted_price <= 0:
            raise RuntimeError(
                f"Invalid predicted price: "
                f"{predicted_price}"
            )

        return {
            "predicted_price": float(
                predicted_price
            ),
            "predicted_return": float(
                predicted_return
            ),
            "reference_close": float(
                reference_close
            ),
        }

    # ============================================================
    # LIGHT SMOOTHING
    #
    # EMA-style smoothing.
    #
    # alpha = 0.25
    #
    # new_smoothed =
    # alpha × prediction
    # +
    # (1-alpha) × previous_smoothed
    #
    # This is intentionally LIGHT.
    # ============================================================

    @classmethod
    def _smooth_prediction(
        cls,
        values,
        alpha=None,
    ):

        if values is None:
            return []

        if len(values) == 0:
            return []

        if alpha is None:
            alpha = cls.SMOOTHING_ALPHA

        alpha = float(alpha)

        if not 0.0 < alpha <= 1.0:
            raise ValueError(
                "Smoothing alpha must be between "
                "0 and 1."
            )

        cleaned = []

        for value in values:

            value = float(value)

            if not np.isfinite(value):
                if cleaned:
                    value = cleaned[-1]
                else:
                    continue

            cleaned.append(value)

        if len(cleaned) <= 1:
            return cleaned

        smoothed = [
            cleaned[0]
        ]

        previous = cleaned[0]

        for value in cleaned[1:]:

            current = (
                alpha * value
                +
                (1.0 - alpha) * previous
            )

            smoothed.append(
                float(current)
            )

            previous = current

        return smoothed

    # ============================================================
    # HISTORICAL PREDICTIONS
    #
    # For every historical candle:
    #
    # previous 60 candles
    #        ↓
    # GRU
    #        ↓
    # next-open return
    #        ↓
    # predicted price
    #
    # The prediction is attached to the NEXT candle timestamp.
    # ============================================================

    def historical_predictions(
        self,
        raw_df,
        smooth=False,
    ):

        df = self._build_feature_frame(
            raw_df
        )

        if len(df) <= self.sequence_length:
            return [], []

        times = []
        predictions = []

        for i in range(
            self.sequence_length,
            len(df),
        ):

            # Exactly 60 real candles
            window_df = (
                df.iloc[
                    i - self.sequence_length:i
                ]
            )

            result = (
                self._predict_from_feature_window(
                    window_df
                )
            )

            pred_price = result[
                "predicted_price"
            ]

            times.append(
                df["datetime"].iloc[i]
            )

            predictions.append(
                pred_price
            )

        # Optional standalone smoothing.
        #
        # get_prediction_line() deliberately calls
        # historical_predictions(smooth=False) so the historical
        # and future segments are smoothed together continuously.
        if smooth:

            predictions = (
                self._smooth_prediction(
                    predictions
                )
            )

        return times, predictions

    # ============================================================
    # FUTURE FORECAST
    #
    # Recursive:
    #
    # 60 candles
    #      ↓
    # GRU
    #      ↓
    # predicted return
    #      ↓
    # predicted price
    #      ↓
    # synthetic candle
    #      ↓
    # repeat
    #
    # This generates the future prediction line.
    # ============================================================

    def predict(
        self,
        raw_df,
        future_steps,
        smooth=False,
    ):

        if future_steps <= 0:
            return [], []

        raw = raw_df.copy()

        raw["datetime"] = pd.to_datetime(
            raw["datetime"]
        )

        raw = (
            raw
            .sort_values("datetime")
            .reset_index(drop=True)
        )

        interval = (
            self._infer_bar_interval(raw)
        )

        # --------------------------------------------------------
        # Indicator warmup
        # --------------------------------------------------------

        indicator_warmup = 50

        history_needed = (
            self.sequence_length
            + indicator_warmup
            + 10
        )

        raw_window = (
            raw[
                [
                    "datetime",
                    "open",
                    "high",
                    "low",
                    "close",
                    "volume",
                ]
            ]
            .iloc[-history_needed:]
            .copy()
            .reset_index(drop=True)
        )

        if len(raw_window) < self.sequence_length:
            raise ValueError(
                "Not enough historical data "
                "for GRU forecast."
            )

        # --------------------------------------------------------
        # REAL MARKET ANCHOR
        # --------------------------------------------------------

        last_real_close = float(
            raw_window["close"].iloc[-1]
        )

        last_volume = float(
            raw_window["volume"].iloc[-1]
        )

        # --------------------------------------------------------
        # ATR PROXY
        # Used only to prevent unstable recursive predictions.
        # --------------------------------------------------------

        recent_tr = (
            raw_window["high"]
            - raw_window["low"]
        )

        atr_proxy = float(
            recent_tr
            .rolling(14)
            .mean()
            .iloc[-1]
        )

        if (
            not np.isfinite(atr_proxy)
            or atr_proxy <= 0
        ):

            atr_proxy = max(
                last_real_close * 0.001,
                0.01,
            )

        last_time = (
            raw_window["datetime"].iloc[-1]
        )

        future_times = []
        future_predictions = []

        previous_prediction = (
            last_real_close
        )

        # ========================================================
        # RECURSIVE FORECAST
        # ========================================================

        for step in range(
            future_steps
        ):

            # ----------------------------------------------------
            # Recalculate indicators on the current raw window.
            #
            # This is important because the GRU was trained using
            # indicators. Every recursive step must rebuild them.
            # ----------------------------------------------------

            feature_window = add_indicators(
                raw_window.copy(),
                self.indicators,
            )

            feature_window = (
                feature_window
                .replace(
                    [np.inf, -np.inf],
                    np.nan,
                )
                .dropna()
                .reset_index(drop=True)
            )

            if len(feature_window) < self.sequence_length:

                raise RuntimeError(
                    "Not enough valid feature rows "
                    "for future prediction. "
                    "Increase history_needed."
                )

            # ----------------------------------------------------
            # GRU:
            #
            # 60 candles
            #      ↓
            # predicted return
            #      ↓
            # predicted price
            # ----------------------------------------------------

            result = (
                self._predict_from_feature_window(
                    feature_window
                )
            )

            raw_predicted_price = result[
                "predicted_price"
            ]

            # ----------------------------------------------------
            # RECURSIVE SANITY LIMIT
            #
            # This is NOT the prediction-line smoothing.
            #
            # It prevents a single bad recursive prediction from
            # exploding the entire multi-step forecast.
            # ----------------------------------------------------

            max_change = max(
                atr_proxy * 2.0,
                last_real_close * 0.002,
            )

            lower_bound = (
                previous_prediction
                - max_change
            )

            upper_bound = (
                previous_prediction
                + max_change
            )

            pred_price = float(
                np.clip(
                    raw_predicted_price,
                    lower_bound,
                    upper_bound,
                )
            )

            # ----------------------------------------------------
            # FUTURE TIMESTAMP
            # ----------------------------------------------------

            next_time = (
                last_time + interval
            )

            last_time = next_time

            future_times.append(
                next_time
            )

            future_predictions.append(
                pred_price
            )

            # ----------------------------------------------------
            # SYNTHETIC FUTURE CANDLE
            #
            # We need a synthetic candle so that the next recursive
            # GRU prediction has OHLCV data available.
            # ----------------------------------------------------

            synthetic_range = max(
                atr_proxy * 0.50,
                last_real_close * 0.0005,
            )

            synth_open = (
                previous_prediction
            )

            synth_close = (
                pred_price
            )

            synth_high = (
                max(
                    synth_open,
                    synth_close,
                )
                + synthetic_range * 0.5
            )

            synth_low = (
                min(
                    synth_open,
                    synth_close,
                )
                - synthetic_range * 0.5
            )

            new_row = pd.DataFrame(
                [
                    {
                        "datetime": next_time,
                        "open": synth_open,
                        "high": synth_high,
                        "low": synth_low,
                        "close": synth_close,
                        "volume": last_volume,
                    }
                ]
            )

            raw_window = pd.concat(
                [
                    raw_window,
                    new_row,
                ],
                ignore_index=True,
            )

            raw_window = (
                raw_window
                .iloc[-history_needed:]
                .reset_index(drop=True)
            )

            previous_prediction = (
                pred_price
            )

        # --------------------------------------------------------
        # Optional standalone future smoothing
        #
        # get_prediction_line() uses smooth=False here and then
        # smooths historical + future together.
        # --------------------------------------------------------

        if smooth:

            future_predictions = (
                self._smooth_prediction(
                    future_predictions
                )
            )

        return (
            future_times,
            future_predictions,
        )

    # ============================================================
    # FULL PREDICTION LINE
    #
    # FINAL PIPELINE:
    #
    # Historical:
    #
    # 60 candles
    #      ↓
    # GRU
    #      ↓
    # next-open % return
    #      ↓
    # predicted price
    #
    # Future:
    #
    # 60 candles
    #      ↓
    # GRU
    #      ↓
    # next-open % return
    #      ↓
    # predicted price
    #      ↓
    # recursive forecast
    #
    # Then:
    #
    # historical prices + future prices
    #      ↓
    # ONE light EMA smoothing pass
    #      ↓
    # prediction line
    # ============================================================

    def get_prediction_line(
        self,
        raw_df,
        future_steps,
        smooth=True,
    ):

        # --------------------------------------------------------
        # HISTORICAL
        #
        # IMPORTANT:
        # smooth=False here.
        # --------------------------------------------------------

        historical_times, historical_predictions = (
            self.historical_predictions(
                raw_df,
                smooth=False,
            )
        )

        # --------------------------------------------------------
        # FUTURE
        #
        # IMPORTANT:
        # smooth=False here.
        # --------------------------------------------------------

        future_times, future_predictions = (
            self.predict(
                raw_df,
                future_steps,
                smooth=False,
            )
        )

        # --------------------------------------------------------
        # COMBINE BEFORE SMOOTHING
        #
        # This avoids a visible smoothing reset at the boundary.
        # --------------------------------------------------------

        all_times = (
            list(historical_times)
            +
            list(future_times)
        )

        all_predictions = (
            list(historical_predictions)
            +
            list(future_predictions)
        )

        # --------------------------------------------------------
        # ONE LIGHT SMOOTHING PASS
        # --------------------------------------------------------

        if smooth:

            all_predictions = (
                self._smooth_prediction(
                    all_predictions,
                    alpha=self.SMOOTHING_ALPHA,
                )
            )

        # --------------------------------------------------------
        # HISTORICAL/FUTURE BOUNDARY
        # --------------------------------------------------------

        boundary_index = (
            len(historical_times)
        )

        return (
            all_times,
            all_predictions,
            boundary_index,
        )"""""""""""
signal engine .py """""""
"""
signal_logic.py

Converts the TCN model's classifier output into BUY / SELL / HOLD.

Responsibility of this module (and ONLY this module):
    Given the TCN classifier's prediction dict (signal, confidence,
    probabilities, probability_margin, predicted_return, predicted_price),
    decide the final, edge-triggered BUY / SELL / HOLD.

This module NEVER trains or calls the TCN. It only consumes the
prediction the model already produced. This keeps the trading logic
fully swappable without ever touching the trained model.

Decision path
--------------
    1. model_signal = prediction["signal"]           ("BUY" / "SELL" / "HOLD")
    2. If model_signal == "HOLD"                       -> final = HOLD
       If confidence < MIN_CONFIDENCE                   -> final = HOLD
       If probability_margin < MIN_PROBABILITY_MARGIN    -> final = HOLD
       Otherwise                                         -> final = model_signal

No EMA9/EMA20 crossover, predicted_next_open percentage move, or
threshold_pct logic is used any more -- the classifier already decides
direction; this module only decides whether to trust it enough to act.

Edge-triggered signals
-----------------------
By default, the engine only emits BUY/SELL on the first candle a state
becomes true, then HOLD for every candle after that (even if the raw
condition is still true) until the opposite condition fires. This gives:

    BUY -> HOLD -> HOLD -> ... -> SELL -> HOLD -> ... -> BUY ...

instead of repeating BUY/SELL every candle the filtered condition happens
to still hold. Set `SignalLogicConfig.edge_triggered = False` for the raw,
non-deduped behavior.
"""

from __future__ import annotations

import math
from dataclasses import dataclass
from enum import Enum
from typing import Optional

import pandas as pd


class Signal(str, Enum):
    BUY = "BUY"
    SELL = "SELL"
    HOLD = "HOLD"


# Columns expected when feeding a DataFrame of TCN classifier predictions
# (one row per bar) into SignalEngine.generate().
REQUIRED_COLUMNS = (
    "signal",
    "confidence",
    "probabilities",
    "probability_margin",
    "predicted_return",
    "predicted_price",
)


@dataclass
class SignalLogicConfig:
    """
    Tunable parameters. Nothing here touches the model -- safe to change
    any time.
    """

    # Minimum classifier confidence required to act instead of HOLD.
    min_confidence: float = 0.70

    # Minimum probability margin (top class probability minus runner-up
    # probability) required to act instead of HOLD.
    min_probability_margin: float = 0.10

    # If True (default), only emit BUY/SELL on the candle where the signal
    # state actually changes; every other candle is HOLD. If False, BUY/SELL
    # fires on every candle where the filtered condition holds.
    edge_triggered: bool = True


def _validate_columns(df: pd.DataFrame) -> None:
    missing = [c for c in REQUIRED_COLUMNS if c not in df.columns]
    if missing:
        raise ValueError(
            f"Signal logic input is missing required columns: {missing}. "
            f"Expected at least: {REQUIRED_COLUMNS}"
        )


# ---------------------------------------------------------------------------
# Validate a raw TCN prediction dict before it's used for signal generation.
# ---------------------------------------------------------------------------

def _validate_probability_value(name: str, value) -> None:
    if not isinstance(value, (int, float)) or isinstance(value, bool):
        raise ValueError(f"{name} must be numeric, got {value!r}")
    if math.isnan(value) or math.isinf(value):
        raise ValueError(f"{name} must be finite (no NaN/Infinity), got {value!r}")
    if not (0.0 <= value <= 1.0):
        raise ValueError(f"{name} must be between 0 and 1, got {value!r}")


def validate_model_signal(prediction: dict) -> dict:
    """
    Validates a raw TCN classifier prediction dict before it's trusted for
    signal generation. Raises ValueError on anything malformed so a bad
    model output can't silently turn into a wrong trade decision.

    Checks:
        - "signal" is one of BUY / HOLD / SELL
        - "confidence" is numeric, finite, and in [0, 1]
        - "probabilities" is a dict containing SELL / HOLD / BUY, each
          numeric, finite, and in [0, 1]

    Returns the same prediction dict unchanged if it passes.
    """
    signal = prediction.get("signal")
    if signal not in (Signal.BUY.value, Signal.HOLD.value, Signal.SELL.value):
        raise ValueError(f"Invalid signal: {signal!r}. Must be one of BUY/HOLD/SELL.")

    _validate_probability_value("confidence", prediction.get("confidence"))

    probabilities = prediction.get("probabilities")
    if not isinstance(probabilities, dict):
        raise ValueError("probabilities must be a dict with SELL/HOLD/BUY keys.")

    required_keys = (Signal.SELL.value, Signal.HOLD.value, Signal.BUY.value)
    missing = [k for k in required_keys if k not in probabilities]
    if missing:
        raise ValueError(f"probabilities is missing required keys: {missing}")

    for key in required_keys:
        _validate_probability_value(f"probabilities[{key}]", probabilities[key])

    return prediction


# ---------------------------------------------------------------------------
# Edge-triggering: collapse repeated BUY/BUY/BUY... or SELL/SELL/SELL... runs
# down to a single signal on the first candle of the run. A HOLD candle does
# NOT reset the position state -- only an opposite BUY/SELL flips it.
# ---------------------------------------------------------------------------

def _dedupe_signal_transitions(
    raw_signals: pd.Series, last_actionable: Optional[str] = None
) -> tuple[pd.Series, Optional[str]]:
    """
    Example:
        raw:    HOLD BUY BUY BUY HOLD SELL SELL BUY
        result: HOLD BUY HOLD HOLD HOLD SELL HOLD BUY

    `last_actionable` lets the dedupe continue across calls (e.g. live
    bar-by-bar processing) instead of always starting fresh. Returns the
    deduped series AND the updated last_actionable state, so a caller can
    persist it between calls.
    """
    out = []

    for value in raw_signals:
        if value == Signal.HOLD.value:
            out.append(Signal.HOLD.value)
        elif value != last_actionable:
            out.append(value)
            last_actionable = value
        else:
            out.append(Signal.HOLD.value)

    return pd.Series(out, index=raw_signals.index), last_actionable


# ---------------------------------------------------------------------------
# Strategy: filter the TCN classifier's own BUY/SELL/HOLD signal by
# confidence and probability margin.
# ---------------------------------------------------------------------------

def classifier_filter_strategy(df: pd.DataFrame, config: SignalLogicConfig) -> pd.Series:
    """
    Rules (before edge-triggering):
        model signal == "HOLD"                              -> HOLD
        confidence < config.min_confidence                   -> HOLD
        probability_margin < config.min_probability_margin    -> HOLD
        otherwise                                             -> model signal
    """
    _validate_columns(df)

    filtered = df["signal"].copy()

    low_confidence = df["confidence"] < config.min_confidence
    low_margin = df["probability_margin"] < config.min_probability_margin

    filtered[low_confidence | low_margin] = Signal.HOLD.value
    return filtered


# ---------------------------------------------------------------------------
# Engine
# ---------------------------------------------------------------------------

class SignalEngine:
    """
    Consumes TCN classifier predictions and turns them into edge-triggered
    BUY/SELL/HOLD signals.

    Usage (batch, over a DataFrame of predictions):
        engine = SignalEngine()
        result_df = engine.generate(df)
        # df needs: signal, confidence, probabilities, probability_margin,
        #           predicted_return, predicted_price

    Usage (live, one prediction dict at a time):
        engine = SignalEngine()
        result = engine.process(prediction)
        # prediction = {"signal": ..., "confidence": ..., "probabilities": ...,
        #               "probability_margin": ..., "predicted_return": ...,
        #               "predicted_price": ...}

    Call engine.reset() to clear edge-trigger state (e.g. new session/day).
    """

    def __init__(
        self,
        strategy=classifier_filter_strategy,
        config: Optional[SignalLogicConfig] = None,
    ):
        self.strategy = strategy
        self.config = config or SignalLogicConfig()
        self._last_actionable: Optional[str] = None

    def reset(self) -> None:
        """Clear edge-trigger state."""
        self._last_actionable = None

    def generate(self, df: pd.DataFrame) -> pd.DataFrame:
        """
        Returns a copy of df with:
            - 'model_signal': the TCN classifier's raw signal, preserved
            - 'signal'      : the final, edge-triggered BUY/SELL/HOLD
        """
        _validate_columns(df)
        out = df.copy()
        out["model_signal"] = out["signal"]

        filtered = self.strategy(out, self.config)

        if self.config.edge_triggered:
            deduped, self._last_actionable = _dedupe_signal_transitions(
                filtered, self._last_actionable
            )
            out["signal"] = deduped
        else:
            out["signal"] = filtered

        return out

    def process(self, prediction: dict) -> dict:
        """
        Live, one-prediction-at-a-time equivalent of generate(). Applies the
        same confidence/probability-margin filters and edge-triggering.
        """
        model_signal = prediction["signal"]
        confidence = prediction["confidence"]
        probabilities = prediction["probabilities"]
        probability_margin = prediction["probability_margin"]
        predicted_return = prediction["predicted_return"]
        predicted_price = prediction["predicted_price"]

        if (
            model_signal == Signal.HOLD.value
            or confidence < self.config.min_confidence
            or probability_margin < self.config.min_probability_margin
        ):
            filtered_signal = Signal.HOLD.value
        else:
            filtered_signal = model_signal

        if self.config.edge_triggered:
            if filtered_signal == Signal.HOLD.value:
                final_signal = Signal.HOLD.value
            elif filtered_signal != self._last_actionable:
                final_signal = filtered_signal
                self._last_actionable = filtered_signal
            else:
                final_signal = Signal.HOLD.value
        else:
            final_signal = filtered_signal

        return {
            "signal": final_signal,
            "model_signal": model_signal,
            "confidence": confidence,
            "probabilities": probabilities,
            "probability_margin": probability_margin,
            "predicted_return": predicted_return,
            "predicted_price": predicted_price,
        }

    def process_prediction(self, prediction: dict) -> dict:
        """
        Validates the raw TCN prediction (see validate_model_signal) and
        then produces the edge-triggered signal via process(). The TCN's
        classifier signal is authoritative -- BUY/HOLD/SELL is never
        recalculated from EMA9/EMA20 or any other indicator.
        """
        validated = validate_model_signal(prediction)
        return self.process(validated)


# ---------------------------------------------------------------------------
# Convert signals into Lightweight Charts markers
# ---------------------------------------------------------------------------

def to_lightweight_charts_markers(df: pd.DataFrame, time_column: str = "time") -> list[dict]:
    """
    Convert a DataFrame that already has a 'signal' column (from
    SignalEngine.generate) into the marker format Lightweight Charts expects
    for `series.setMarkers([...])`.

    Only BUY and SELL rows produce markers; HOLD rows are skipped.
    """
    if "signal" not in df.columns:
        raise ValueError("DataFrame must have a 'signal' column. Run SignalEngine.generate() first.")
    if time_column not in df.columns:
        raise ValueError(f"DataFrame must have a '{time_column}' column for chart timestamps.")

    markers = []
    for _, row in df.iterrows():
        if row["signal"] == Signal.BUY.value:
            markers.append(
                {
                    "time": row[time_column],
                    "position": "belowBar",
                    "color": "#26a69a",
                    "shape": "arrowUp",
                    "text": "BUY",
                }
            )
        elif row["signal"] == Signal.SELL.value:
            markers.append(
                {
                    "time": row[time_column],
                    "position": "aboveBar",
                    "color": "#ef5350",
                    "shape": "arrowDown",
                    "text": "SELL",
                }
            )
    return markers


# ---------------------------------------------------------------------------
# Test: confirms edge-triggering matches the required transition table.
# ---------------------------------------------------------------------------

def _test_edge_triggering_matches_spec():
    """
    TCN output:     BUY BUY BUY HOLD HOLD SELL SELL BUY
    Final output:   BUY HOLD HOLD HOLD HOLD SELL HOLD BUY
    """
    model_signals = ["BUY", "BUY", "BUY", "HOLD", "HOLD", "SELL", "SELL", "BUY"]
    expected =       ["BUY", "HOLD", "HOLD", "HOLD", "HOLD", "SELL", "HOLD", "BUY"]

    engine = SignalEngine()
    actual = []
    for sig in model_signals:
        prediction = {
            "signal": sig,
            "confidence": 0.90,          # above MIN_CONFIDENCE (0.70) for every row
            "probabilities": {"BUY": 0.90, "SELL": 0.05, "HOLD": 0.05},
            "probability_margin": 0.80,  # above MIN_PROBABILITY_MARGIN (0.10) for every row
            "predicted_return": 0.001,
            "predicted_price": 100.0,
        }
        result = engine.process(prediction)
        actual.append(result["signal"])

    assert actual == expected, f"Edge-triggering mismatch.\nExpected: {expected}\nActual:   {actual}"
    print("test_edge_triggering_matches_spec: PASS ->", actual)


if __name__ == "__main__":
    _test_edge_triggering_matches_spec()"""""""



"""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""""app.py
import threading
from pathlib import Path

import numpy as np
import pandas as pd
import uvicorn
from fastapi import FastAPI, HTTPException
from fastapi.responses import FileResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel, Field

from engine.inference_engine import InferenceEngine
from engine.tcn_predictor import TCNPredictor
from engine.gru_predictor import GRUPredictor
from engine.signal_logic import SignalEngine


# ---------------------------------------------------------
# Basic project paths
# ---------------------------------------------------------

BASE_DIR = Path(__file__).resolve().parent
FRONTEND_DIR = BASE_DIR / "frontend"
INDEX_FILE = FRONTEND_DIR / "index.html"


# ---------------------------------------------------------
# Create FastAPI app
# ---------------------------------------------------------

app = FastAPI(title="Smart Trading Dashboard")


# ---------------------------------------------------------
# Connect frontend static files
# Example:
# /static/style.css
# /static/app.js
# ---------------------------------------------------------

if FRONTEND_DIR.exists():
    app.mount(
        "/static",
        StaticFiles(directory=str(FRONTEND_DIR)),
        name="static"
    )


# ---------------------------------------------------------
# Training status data
# This stores live training progress
# ---------------------------------------------------------

training_state = {
    "running": False,
    "epoch": 0,
    "total_epochs": 0,
    "train_loss": 0.0,
    "val_loss": 0.0,
    "symbol": "",
    "model": ""
}


# ---------------------------------------------------------
# Threading variables
# These help training run without blocking the website
# ---------------------------------------------------------

training_lock = threading.Lock()
training_thread = None
stop_requested = False


# ---------------------------------------------------------
# Request body for forecast API
# ---------------------------------------------------------

class ForecastRequest(BaseModel):
    symbol: str
    model: str
    data_source: str = "ftp"
    data_path: str = ""
    timeframe: int = 1
    forecast_steps: int = 15
    history: int = 500
    indicators: list[str] = Field(default_factory=list)
    show_ema9: bool = True
    show_ema20: bool = True
    show_ma: bool = True
    show_vwap: bool = True
    show_rsi: bool = True
    show_volume_delta: bool = True
    ma_period: int = 20
    rsi_period: int = 14


# ---------------------------------------------------------
# Request body for training API
# ---------------------------------------------------------

class TrainRequest(BaseModel):
    symbol: str
    model: str
    data_source: str = "ftp"
    data_path: str = ""
    indicators: list[str] = Field(default_factory=list)


# ---------------------------------------------------------
# Create inference engine object
# ---------------------------------------------------------

engine = InferenceEngine()
signal_engine = SignalEngine()


# ---------------------------------------------------------
# Calculate EMA 9, EMA 20, and ATR indicators
# ---------------------------------------------------------

def calculate_indicators(df):
    df = df.copy()

    df["datetime"] = pd.to_datetime(df["datetime"])

    df["ema9"] = df["close"].ewm(span=9, adjust=False).mean()
    df["ema20"] = df["close"].ewm(span=20, adjust=False).mean()

    high_low = df["high"] - df["low"]
    high_close = df["high"] - df["close"].shift(1)
    high_close = high_close.abs()

    low_close = df["low"] - df["close"].shift(1)
    low_close = low_close.abs()

    true_range_data = [high_low, high_close, low_close]

    true_range = pd.concat(true_range_data, axis=1)
    true_range = true_range.max(axis=1)

    df["atr"] = true_range.rolling(14).mean()

    df.dropna(inplace=True)

    return df


# ---------------------------------------------------------
# Calculate MA (Simple Moving Average) and VWAP
# MA: rolling mean of close over "period" bars
# VWAP: cumulative (typical price * volume) / cumulative volume,
#       reset each day so it behaves like a standard session VWAP
# ---------------------------------------------------------

def calculate_ma_vwap(df, ma_period=20):
    df = df.copy()

    df["ma"] = df["close"].rolling(window=ma_period).mean()

    if "volume" in df.columns:
        typical_price = (df["high"] + df["low"] + df["close"]) / 3
        pv = typical_price * df["volume"]

        # Reset VWAP at the start of each trading day
        day_key = df["datetime"].dt.date

        cum_pv = pv.groupby(day_key).cumsum()
        cum_vol = df["volume"].groupby(day_key).cumsum()

        df["vwap"] = cum_pv / cum_vol.replace(0, pd.NA)
    else:
        df["vwap"] = pd.NA

    return df


# ---------------------------------------------------------
# Calculate RSI (Relative Strength Index)
# Standard 14-period RSI using Wilder's smoothing
# (an EWM with alpha = 1/period, which is what most charting
# platforms - TradingView included - use by default)
# ---------------------------------------------------------

def calculate_rsi(df, period=14):
    df = df.copy()

    delta = df["close"].diff()

    gain = delta.clip(lower=0)
    loss = -delta.clip(upper=0)

    avg_gain = gain.ewm(alpha=1 / period, adjust=False).mean()
    avg_loss = loss.ewm(alpha=1 / period, adjust=False).mean()

    rs = avg_gain / avg_loss.replace(0, pd.NA)

    df["rsi"] = 100 - (100 / (1 + rs))

    # Where avg_loss is 0 (pure uptrend), RS is undefined -> RSI should read 100
    df.loc[avg_loss == 0, "rsi"] = 100

    return df


# ---------------------------------------------------------
# Calculate Volume Delta
# Approximate signed (buy - sell) volume per bar from OHLCV only.
# Same formula used across GRU_Training.py / TCN_Training.py /
# gru_predictor.py / tcn_predictor.py, so the chart matches what
# the models are actually trained on:
#     close > open  -> +volume  (counted as buying)
#     close < open  -> -volume  (counted as selling)
#     close == open -> 0
# ---------------------------------------------------------

def calculate_volume_delta(df):
    df = df.copy()

    direction = df["close"] - df["open"]
    direction = direction.apply(
        lambda x: 1 if x > 0 else (-1 if x < 0 else 0)
    )

    df["volume_delta"] = direction * df["volume"]

    return df


# ---------------------------------------------------------
# Bollinger Bands / MACD / Stochastic / MFI / ADX / OBV
#
# Formulas here are copied verbatim from GRU_Training.py / TCN_Training.py
# so the chart display matches what the models were actually trained on.
# ---------------------------------------------------------

def calculate_bollinger_bands(df, period=20, std=2.0):
    df = df.copy()

    mid = df["close"].rolling(period).mean()
    dev = df["close"].rolling(period).std()

    df["bb_upper"] = mid + (std * dev)
    df["bb_middle"] = mid
    df["bb_lower"] = mid - (std * dev)

    return df


def calculate_macd(df, fast=12, slow=26, signal=9):
    df = df.copy()

    ema_fast = df["close"].ewm(span=fast, adjust=False).mean()
    ema_slow = df["close"].ewm(span=slow, adjust=False).mean()
    macd_line = ema_fast - ema_slow
    signal_line = macd_line.ewm(span=signal, adjust=False).mean()

    df["macd_line"] = macd_line
    df["macd_signal"] = signal_line
    df["macd_hist"] = macd_line - signal_line

    return df


def calculate_stochastic(df, k_period=14, d_period=3):
    df = df.copy()

    low_min = df["low"].rolling(k_period).min()
    high_max = df["high"].rolling(k_period).max()
    stoch_range = (high_max - low_min).replace(0, pd.NA)

    k = 100 * (df["close"] - low_min) / stoch_range
    d = k.rolling(d_period).mean()

    df["stoch_k"] = k
    df["stoch_d"] = d

    return df


def calculate_mfi(df, period=14):
    df = df.copy()

    typical_price = (df["high"] + df["low"] + df["close"]) / 3
    money_flow = typical_price * df["volume"]
    direction = typical_price.diff()

    positive_flow = money_flow.where(direction > 0, 0.0).rolling(period).sum()
    negative_flow = money_flow.where(direction < 0, 0.0).rolling(period).sum()

    money_ratio = positive_flow / negative_flow.replace(0, np.nan)
    mfi = 100 - (100 / (1 + money_ratio))
    mfi[negative_flow == 0] = 100

    df["mfi"] = mfi

    return df


def calculate_adx(df, period=14):
    df = df.copy()

    up_move = df["high"].diff()
    down_move = -df["low"].diff()

    plus_dm = np.where((up_move > down_move) & (up_move > 0), up_move, 0.0)
    minus_dm = np.where((down_move > up_move) & (down_move > 0), down_move, 0.0)

    high_low = df["high"] - df["low"]
    high_close = (df["high"] - df["close"].shift()).abs()
    low_close = (df["low"] - df["close"].shift()).abs()
    tr = pd.concat([high_low, high_close, low_close], axis=1).max(axis=1)

    atr_smooth = tr.ewm(alpha=1 / period, adjust=False).mean()

    plus_di = 100 * pd.Series(plus_dm, index=df.index).ewm(alpha=1 / period, adjust=False).mean() / atr_smooth
    minus_di = 100 * pd.Series(minus_dm, index=df.index).ewm(alpha=1 / period, adjust=False).mean() / atr_smooth

    di_sum = (plus_di + minus_di).replace(0, np.nan)
    dx = 100 * (plus_di - minus_di).abs() / di_sum

    df["adx"] = dx.ewm(alpha=1 / period, adjust=False).mean()

    return df


def calculate_obv(df):
    df = df.copy()

    direction = np.sign(df["close"].diff()).fillna(0)
    df["obv"] = (direction * df["volume"]).cumsum()

    return df


# ---------------------------------------------------------
# Convert 1-minute candles into selected timeframe candles
# Example:
# timeframe = 5 means 5-minute candles
# ---------------------------------------------------------

def resample_timeframe(df, timeframe):
    if timeframe == 1:
        return df

    df = df.copy()

    df["datetime"] = pd.to_datetime(df["datetime"])
    df = df.set_index("datetime")

    rule = str(timeframe) + "min"

    resampled = df.resample(rule).agg({
        "open": "first",
        "high": "max",
        "low": "min",
        "close": "last",
        "volume": "sum"
    })

    resampled = resampled.dropna()
    resampled.reset_index(inplace=True)

    return resampled


# ---------------------------------------------------------
# Update training progress
# This function is called from training file
# ---------------------------------------------------------

def progress_callback(epoch, total_epochs, train_loss, val_loss):
    with training_lock:
        training_state["epoch"] = epoch
        training_state["total_epochs"] = total_epochs
        training_state["train_loss"] = float(train_loss)
        training_state["val_loss"] = float(val_loss)


# ---------------------------------------------------------
# Check whether user clicked stop training
# ---------------------------------------------------------

def stop_callback():
    return stop_requested


# ---------------------------------------------------------
# Training function
# This runs inside a separate thread
# ---------------------------------------------------------

def training_worker(symbol, model_name, indicators=None, data_source="ftp", data_path=""):
    global stop_requested

    try:
        with training_lock:
            training_state["running"] = True
            training_state["epoch"] = 0
            training_state["total_epochs"] = 0
            training_state["train_loss"] = 0.0
            training_state["val_loss"] = 0.0
            training_state["symbol"] = symbol
            training_state["model"] = model_name

        stop_requested = False

        model_name = model_name.upper()

        if model_name == "TCN":
            from train.TCN_Training import train_model
        elif model_name == "GRU":
            from train.GRU_Training import train_model
        else:
            raise RuntimeError("Unknown model: " + model_name)

        train_model(
            symbol=symbol,
            data_source=data_source,
            data_path=data_path,
            indicators=indicators,
            progress_callback=progress_callback,
            stop_callback=stop_callback
        )

    except Exception as error:
        print("TRAINING ERROR:", str(error))

    finally:
        with training_lock:
            training_state["running"] = False


# ---------------------------------------------------------
# Home page route
# Opens frontend/index.html
# ---------------------------------------------------------

@app.get("/")
def home():
    if not INDEX_FILE.exists():
        return {
            "message": "FastAPI running",
            "error": "frontend/index.html not found"
        }

    return FileResponse(str(INDEX_FILE))


# ---------------------------------------------------------
# Health check route
# ---------------------------------------------------------

@app.get("/health")
def health():
    return {
        "status": "online"
    }


# ---------------------------------------------------------
# Available models
# ---------------------------------------------------------

@app.get("/models")
def models():
    return ["TCN", "GRU"]


# ---------------------------------------------------------
# Available symbols
# ---------------------------------------------------------

@app.get("/symbols")
def symbols():
    return ["SPY", "QQQ", "AAPL", "MSFT", "TSLA"]


# ---------------------------------------------------------
# Get current training status
# ---------------------------------------------------------

@app.get("/training-status")
def training_status():
    with training_lock:
        current_state = dict(training_state)

    return current_state


# ---------------------------------------------------------
# Test data loading
# ---------------------------------------------------------

@app.get("/test-load")
def test_load():
    try:
        df = engine.load_data("SPY")

        return {
            "rows": len(df),
            "columns": list(df.columns)
        }

    except Exception as error:
        raise HTTPException(status_code=500, detail=str(error))


# ---------------------------------------------------------
# Start model training
# ---------------------------------------------------------

@app.post("/train")
def train(request: TrainRequest):
    global training_thread

    try:
        # Prevent multiple training jobs
        if training_thread is not None and training_thread.is_alive():
            return {
                "success": False,
                "message": "Training already running"
            }

        print("======================================")
        print("Training Request Received")
        print("Symbol     :", request.symbol)
        print("Model      :", request.model)
        print("Data Source:", request.data_source)
        print("Data Path  :", request.data_path)
        print("Indicators :", request.indicators)
        print("======================================")

        training_thread = threading.Thread(
            target=training_worker,
            args=(
                request.symbol,
                request.model,
                request.indicators,
                request.data_source,
                request.data_path
            ),
            daemon=True
        )

        training_thread.start()

        return {
            "success": True,
            "message": "Training started",
            "symbol": request.symbol,
            "model": request.model,
            "data_source": request.data_source,
            "data_path": request.data_path,
            "indicators": request.indicators
        }

    except Exception as error:
        raise HTTPException(status_code=500, detail=str(error))
# ---------------------------------------------------------
# Stop model training
# ---------------------------------------------------------

@app.post("/stop-training")
def stop_training():
    global stop_requested

    stop_requested = True

    return {
        "success": True
    }


# ---------------------------------------------------------
# Forecast route
# This returns candles, EMA lines, MA, VWAP, RSI, Volume Delta,
# Bollinger Bands, MACD, Stochastic, MFI, ADX, OBV, historical
# prediction, and future prediction
#
# NOTE: every output loop below now guards against NaN with
# pd.isna(...)/skip. Without this, a single NaN (e.g. from a bad
# model prediction, or an early-window indicator) gets serialized
# as JSON null, and lightweight-charts throws an uncaught
# "Value is null" error the moment setData() hits it on the
# frontend -- which aborts the rest of runForecast() in app.js
# (including chart.timeScale().fitContent()), leaving the charts
# looking blank/empty even though the network call itself succeeded.
# ---------------------------------------------------------

@app.post("/forecast")
def forecast(request: ForecastRequest):
    try:
        df = engine.load_data(request.symbol, request.data_source, request.data_path)

        df = calculate_indicators(df)

        model_df = df.copy()

        df_display = model_df.tail(request.history).copy()

        df_display = resample_timeframe(
            df_display,
            request.timeframe
        )

        df_display["ema9"] = df_display["close"].ewm(
            span=9,
            adjust=False
        ).mean()

        df_display["ema20"] = df_display["close"].ewm(
            span=20,
            adjust=False
        ).mean()

        df_display = calculate_ma_vwap(
            df_display,
            ma_period=request.ma_period
        )

        df_display = calculate_rsi(
            df_display,
            period=request.rsi_period
        )

        df_display = calculate_volume_delta(df_display)

        df_display = calculate_bollinger_bands(df_display)
        df_display = calculate_macd(df_display)
        df_display = calculate_stochastic(df_display)
        df_display = calculate_mfi(df_display)
        df_display = calculate_adx(df_display)
        df_display = calculate_obv(df_display)

        model_name = request.model.upper()

        if model_name == "TCN":
            predictor = TCNPredictor(request.symbol)
        elif model_name == "GRU":
            predictor = GRUPredictor(request.symbol)
        else:
            raise RuntimeError("Unknown model: " + request.model)

        predict_res = predictor.predict(
            model_df,
            request.forecast_steps
        )
        if model_name == "TCN":
            future_times = predict_res["future_times"]
            future_predictions = predict_res["future_predictions"]
        else:
            future_times = predict_res[0]
            future_predictions = predict_res[1]

        historical_times, historical_predictions = predictor.historical_predictions(
            model_df
        )

        keep = request.history

        historical_times = historical_times[-keep:]
        historical_predictions = historical_predictions[-keep:]

        # --- Future predictions (anchor point + model output) ---
        # NEW: skip NaN so a single bad model output can't null-crash the chart
        future_output = []

        last_time = model_df["datetime"].iloc[-1]
        last_open = model_df["open"].iloc[-1]

        if not pd.isna(last_open):
            future_output.append({
                "time": int(last_time.timestamp()),
                "value": float(last_open)
            })

        for time_value, prediction_value in zip(future_times, future_predictions):
            if pd.isna(prediction_value):
                continue
            future_output.append({
                "time": int(time_value.timestamp()),
                "value": float(prediction_value)
            })

        # --- Candles ---
        # NEW: skip any row with a NaN OHLC value
        candles_output = []

        for index, row in df_display.iterrows():
            if (
                pd.isna(row["open"]) or pd.isna(row["high"])
                or pd.isna(row["low"]) or pd.isna(row["close"])
            ):
                continue
            candles_output.append({
                "time": int(row["datetime"].timestamp()),
                "open": float(row["open"]),
                "high": float(row["high"]),
                "low": float(row["low"]),
                "close": float(row["close"]),
                "volume": float(row["volume"]) if "volume" in row and not pd.isna(row["volume"]) else 0.0
            })

        # --- EMA9 ---
        # NEW: skip NaN
        ema9_output = []

        for index, row in df_display.iterrows():
            if pd.isna(row["ema9"]):
                continue
            ema9_output.append({
                "time": int(row["datetime"].timestamp()),
                "value": float(row["ema9"])
            })

        # --- EMA20 ---
        # NEW: skip NaN
        ema20_output = []

        for index, row in df_display.iterrows():
            if pd.isna(row["ema20"]):
                continue
            ema20_output.append({
                "time": int(row["datetime"].timestamp()),
                "value": float(row["ema20"])
            })

        ma_output = []

        for index, row in df_display.iterrows():
            if pd.isna(row["ma"]):
                continue
            ma_output.append({
                "time": int(row["datetime"].timestamp()),
                "value": float(row["ma"])
            })

        vwap_output = []

        for index, row in df_display.iterrows():
            if pd.isna(row["vwap"]):
                continue
            vwap_output.append({
                "time": int(row["datetime"].timestamp()),
                "value": float(row["vwap"])
            })

        rsi_output = []

        for index, row in df_display.iterrows():
            if pd.isna(row["rsi"]):
                continue
            rsi_output.append({
                "time": int(row["datetime"].timestamp()),
                "value": float(row["rsi"])
            })

        # Histogram bars: green for buying pressure, red for selling
        # pressure, matching the candle up/down colors.
        volume_delta_output = []

        for index, row in df_display.iterrows():
            if pd.isna(row["volume_delta"]):
                continue

            value = float(row["volume_delta"])
            bar_color = "#26a69a" if value >= 0 else "#ef5350"

            volume_delta_output.append({
                "time": int(row["datetime"].timestamp()),
                "value": value,
                "color": bar_color
            })

        # --- Bollinger / MACD / Stochastic / MFI / ADX / OBV ---

        bb_upper_output = []
        bb_middle_output = []
        bb_lower_output = []

        for index, row in df_display.iterrows():
            if pd.isna(row["bb_upper"]) or pd.isna(row["bb_middle"]) or pd.isna(row["bb_lower"]):
                continue

            timestamp = int(row["datetime"].timestamp())

            bb_upper_output.append({"time": timestamp, "value": float(row["bb_upper"])})
            bb_middle_output.append({"time": timestamp, "value": float(row["bb_middle"])})
            bb_lower_output.append({"time": timestamp, "value": float(row["bb_lower"])})

        macd_line_output = []
        macd_signal_output = []
        macd_hist_output = []

        for index, row in df_display.iterrows():
            if pd.isna(row["macd_line"]) or pd.isna(row["macd_signal"]) or pd.isna(row["macd_hist"]):
                continue

            timestamp = int(row["datetime"].timestamp())
            hist_value = float(row["macd_hist"])

            macd_line_output.append({"time": timestamp, "value": float(row["macd_line"])})
            macd_signal_output.append({"time": timestamp, "value": float(row["macd_signal"])})
            macd_hist_output.append({
                "time": timestamp,
                "value": hist_value,
                "color": "#26a69a" if hist_value >= 0 else "#ef5350"
            })

        stoch_k_output = []
        stoch_d_output = []

        for index, row in df_display.iterrows():
            if pd.isna(row["stoch_k"]) or pd.isna(row["stoch_d"]):
                continue

            timestamp = int(row["datetime"].timestamp())

            stoch_k_output.append({"time": timestamp, "value": float(row["stoch_k"])})
            stoch_d_output.append({"time": timestamp, "value": float(row["stoch_d"])})

        mfi_output = []

        for index, row in df_display.iterrows():
            if pd.isna(row["mfi"]):
                continue
            mfi_output.append({
                "time": int(row["datetime"].timestamp()),
                "value": float(row["mfi"])
            })

        adx_output = []

        for index, row in df_display.iterrows():
            if pd.isna(row["adx"]):
                continue
            adx_output.append({
                "time": int(row["datetime"].timestamp()),
                "value": float(row["adx"])
            })

        obv_output = []

        for index, row in df_display.iterrows():
            if pd.isna(row["obv"]):
                continue
            obv_output.append({
                "time": int(row["datetime"].timestamp()),
                "value": float(row["obv"])
            })

        # --- Historical predictions ---
        # NEW: skip NaN model outputs
        historical_output = []

        for time_value, prediction_value in zip(historical_times, historical_predictions):
            if pd.isna(prediction_value):
                continue
            historical_output.append({
                "time": int(time_value.timestamp()),
                "value": float(prediction_value)
            })

        # --- ML Buy/Sell Signals via Engine ---
        if model_name == "TCN":
            prediction_for_signal = {
                "signal": predict_res["signal"],
                "confidence": predict_res["confidence"],
                "probabilities": predict_res["probabilities"],
                "probability_margin": predict_res["probability_margin"],
                "predicted_return": predict_res["predicted_return"],
                "predicted_price": predict_res["predicted_price"],
            }
            signal_result = signal_engine.process(prediction_for_signal)
            signals_output = [{
                "time": int(model_df["datetime"].iloc[-1].timestamp()),
                "signal": signal_result["signal"],
                "model_signal": signal_result["model_signal"],
                "confidence": signal_result["confidence"],
                "probabilities": signal_result["probabilities"],
                "probability_margin": signal_result["probability_margin"],
                "predicted_return": signal_result["predicted_return"],
                "predicted_price": signal_result["predicted_price"],
            }]
        else:
            signals_output = []

        return {
            "candles": candles_output,
            "ema9": ema9_output,
            "ema20": ema20_output,
            "ma": ma_output,
            "vwap": vwap_output,
            "rsi": rsi_output,
            "volume_delta": volume_delta_output,

            # NOTE: key names here must match what frontend/app.js reads
            # from the /forecast response (e.g. data.bollinger_upper,
            # data.macd_histogram, data.stochastic_k) -- NOT the internal
            # DataFrame column names used above, which stay bb_upper/
            # macd_hist/stoch_k for consistency with the training scripts.
            "bollinger_upper": bb_upper_output,
            "bollinger_middle": bb_middle_output,
            "bollinger_lower": bb_lower_output,
            "macd_line": macd_line_output,
            "macd_signal": macd_signal_output,
            "macd_histogram": macd_hist_output,
            "stochastic_k": stoch_k_output,
            "stochastic_d": stoch_d_output,
            "mfi": mfi_output,
            "adx": adx_output,
            "obv": obv_output,

            "historical_predictions": historical_output,
            "future_predictions": future_output,
            "signals": signals_output,
            "show_ema9": request.show_ema9,
            "show_ema20": request.show_ema20,
            "show_ma": request.show_ma,
            "show_vwap": request.show_vwap,
            "show_rsi": request.show_rsi,
            "show_volume_delta": request.show_volume_delta
        }

    except Exception as error:
        import traceback
        traceback.print_exc()
        raise HTTPException(status_code=500, detail=str(error))


# ---------------------------------------------------------
# Run FastAPI server
# ---------------------------------------------------------

if __name__ == "__main__":
    uvicorn.run(
        "app:app",
        host="127.0.0.1",
        port=8000,
        reload=True
    )
